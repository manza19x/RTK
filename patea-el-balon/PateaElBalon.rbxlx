      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">DataManager</string>
          <string name="Source"><![CDATA[-- Guarda y carga los datos de cada jugador (monedas, fuerza, balón, colección).
-- En Studio: Home > Game Settings > Security > "Enable Studio Access to API Services"
-- para que se guarde mientras pruebas.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local STORE_NAME = "PateaElBalon_v1"
local AUTOSAVE_SECONDS = 120

export type PlayerData = {
	Coins: number,
	Strength: number,
	BallTier: number,
	BestDistance: number,
	TotalKicks: number,
	Collection: { [string]: number },
}

local function defaultData(): PlayerData
	return {
		Coins = 0,
		Strength = 1,
		BallTier = 1,
		BestDistance = 0,
		TotalKicks = 0,
		Collection = {},
	}
end

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[Datos] DataStore no disponible, no se guardará el progreso:", result)
	end
end

local DataManager = {}

local profiles: { [Player]: PlayerData } = {}
-- Si la carga falló, NO guardamos para no borrar el progreso real del jugador
local canSave: { [Player]: boolean } = {}

local function keyFor(player: Player): string
	return "jugador_" .. player.UserId
end

-- Completa campos que falten (por si agregas cosas nuevas en el futuro)
local function reconcile(saved: any): PlayerData
	local data = defaultData()
	if type(saved) == "table" then
		for key, value in saved do
			if (data :: any)[key] ~= nil and type(value) == type((data :: any)[key]) then
				(data :: any)[key] = value
			end
		end
	end
	return data
end

function DataManager.Load(player: Player): PlayerData
	local saved = nil
	local loaded = store == nil -- sin DataStore no hay nada que perder
	if store then
		-- En Studio sin acceso a la API no tiene caso reintentar
		local attempts = if RunService:IsStudio() then 1 else 3
		for attempt = 1, attempts do
			local ok, result = pcall(function()
				return (store :: DataStore):GetAsync(keyFor(player))
			end)
			if ok then
				saved = result
				loaded = true
				break
			end
			warn(string.format("[Datos] Error cargando a %s (intento %d): %s", player.Name, attempt, tostring(result)))
			if attempt < attempts then
				task.wait(attempt)
			end
		end
	end

	local data = reconcile(saved)
	if player.Parent == nil then
		return data -- se salió mientras cargaba
	end
	profiles[player] = data
	canSave[player] = loaded and store ~= nil
	if not loaded then
		warn("[Datos] No se pudo cargar a " .. player.Name .. "; su progreso de esta sesión no se guardará.")
	end
	return data
end

function DataManager.Get(player: Player): PlayerData?
	return profiles[player]
end

function DataManager.Save(player: Player)
	local data = profiles[player]
	if not data or not canSave[player] or not store then
		return
	end
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			(store :: DataStore):SetAsync(keyFor(player), data, { player.UserId })
		end)
		if ok then
			return
		end
		warn(string.format("[Datos] Error guardando a %s (intento %d): %s", player.Name, attempt, tostring(err)))
		task.wait(attempt)
	end
end

function DataManager.Release(player: Player)
	DataManager.Save(player)
	profiles[player] = nil
	canSave[player] = nil
end

function DataManager.Start()
	Players.PlayerRemoving:Connect(DataManager.Release)

	game:BindToClose(function()
		local pending = 0
		for _, player in Players:GetPlayers() do
			pending += 1
			task.spawn(function()
				DataManager.Save(player)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.1)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_SECONDS)
			for _, player in Players:GetPlayers() do
				task.spawn(DataManager.Save, player)
			end
		end
	end)
end

return DataManager
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="7">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Lógica principal del servidor: patadas, vuelo del balón, sorteo de futbolistas y tienda.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage.Shared.Config)
local MapBuilder = require(script.Parent.MapBuilder)
local DataManager = require(script.Parent.DataManager)

local rng = Random.new()

-- ------------------------------------------------------------
-- Remotes (comunicación servidor <-> cliente)
-- ------------------------------------------------------------
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"

local function remote(className: string, name: string): any
	local r = Instance.new(className)
	r.Name = name
	r.Parent = remotes
	return r
end

local KickEvent: RemoteEvent = remote("RemoteEvent", "Kick")
local BallLaunchedEvent: RemoteEvent = remote("RemoteEvent", "BallLaunched")
local KickResultEvent: RemoteEvent = remote("RemoteEvent", "KickResult")
local AnnouncementEvent: RemoteEvent = remote("RemoteEvent", "Announcement")
local DataUpdatedEvent: RemoteEvent = remote("RemoteEvent", "DataUpdated")
local GetDataFunction: RemoteFunction = remote("RemoteFunction", "GetData")
local PurchaseFunction: RemoteFunction = remote("RemoteFunction", "Purchase")

MapBuilder.Build()
remotes.Parent = ReplicatedStorage
DataManager.Start()

local KICK_ORIGIN = Vector3.new(0, 1.5, 0)

-- ------------------------------------------------------------
-- Datos y leaderstats
-- ------------------------------------------------------------
local function updateLeaderstats(player: Player)
	local data = DataManager.Get(player)
	local stats = player:FindFirstChild("leaderstats")
	if not data or not stats then
		return
	end
	(stats:FindFirstChild("Monedas") :: IntValue).Value = data.Coins;
	(stats:FindFirstChild("Zona Récord") :: IntValue).Value =
		if data.BestDistance > 0 then Config.GetZoneFromDistance(data.BestDistance) else 0
end

local function sendData(player: Player)
	local data = DataManager.Get(player)
	if data then
		DataUpdatedEvent:FireClient(player, data)
		updateLeaderstats(player)
	end
end

GetDataFunction.OnServerInvoke = function(player: Player)
	-- Esperamos a que termine de cargar
	local started = os.clock()
	while not DataManager.Get(player) and player.Parent and os.clock() - started < 30 do
		task.wait(0.2)
	end
	return DataManager.Get(player)
end

local function onPlayerAdded(player: Player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local coins = Instance.new("IntValue")
	coins.Name = "Monedas"
	coins.Parent = stats
	local best = Instance.new("IntValue")
	best.Name = "Zona Récord"
	best.Parent = stats
	stats.Parent = player

	DataManager.Load(player)
	sendData(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
-- Por si alguien entró antes de que corriera este script
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

-- ------------------------------------------------------------
-- Futbolista que aparece donde cae el balón
-- ------------------------------------------------------------
local CLASSIC_SKIN = Color3.fromRGB(245, 205, 48)

local function buildSimpleRig(f: Config.Footballer): Model
	-- Plan B si no se puede crear un avatar R15
	local model = Instance.new("Model")
	local function block(name: string, size: Vector3, offset: Vector3, color: Color3): Part
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Color = color
		p.Anchored = true
		p.CanCollide = false
		p.CFrame = CFrame.new(offset)
		p.Parent = model
		return p
	end
	local root = block("HumanoidRootPart", Vector3.new(2, 2, 1), Vector3.new(0, 3, 0), f.Shirt)
	root.Transparency = 1
	block("Torso", Vector3.new(2, 2, 1), Vector3.new(0, 3, 0), f.Shirt)
	block("Head", Vector3.new(1.2, 1.2, 1.2), Vector3.new(0, 4.6, 0), CLASSIC_SKIN)
	block("LeftArm", Vector3.new(1, 2, 1), Vector3.new(-1.5, 3, 0), CLASSIC_SKIN)
	block("RightArm", Vector3.new(1, 2, 1), Vector3.new(1.5, 3, 0), CLASSIC_SKIN)
	block("LeftLeg", Vector3.new(1, 2, 1), Vector3.new(-0.5, 1, 0), f.Shorts)
	block("RightLeg", Vector3.new(1, 2, 1), Vector3.new(0.5, 1, 0), f.Shorts)
	model.PrimaryPart = root
	return model
end

local function buildAvatar(f: Config.Footballer): Model
	local ok, result = pcall(function()
		local desc = Instance.new("HumanoidDescription")
		desc.HeadColor = CLASSIC_SKIN
		desc.LeftArmColor = CLASSIC_SKIN
		desc.RightArmColor = CLASSIC_SKIN
		desc.TorsoColor = f.Shirt
		desc.LeftLegColor = f.Shorts
		desc.RightLegColor = f.Shorts
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if ok and result then
		local model = result :: Model
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		end
		for _, obj in model:GetDescendants() do
			if obj:IsA("BasePart") then
				obj.Anchored = true
				obj.CanCollide = false
			end
		end
		return model
	end
	return buildSimpleRig(f)
end

local function spawnFootballer(f: Config.Footballer, landing: Vector3, owner: Player)
	local rarity = Config.Rarities[f.Rarity]
	local model = buildAvatar(f)
	model.Name = f.Name

	-- Mirando hacia el punto de patada (-Z), que es hacia donde miran los modelos por defecto.
	-- Lo ponemos al lado del balón y lo subimos para que sus pies toquen el pasto (y = 0).
	model:PivotTo(CFrame.new(landing.X + 4, 0, landing.Z))
	local boxCFrame, size = model:GetBoundingBox()
	local feetY = boxCFrame.Position.Y - size.Y / 2
	model:PivotTo(model:GetPivot() + Vector3.new(0, -feetY, 0))
	local root = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(14, 6)
	billboard.StudsOffset = Vector3.new(0, size.Y / 2 + 3.5, 0)
	billboard.LightInfluence = 0
	billboard.MaxDistance = 400
	billboard.Parent = root

	local function line(text: string, y: number, h: number, color: Color3)
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, h)
		label.Position = UDim2.fromScale(0, y)
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextStrokeTransparency = 0
		label.TextColor3 = color
		label.Text = text
		label.Parent = billboard
	end
	line(f.Name, 0, 0.45, Color3.new(1, 1, 1))
	line(rarity.Name .. " · 1 en " .. Config.FormatNumber(f.Chance), 0.45, 0.3, rarity.Color)
	line("de " .. owner.DisplayName, 0.75, 0.25, Color3.fromRGB(220, 220, 220))

	if rarity.Order >= Config.Rarities.Epico.Order then
		local highlight = Instance.new("Highlight")
		highlight.FillColor = rarity.Color
		highlight.FillTransparency = 0.7
		highlight.OutlineColor = rarity.Color
		highlight.Parent = model
	end

	-- Explosión de partículas del color de la rareza
	local burst = Instance.new("Part")
	burst.Anchored = true
	burst.CanCollide = false
	burst.Transparency = 1
	burst.Size = Vector3.one
	burst.Position = landing
	burst.Parent = workspace.Futbolistas
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(rarity.Color)
	emitter.LightEmission = 0.6
	emitter.Size = NumberSequence.new(1.2, 0)
	emitter.Speed = NumberRange.new(20, 40)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Lifetime = NumberRange.new(0.6, 1.2)
	emitter.Rate = 0
	emitter.Parent = burst
	emitter:Emit(25 + rarity.Order * 15)

	model.Parent = workspace.Futbolistas
	Debris:AddItem(burst, 3)
	Debris:AddItem(model, 10)
end

-- ------------------------------------------------------------
-- Patada
-- ------------------------------------------------------------
local busy: { [Player]: boolean } = {}

local function createBall(ballTier: number): Part
	local info = Config.Balls[ballTier] or Config.Balls[1]
	local ball = Instance.new("Part")
	ball.Name = "Balon"
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.new(3, 3, 3)
	ball.Color = info.Color
	ball.Material = info.Material
	ball.CanCollide = false
	ball.CanQuery = false
	ball.TopSurface = Enum.SurfaceType.Smooth
	ball.BottomSurface = Enum.SurfaceType.Smooth

	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0.8, 0)
	a0.Parent = ball
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -0.8, 0)
	a1.Parent = ball
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = ColorSequence.new(info.Color)
	trail.Transparency = NumberSequence.new(0.2, 1)
	trail.Lifetime = 0.6
	trail.LightEmission = 0.5
	trail.FaceCamera = true
	trail.Parent = ball
	return ball
end

local function placeCharacterBehindBall(player: Player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		character:PivotTo(CFrame.lookAt(Vector3.new(0, 3, -6), Vector3.new(0, 3, 10)))
	end
end

local function handleKick(player: Player, timing: number)
	local data = DataManager.Get(player)
	if not data then
		return
	end

	timing = math.clamp(timing, 0, 1)
	local perfect = timing >= Config.PERFECT_THRESHOLD
	local timingMultiplier = if perfect then Config.PERFECT_BONUS else math.max(timing, Config.MIN_TIMING)
	local power = Config.GetKickPower(data.Strength, data.BallTier)
	local distance = math.clamp(power * timingMultiplier * rng:NextNumber(0.95, 1.05), 5, Config.MAX_DISTANCE)

	placeCharacterBehindBall(player)

	-- Vuelo con física: calculamos la velocidad exacta para caer en `landing` en `flightTime` segundos
	local maxSide = math.min(distance * 0.06, Config.FIELD_WIDTH / 2 - 8)
	local landing = Vector3.new(rng:NextNumber(-maxSide, maxSide), KICK_ORIGIN.Y, distance)
	local flightTime = math.clamp(1 + distance / 700, 1, 5.5)
	local gravity = workspace.Gravity
	local horizontal = (landing - KICK_ORIGIN) / flightTime
	local velocity = Vector3.new(horizontal.X, gravity * flightTime / 2, horizontal.Z)

	local ball = createBall(data.BallTier)
	ball.Position = KICK_ORIGIN
	ball.Parent = workspace.Balones
	ball:SetNetworkOwner(nil)
	ball.AssemblyLinearVelocity = velocity
	ball.AssemblyAngularVelocity = Vector3.new(20, 0, 0)

	BallLaunchedEvent:FireClient(player, ball, flightTime, perfect)

	task.wait(flightTime)
	if ball.Parent then
		ball.Anchored = true
		ball.Position = landing
	end

	-- Resultado
	local zone = Config.GetZoneFromDistance(distance)
	local luck = Config.GetLuck(zone)
	local footballer = Config.RollFootballer(luck, rng)
	local current = DataManager.Get(player)
	if current then
		local isNew = (current.Collection[footballer.Id] or 0) == 0
		local kickCoins = Config.GetCoinsForKick(distance, zone)
		local bonus = Config.GetFootballerReward(footballer)
		local newRecord = distance > current.BestDistance

		current.Coins += kickCoins + bonus
		current.TotalKicks += 1
		current.Collection[footballer.Id] = (current.Collection[footballer.Id] or 0) + 1
		if newRecord then
			current.BestDistance = distance
		end

		spawnFootballer(footballer, landing, player)
		KickResultEvent:FireClient(player, {
			FootballerId = footballer.Id,
			Distance = distance,
			Zone = zone,
			Luck = luck,
			Coins = kickCoins,
			Bonus = bonus,
			IsNew = isNew,
			NewRecord = newRecord,
			Perfect = perfect,
		})
		sendData(player)

		local rarity = Config.Rarities[footballer.Rarity]
		if rarity.Order >= Config.Rarities.Legendario.Order then
			AnnouncementEvent:FireAllClients(
				string.format(
					"🎉 ¡%s sacó a %s! (%s · 1 en %s)",
					player.DisplayName,
					footballer.Name,
					rarity.Name,
					Config.FormatNumber(footballer.Chance)
				),
				rarity.Color
			)
		end
	end

	Debris:AddItem(ball, 4)
	task.wait(1.5) -- pausa para ver el resultado antes de la siguiente patada
end

KickEvent.OnServerEvent:Connect(function(player: Player, timing: any)
	if busy[player] or typeof(timing) ~= "number" or timing ~= timing then
		return
	end
	busy[player] = true
	local ok, err = pcall(handleKick, player, timing)
	if not ok then
		warn("[Patada] Error:", err)
	end
	busy[player] = nil
end)

Players.PlayerRemoving:Connect(function(player)
	busy[player] = nil
end)

-- ------------------------------------------------------------
-- Tienda
-- ------------------------------------------------------------
PurchaseFunction.OnServerInvoke = function(player: Player, kind: any): (boolean, string)
	local data = DataManager.Get(player)
	if not data then
		return false, "Tus datos todavía están cargando."
	end

	if kind == "Strength" then
		if data.Strength >= Config.MAX_STRENGTH then
			return false, "¡Ya tienes la fuerza al máximo!"
		end
		local cost = Config.GetStrengthCost(data.Strength)
		if data.Coins < cost then
			return false, "Te faltan " .. Config.FormatNumber(cost - data.Coins) .. " monedas."
		end
		data.Coins -= cost
		data.Strength += 1
		sendData(player)
		return true, "💪 ¡Fuerza nivel " .. data.Strength .. "!"
	elseif kind == "Ball" then
		local nextTier = data.BallTier + 1
		local ball = Config.Balls[nextTier]
		if not ball then
			return false, "¡Ya tienes el mejor balón!"
		end
		if data.Coins < ball.Price then
			return false, "Te faltan " .. Config.FormatNumber(ball.Price - data.Coins) .. " monedas."
		end
		data.Coins -= ball.Price
		data.BallTier = nextTier
		sendData(player)
		return true, "⚽ ¡Compraste el " .. ball.Name .. "!"
	end

	return false, "Compra inválida."
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[-- Construye el mapa: lobby, punto de patada, las 30 zonas y la portería final.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local MapBuilder = {}

local W = Config.FIELD_WIDTH
local L = Config.ZONE_LENGTH

local function makePart(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		(p :: any)[key] = value
	end
	return p
end

local function makeLabel(parent: Instance, text: string, size: UDim2, position: UDim2, color: Color3)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = size
	label.Position = position
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	label.TextStrokeTransparency = 0
	label.Text = text
	label.Parent = parent
	return label
end

local function buildZone(map: Folder, zone: number)
	local startZ = (zone - 1) * L
	local zoneFolder = Instance.new("Folder")
	zoneFolder.Name = "Zona" .. zone
	zoneFolder.Parent = map

	-- Pasto en dos franjas para que se vea como cancha
	for half = 0, 1 do
		makePart({
			Name = "Pasto",
			Size = Vector3.new(W, 2, L / 2),
			Position = Vector3.new(0, -1, startZ + L / 4 + half * L / 2),
			Color = Config.GetZoneColor(zone, half == 1),
			Material = Enum.Material.Grass,
			Parent = zoneFolder,
		})
	end

	-- Línea blanca al inicio de la zona
	makePart({
		Name = "Linea",
		Size = Vector3.new(W, 0.2, 1.5),
		Position = Vector3.new(0, 0.1, startZ),
		Color = Color3.new(1, 1, 1),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		Parent = zoneFolder,
	})

	-- Bordes del campo
	for side = -1, 1, 2 do
		makePart({
			Name = "Borde",
			Size = Vector3.new(2, 3, L),
			Position = Vector3.new(side * (W / 2 + 1), 0.5, startZ + L / 2),
			Color = Color3.fromRGB(240, 240, 240),
			Material = Enum.Material.SmoothPlastic,
			Parent = zoneFolder,
		})
	end

	-- Cartel flotante con el número de zona y su suerte
	local anchor = makePart({
		Name = "Cartel",
		Size = Vector3.new(1, 1, 1),
		Position = Vector3.new(0, 30, startZ + L / 2),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Parent = zoneFolder,
	})
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(46, 18) -- en studs: se ve más chico de lejos
	billboard.LightInfluence = 0
	billboard.MaxDistance = 2500
	billboard.Parent = anchor
	makeLabel(billboard, "ZONA " .. zone, UDim2.fromScale(1, 0.6), UDim2.fromScale(0, 0), Color3.new(1, 1, 1))
	makeLabel(
		billboard,
		"🍀 Suerte x" .. Config.FormatLuck(Config.GetLuck(zone)),
		UDim2.fromScale(1, 0.4),
		UDim2.fromScale(0, 0.6),
		Color3.fromRGB(120, 255, 140)
	)
end

local function buildGoal(map: Folder)
	local z = Config.MAX_DISTANCE + 4
	local goalWidth, goalHeight = 60, 24
	local color = Color3.new(1, 1, 1)
	for side = -1, 1, 2 do
		makePart({
			Name = "Poste",
			Size = Vector3.new(2, goalHeight, 2),
			Position = Vector3.new(side * goalWidth / 2, goalHeight / 2, z),
			Color = color,
			Parent = map,
		})
	end
	makePart({
		Name = "Travesano",
		Size = Vector3.new(goalWidth + 2, 2, 2),
		Position = Vector3.new(0, goalHeight, z),
		Color = color,
		Parent = map,
	})
	makePart({
		Name = "Red",
		Size = Vector3.new(goalWidth, goalHeight, 0.2),
		Position = Vector3.new(0, goalHeight / 2, z + 10),
		Color = color,
		Transparency = 0.6,
		Material = Enum.Material.ForceField,
		Parent = map,
	})
	-- Pared final invisible para que nadie se salga
	makePart({
		Name = "ParedFinal",
		Size = Vector3.new(W + 4, 60, 2),
		Position = Vector3.new(0, 30, z + 14),
		Transparency = 1,
		Parent = map,
	})
	makePart({
		Name = "PastoFinal",
		Size = Vector3.new(W, 2, 16),
		Position = Vector3.new(0, -1, z + 6),
		Color = Config.GetZoneColor(Config.NUM_ZONES),
		Material = Enum.Material.Grass,
		Parent = map,
	})
end

function MapBuilder.Build(): Folder
	-- Si el lugar ya tiene otros spawns (plantilla Baseplate), los desactivamos
	for _, obj in workspace:GetDescendants() do
		if obj:IsA("SpawnLocation") then
			obj.Enabled = false
		end
	end

	local map = Instance.new("Folder")
	map.Name = "Mapa"
	map.Parent = workspace

	-- Lobby detrás del punto de patada
	makePart({
		Name = "Lobby",
		Size = Vector3.new(W + 4, 2, 80),
		Position = Vector3.new(0, -1, -40),
		Color = Color3.fromRGB(70, 75, 90),
		Material = Enum.Material.Concrete,
		Parent = map,
	})

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = Vector3.new(14, 1, 14)
	spawn.Position = Vector3.new(0, 0.5, -55)
	spawn.Color = Color3.fromRGB(60, 160, 255)
	spawn.Material = Enum.Material.Neon
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = map

	-- Punto de patada (círculo blanco)
	local kickSpot = makePart({
		Name = "PuntoDePatada",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 16, 16),
		CFrame = CFrame.new(0, 0.15, -2) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.new(1, 1, 1),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		Parent = map,
	})
	local kickSign = Instance.new("BillboardGui")
	kickSign.Size = UDim2.fromScale(24, 6)
	kickSign.StudsOffset = Vector3.new(0, 12, 0)
	kickSign.LightInfluence = 0
	kickSign.Parent = kickSpot
	makeLabel(kickSign, "⚽ ¡PATEA AQUÍ!", UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), Color3.fromRGB(255, 230, 80))

	for zone = 1, Config.NUM_ZONES do
		buildZone(map, zone)
	end
	buildGoal(map)

	local balls = Instance.new("Folder")
	balls.Name = "Balones"
	balls.Parent = workspace

	local footballers = Instance.new("Folder")
	footballers.Name = "Futbolistas"
	footballers.Parent = workspace

	return map
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="9">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="10">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="11">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="12">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Interfaz del jugador: barra de fuerza, botón de patear, tienda, colección y cámara.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local KickEvent = Remotes:WaitForChild("Kick") :: RemoteEvent
local BallLaunchedEvent = Remotes:WaitForChild("BallLaunched") :: RemoteEvent
local KickResultEvent = Remotes:WaitForChild("KickResult") :: RemoteEvent
local AnnouncementEvent = Remotes:WaitForChild("Announcement") :: RemoteEvent
local DataUpdatedEvent = Remotes:WaitForChild("DataUpdated") :: RemoteEvent
local GetDataFunction = Remotes:WaitForChild("GetData") :: RemoteFunction
local PurchaseFunction = Remotes:WaitForChild("Purchase") :: RemoteFunction

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local data: any = nil
local kicking = false -- true desde que pateas hasta que el balón cae y vuelve la cámara
local flyingBall: BasePart? = nil
local needleValue = 0
local needleTime = 0
local NEEDLE_PERIOD = 0.8 -- segundos que tarda la barra en ir de 0 a 100%

-- ============================================================
-- Ayudantes de UI
-- ============================================================
local COLORS = {
	Panel = Color3.fromRGB(24, 28, 42),
	PanelLight = Color3.fromRGB(38, 44, 64),
	Green = Color3.fromRGB(60, 200, 90),
	GreenDark = Color3.fromRGB(35, 140, 60),
	Gold = Color3.fromRGB(255, 200, 50),
	Red = Color3.fromRGB(230, 70, 70),
	Gray = Color3.fromRGB(110, 115, 130),
	Text = Color3.new(1, 1, 1),
	Muted = Color3.fromRGB(180, 185, 200),
}
local FONT = Enum.Font.FredokaOne

local function create(className: string, props: { [string]: any }, children: { Instance }?): any
	local obj = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			(obj :: any)[key] = value
		end
	end
	if children then
		for _, child in children do
			child.Parent = obj
		end
	end
	if props.Parent then
		obj.Parent = props.Parent
	end
	return obj
end

local function corner(radius: number?): UICorner
	return create("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

local function stroke(color: Color3, thickness: number?): UIStroke
	return create("UIStroke", {
		Color = color,
		Thickness = thickness or 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

local function textLabel(props: { [string]: any }): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		Font = FONT,
		TextColor3 = COLORS.Text,
		TextScaled = true,
		TextStrokeTransparency = 0.6,
	}
	for key, value in props do
		defaults[key] = value
	end
	return create("TextLabel", defaults)
end

local function button(props: { [string]: any }, color: Color3): TextButton
	local defaults = {
		BackgroundColor3 = color,
		Font = FONT,
		TextColor3 = COLORS.Text,
		TextScaled = true,
		TextStrokeTransparency = 0.6,
		AutoButtonColor = true,
	}
	for key, value in props do
		defaults[key] = value
	end
	local b = create("TextButton", defaults, { corner(10), create("UIPadding", {
		PaddingTop = UDim.new(0, 4),
		PaddingBottom = UDim.new(0, 4),
		PaddingLeft = UDim.new(0, 6),
		PaddingRight = UDim.new(0, 6),
	}) })
	return b
end

local gui = create("ScreenGui", {
	Name = "PateaElBalonUI",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})

-- ============================================================
-- Barra superior (monedas, fuerza, balón)
-- ============================================================
local topBar = create("Frame", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 8),
	Size = UDim2.new(0.7, 0, 0, 44),
	BackgroundTransparency = 1,
	Parent = gui,
}, {
	create("UISizeConstraint", { MaxSize = Vector2.new(620, 44) }),
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 8),
	}),
})

local function pill(order: number, widthScale: number): TextLabel
	return textLabel({
		LayoutOrder = order,
		Size = UDim2.new(widthScale, -6, 1, 0),
		BackgroundTransparency = 0.15,
		BackgroundColor3 = COLORS.Panel,
		Text = "...",
		Parent = topBar,
	})
end
local coinsPill = pill(1, 0.3)
local strengthPill = pill(2, 0.28)
local ballPill = pill(3, 0.42)
for _, p in { coinsPill, strengthPill, ballPill } do
	corner(12).Parent = p
	create("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6) }).Parent = p
end
coinsPill.TextColor3 = COLORS.Gold

-- Info de vuelo (distancia y zona en vivo)
local flightLabel = textLabel({
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 60),
	Size = UDim2.new(0.6, 0, 0, 40),
	Text = "",
	Visible = false,
	TextStrokeTransparency = 0,
	Parent = gui,
})

-- Anuncios para todo el servidor
local announcementLabel = textLabel({
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 104),
	Size = UDim2.new(0.8, 0, 0, 30),
	Text = "",
	Visible = false,
	TextStrokeTransparency = 0,
	Parent = gui,
})

-- ============================================================
-- Panel de patada (abajo)
-- ============================================================
local kickPanel = create("Frame", {
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -16),
	Size = UDim2.new(0.9, 0, 0, 150),
	BackgroundColor3 = COLORS.Panel,
	BackgroundTransparency = 0.15,
	Parent = gui,
}, {
	corner(16),
	create("UISizeConstraint", { MaxSize = Vector2.new(440, 150) }),
})

local powerInfo = textLabel({
	Position = UDim2.new(0, 12, 0, 6),
	Size = UDim2.new(1, -24, 0, 22),
	Text = "Potencia: ...",
	TextColor3 = COLORS.Muted,
	Parent = kickPanel,
})

local barBack = create("Frame", {
	Position = UDim2.new(0, 12, 0, 34),
	Size = UDim2.new(1, -24, 0, 30),
	BackgroundColor3 = Color3.new(1, 1, 1),
	ClipsDescendants = false,
	Parent = kickPanel,
}, {
	corner(8),
	stroke(Color3.new(0, 0, 0), 2),
	create("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(220, 50, 50)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(250, 210, 50)),
			ColorSequenceKeypoint.new(0.89, Color3.fromRGB(70, 210, 90)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(70, 210, 90)),
		}),
	}),
})

-- Zona "PERFECTO" al final de la barra
create("Frame", {
	Position = UDim2.fromScale(Config.PERFECT_THRESHOLD, 0),
	Size = UDim2.fromScale(1 - Config.PERFECT_THRESHOLD, 1),
	BackgroundColor3 = COLORS.Gold,
	BorderSizePixel = 0,
	Parent = barBack,
}, {
	corner(8),
	textLabel({ Size = UDim2.fromScale(1, 1), Text = "★", TextColor3 = Color3.new(1, 1, 1) }),
})

local needle = create("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0, 0.5),
	Size = UDim2.new(0, 6, 1, 14),
	BackgroundColor3 = Color3.new(1, 1, 1),
	ZIndex = 3,
	Parent = barBack,
}, {
	corner(3),
	stroke(Color3.new(0, 0, 0), 2),
})

local kickButton = button({
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 76),
	Size = UDim2.new(1, -24, 0, 62),
	Text = "⚽ PATEAR  (clic o F)",
	Parent = kickPanel,
}, COLORS.Green)
stroke(COLORS.GreenDark, 3).Parent = kickButton

-- ============================================================
-- Mensajes cortos (compras, errores)
-- ============================================================
local toastLabel = textLabel({
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -176),
	Size = UDim2.new(0.6, 0, 0, 30),
	Text = "",
	Visible = false,
	TextStrokeTransparency = 0,
	Parent = gui,
})
local toastId = 0
local function toast(text: string, color: Color3?)
	toastId += 1
	local myId = toastId
	toastLabel.Text = text
	toastLabel.TextColor3 = color or COLORS.Text
	toastLabel.Visible = true
	task.delay(2.5, function()
		if toastId == myId then
			toastLabel.Visible = false
		end
	end)
end

-- ============================================================
-- Ventana genérica (tienda y colección)
-- ============================================================
local openWindow: Frame? = nil

local function makeWindow(title: string): (Frame, Frame)
	local window = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.48),
		Size = UDim2.fromScale(0.9, 0.72),
		BackgroundColor3 = COLORS.Panel,
		Visible = false,
		ZIndex = 10,
		Parent = gui,
	}, {
		corner(16),
		stroke(COLORS.Gold, 3),
		create("UISizeConstraint", { MaxSize = Vector2.new(540, 480) }),
	})
	textLabel({
		Position = UDim2.new(0, 16, 0, 10),
		Size = UDim2.new(1, -80, 0, 36),
		Text = title,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 11,
		Parent = window,
	})
	local close = button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 10),
		Size = UDim2.new(0, 40, 0, 36),
		Text = "X",
		ZIndex = 11,
		Parent = window,
	}, COLORS.Red)
	close.Activated:Connect(function()
		window.Visible = false
		openWindow = nil
	end)
	local content = create("Frame", {
		Position = UDim2.new(0, 12, 0, 54),
		Size = UDim2.new(1, -24, 1, -66),
		BackgroundTransparency = 1,
		ZIndex = 11,
		Parent = window,
	})
	return window, content
end

local function toggleWindow(window: Frame)
	if openWindow and openWindow ~= window then
		openWindow.Visible = false
	end
	window.Visible = not window.Visible
	openWindow = if window.Visible then window else nil
end

