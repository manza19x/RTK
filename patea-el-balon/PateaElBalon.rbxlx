			P(Vector3.new(0.6, 7, 0.6), spot(8, 25 + k * 50 + dz, 3.5), GOLD, { Material = FOIL })
		end
		tree((cf * CFrame.new(-22, 0, -8)).Position, "Pino")
		tree((cf * CFrame.new(22, 0, -8)).Position, "Pino")
	end
end

function Scenes.Autos()
