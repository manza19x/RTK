      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">DataManager</string>
          <string name="Source"><![CDATA[-- Guarda y carga los datos de cada jugador (monedas, fuerza, balón, colección).
-- En Studio: Home > Game Settings > Security > "Enable Studio Access to API Services"
-- para que se guarde mientras pruebas.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)

local STORE_NAME = "PateaElBalon_v1"
local AUTOSAVE_SECONDS = 120

export type PlayerData = {
	Coins: number,
	Power: number,
	BallTier: number,
	BestDistance: number,
	TotalKicks: number,
	Collection: { [string]: number }, -- cuántas veces te salió cada futbolista (Índice)
	Squad: { string }, -- ids de los futbolistas en tu plantilla
	Slots: number, -- espacios de la plantilla
}

local function defaultData(): PlayerData
	return {
		Coins = 0,
		Power = Config.START_POWER,
		BallTier = 1,
		BestDistance = 0,
		TotalKicks = 0,
		Collection = {},
		Squad = {},
		Slots = Config.START_SLOTS,
	}
end

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[Datos] DataStore no disponible, no se guardará el progreso:", result)
	end
end

local DataManager = {}

local profiles: { [Player]: PlayerData } = {}
-- Si la carga falló, NO guardamos para no borrar el progreso real del jugador
local canSave: { [Player]: boolean } = {}

local function keyFor(player: Player): string
	return "jugador_" .. player.UserId
end

-- Completa campos que falten (por si agregas cosas nuevas en el futuro)
local function reconcile(saved: any): PlayerData
	local data = defaultData()
	if type(saved) == "table" then
		for key, value in saved do
			if (data :: any)[key] ~= nil and type(value) == type((data :: any)[key]) then
				(data :: any)[key] = value
			end
		end
	end
	-- Quitamos futbolistas que ya no existan en Config (por si cambiaste la lista)
	local squad = {}
	for _, id in data.Squad do
		if Config.GetFootballer(id) and #squad < data.Slots then
			table.insert(squad, id)
		end
	end
	data.Squad = squad
	data.BallTier = math.clamp(data.BallTier, 1, #Config.Balls)
	return data
end

function DataManager.Load(player: Player): PlayerData
	local saved = nil
	local loaded = store == nil -- sin DataStore no hay nada que perder
	if store then
		-- En Studio sin acceso a la API no tiene caso reintentar
		local attempts = if RunService:IsStudio() then 1 else 3
		for attempt = 1, attempts do
			local ok, result = pcall(function()
				return (store :: DataStore):GetAsync(keyFor(player))
			end)
			if ok then
				saved = result
				loaded = true
				break
			end
			warn(string.format("[Datos] Error cargando a %s (intento %d): %s", player.Name, attempt, tostring(result)))
			if attempt < attempts then
				task.wait(attempt)
			end
		end
	end

	local data = reconcile(saved)
	if player.Parent == nil then
		return data -- se salió mientras cargaba
	end
	profiles[player] = data
	canSave[player] = loaded and store ~= nil
	if not loaded then
		warn("[Datos] No se pudo cargar a " .. player.Name .. "; su progreso de esta sesión no se guardará.")
	end
	return data
end

function DataManager.Get(player: Player): PlayerData?
	return profiles[player]
end

function DataManager.Save(player: Player)
	local data = profiles[player]
	if not data or not canSave[player] or not store then
		return
	end
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			(store :: DataStore):SetAsync(keyFor(player), data, { player.UserId })
		end)
		if ok then
			return
		end
		warn(string.format("[Datos] Error guardando a %s (intento %d): %s", player.Name, attempt, tostring(err)))
		task.wait(attempt)
	end
end

function DataManager.Release(player: Player)
	DataManager.Save(player)
	profiles[player] = nil
	canSave[player] = nil
end

function DataManager.Start()
	Players.PlayerRemoving:Connect(DataManager.Release)

	game:BindToClose(function()
		local pending = 0
		for _, player in Players:GetPlayers() do
			pending += 1
			task.spawn(function()
				DataManager.Save(player)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.1)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_SECONDS)
			for _, player in Players:GetPlayers() do
				task.spawn(DataManager.Save, player)
			end
		end
	end)
end

return DataManager
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="7">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Lógica principal del servidor: patadas, poder, vuelo del balón, sorteo, plantilla y tienda.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage.Shared.Config)
local MapBuilder = require(script.Parent.MapBuilder)
local DataManager = require(script.Parent.DataManager)

local rng = Random.new()

-- ------------------------------------------------------------
-- Remotes (comunicación servidor <-> cliente)
-- ------------------------------------------------------------
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"

local function remote(className: string, name: string): any
	local r = Instance.new(className)
	r.Name = name
	r.Parent = remotes
	return r
end

local KickEvent: RemoteEvent = remote("RemoteEvent", "Kick")
local BallLaunchedEvent: RemoteEvent = remote("RemoteEvent", "BallLaunched")
local KickResultEvent: RemoteEvent = remote("RemoteEvent", "KickResult")
local AnnouncementEvent: RemoteEvent = remote("RemoteEvent", "Announcement")
local DataUpdatedEvent: RemoteEvent = remote("RemoteEvent", "DataUpdated")
local GetDataFunction: RemoteFunction = remote("RemoteFunction", "GetData")
local PurchaseFunction: RemoteFunction = remote("RemoteFunction", "Purchase")

-- ------------------------------------------------------------
-- Modelo base de futbolista (el cliente lo clona y lo pinta)
-- ------------------------------------------------------------
local function buildSimpleRig(): Model
	-- Plan B si no se puede crear un avatar R15
	local model = Instance.new("Model")
	local function block(name: string, size: Vector3, offset: Vector3): Part
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Anchored = true
		p.CanCollide = false
		p.CFrame = CFrame.new(offset)
		p.Parent = model
		return p
	end
	local root = block("HumanoidRootPart", Vector3.new(2, 2, 1), Vector3.new(0, 3, 0))
	root.Transparency = 1
	block("UpperTorso", Vector3.new(2, 2, 1), Vector3.new(0, 3, 0))
	block("Head", Vector3.new(1.2, 1.2, 1.2), Vector3.new(0, 4.6, 0))
	block("LeftHand", Vector3.new(1, 2, 1), Vector3.new(-1.5, 3, 0))
	block("RightHand", Vector3.new(1, 2, 1), Vector3.new(1.5, 3, 0))
	block("LeftUpperLeg", Vector3.new(1, 2, 1), Vector3.new(-0.5, 1, 0))
	block("RightUpperLeg", Vector3.new(1, 2, 1), Vector3.new(0.5, 1, 0))
	model.PrimaryPart = root
	return model
end

local function buildRigTemplate(): Model
	local ok, result = pcall(function()
		return Players:CreateHumanoidModelFromDescription(Instance.new("HumanoidDescription"), Enum.HumanoidRigType.R15)
	end)
	local model: Model
	if ok and result then
		model = result
		local animate = model:FindFirstChild("Animate")
		if animate then
			animate:Destroy()
		end
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		end
		for _, obj in model:GetDescendants() do
			if obj:IsA("BasePart") then
				obj.CanCollide = false
				obj.Anchored = obj.Name == "HumanoidRootPart"
			end
		end
	else
		warn("[Futbolista] No se pudo crear el avatar R15, uso uno de bloques:", result)
		model = buildSimpleRig()
	end
	model.Name = "FootballerRig"
	return model
end

MapBuilder.Build()

local assets = Instance.new("Folder")
assets.Name = "Assets"
buildRigTemplate().Parent = assets
assets.Parent = ReplicatedStorage
remotes.Parent = ReplicatedStorage
DataManager.Start()

local KICK_ORIGIN = Vector3.new(0, 1.5, 0)

-- ------------------------------------------------------------
-- Datos, plantilla y leaderstats
-- ------------------------------------------------------------
local function getIncome(data: DataManager.PlayerData): number
	local total = 0
	for _, id in data.Squad do
		local f = Config.GetFootballer(id)
		if f then
			total += f.Income
		end
	end
	return total
end

local function updateLeaderstats(player: Player)
	local data = DataManager.Get(player)
	local stats = player:FindFirstChild("leaderstats")
	if not data or not stats then
		return
	end
	(stats:FindFirstChild("Monedas") :: IntValue).Value = data.Coins;
	(stats:FindFirstChild("Poder") :: IntValue).Value = data.Power;
	(stats:FindFirstChild("Ingreso/s") :: IntValue).Value = getIncome(data)
end

local function sendData(player: Player)
	local data = DataManager.Get(player)
	if data then
		DataUpdatedEvent:FireClient(player, data)
		updateLeaderstats(player)
	end
end

GetDataFunction.OnServerInvoke = function(player: Player)
	-- Esperamos a que termine de cargar
	local started = os.clock()
	while not DataManager.Get(player) and player.Parent and os.clock() - started < 30 do
		task.wait(0.2)
	end
	return DataManager.Get(player)
end

local function onPlayerAdded(player: Player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	for _, name in { "Monedas", "Poder", "Ingreso/s" } do
		local value = Instance.new("IntValue")
		value.Name = name
		value.Parent = stats
	end
	stats.Parent = player

	DataManager.Load(player)
	sendData(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
-- Por si alguien entró antes de que corriera este script
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

-- Los futbolistas de la plantilla pagan cada segundo
task.spawn(function()
	while true do
		task.wait(1)
		for _, player in Players:GetPlayers() do
			local data = DataManager.Get(player)
			if data then
				data.Coins += getIncome(data)
				updateLeaderstats(player)
			end
		end
	end
end)

-- Mete al futbolista en la plantilla. Si está llena, se queda con los mejores
-- y vende automáticamente al peor.
local function addToSquad(data: DataManager.PlayerData, f: Config.Footballer): (string, string?, number)
	if #data.Squad < data.Slots then
		table.insert(data.Squad, f.Id)
		return "Fichado", nil, 0
	end

	local worstIndex, worstIncome = 0, math.huge
	for i, id in data.Squad do
		local other = Config.GetFootballer(id)
		local income = if other then other.Income else 0
		if income < worstIncome then
			worstIndex, worstIncome = i, income
		end
	end

	if worstIndex > 0 and f.Income > worstIncome then
		local replacedId = data.Squad[worstIndex]
		local replaced = Config.GetFootballer(replacedId)
		local sale = if replaced then Config.GetSellPrice(replaced) else 0
		data.Squad[worstIndex] = f.Id
		data.Coins += sale
		return "Reemplazo", replacedId, sale
	end

	local sale = Config.GetSellPrice(f)
	data.Coins += sale
	return "Vendido", nil, sale
end

-- ------------------------------------------------------------
-- Patada
-- ------------------------------------------------------------
local busy: { [Player]: boolean } = {}

local function createBall(ballTier: number): Part
	local info = Config.Balls[ballTier] or Config.Balls[1]
	local ball = Instance.new("Part")
	ball.Name = "Balon"
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.new(3, 3, 3)
	ball.Color = info.Color
	ball.Material = info.Material
	ball.CanCollide = false
	ball.CanQuery = false
	ball.TopSurface = Enum.SurfaceType.Smooth
	ball.BottomSurface = Enum.SurfaceType.Smooth

	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0.8, 0)
	a0.Parent = ball
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -0.8, 0)
	a1.Parent = ball
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = ColorSequence.new(info.Color)
	trail.Transparency = NumberSequence.new(0.2, 1)
	trail.Lifetime = 0.6
	trail.LightEmission = 0.5
	trail.FaceCamera = true
	trail.Parent = ball
	return ball
end

local function placeCharacterBehindBall(player: Player)
	local character = player.Character
	if character and character:FindFirstChild("HumanoidRootPart") then
		character:PivotTo(CFrame.lookAt(Vector3.new(0, 3, -6), Vector3.new(0, 3, 10)))
	end
end

local function handleKick(player: Player, timing: number)
	local data = DataManager.Get(player)
	if not data then
		return
	end

	timing = math.clamp(timing, 0, 1)
	local perfect = timing >= Config.PERFECT_THRESHOLD
	local timingMultiplier = if perfect then Config.PERFECT_BONUS else math.max(timing, Config.MIN_TIMING)
	local maxDistance = Config.GetKickDistance(data.Power, data.BallTier)
	local distance = math.clamp(maxDistance * timingMultiplier * rng:NextNumber(0.95, 1.05), 5, Config.MAX_DISTANCE)

	-- Entrenar: cada patada te da poder
	local powerGain = Config.GetPowerGain(timing)
	data.Power += powerGain
	updateLeaderstats(player)

	placeCharacterBehindBall(player)

	-- Vuelo con física: calculamos la velocidad exacta para caer en `landing` en `flightTime` segundos
	local maxSide = math.min(distance * 0.06, Config.FIELD_WIDTH / 2 - 8)
	local landing = Vector3.new(rng:NextNumber(-maxSide, maxSide), KICK_ORIGIN.Y, distance)
	local flightTime = math.clamp(1.2 + distance / 600, 1.2, 6)
	local gravity = workspace.Gravity
	local horizontal = (landing - KICK_ORIGIN) / flightTime
	local velocity = Vector3.new(horizontal.X, gravity * flightTime / 2, horizontal.Z)

	local ball = createBall(data.BallTier)
	ball.Position = KICK_ORIGIN
	ball.Parent = workspace.Balones
	ball:SetNetworkOwner(nil)
	ball.AssemblyLinearVelocity = velocity
	ball.AssemblyAngularVelocity = Vector3.new(20, 0, 0)

	BallLaunchedEvent:FireClient(player, ball, {
		FlightTime = flightTime,
		Perfect = perfect,
		PowerGain = powerGain,
		Power = data.Power,
	})

	task.wait(flightTime)
	if ball.Parent then
		ball.Anchored = true
		ball.AssemblyLinearVelocity = Vector3.zero
		ball.Position = landing
	end
	Debris:AddItem(ball, 12)

	-- Resultado
	local current = DataManager.Get(player)
	if not current then
		return
	end
	local zone = Config.GetZoneFromDistance(distance)
	local luck = Config.GetLuckAtDistance(distance)
	local footballer = Config.RollFootballer(luck, rng)
	local isNew = (current.Collection[footballer.Id] or 0) == 0
	local kickCoins = Config.GetCoinsForKick(distance)
	local newRecord = distance > current.BestDistance

	current.Coins += kickCoins
	current.TotalKicks += 1
	current.Collection[footballer.Id] = (current.Collection[footballer.Id] or 0) + 1
	if newRecord then
		current.BestDistance = distance
	end
	local squadStatus, replacedId, saleCoins = addToSquad(current, footballer)

	KickResultEvent:FireClient(player, {
		FootballerId = footballer.Id,
		Distance = distance,
		Zone = zone,
		Luck = luck,
		Coins = kickCoins,
		IsNew = isNew,
		NewRecord = newRecord,
		Landing = landing,
		SquadStatus = squadStatus,
		ReplacedId = replacedId,
		SaleCoins = saleCoins,
	})
	sendData(player)

	local rarity = Config.Rarities[footballer.Rarity]
	if rarity.Order >= Config.Rarities.Legendario.Order then
		AnnouncementEvent:FireAllClients(
			string.format(
				"🎉 ¡%s sacó a %s! (%s · 1 en %s)",
				player.DisplayName,
				footballer.Name,
				rarity.Name,
				Config.FormatNumber(footballer.Chance)
			),
			rarity.Color
		)
	end
end

KickEvent.OnServerEvent:Connect(function(player: Player, timing: any)
	if busy[player] or typeof(timing) ~= "number" or timing ~= timing then
		return
	end
	busy[player] = true
	local ok, err = pcall(handleKick, player, timing)
	if not ok then
		warn("[Patada] Error:", err)
	end
	busy[player] = nil
end)

Players.PlayerRemoving:Connect(function(player)
	busy[player] = nil
end)

-- ------------------------------------------------------------
-- Tienda y plantilla
-- ------------------------------------------------------------
PurchaseFunction.OnServerInvoke = function(player: Player, kind: any, arg: any): (boolean, string)
	local data = DataManager.Get(player)
	if not data then
		return false, "Tus datos todavía están cargando."
	end

	if kind == "Ball" then
		local nextTier = data.BallTier + 1
		local ball = Config.Balls[nextTier]
		if not ball then
			return false, "¡Ya tienes el mejor balón!"
		end
		if data.Coins < ball.Price then
			return false, "¡No tienes suficientes monedas!"
		end
		data.Coins -= ball.Price
		data.BallTier = nextTier
		sendData(player)
		return true, "⚽ ¡Compraste el " .. ball.Name .. "!"
	elseif kind == "Slot" then
		if data.Slots >= Config.MAX_SLOTS then
			return false, "¡Ya tienes el máximo de espacios!"
		end
		local cost = Config.GetSlotCost(data.Slots)
		if data.Coins < cost then
			return false, "¡No tienes suficientes monedas!"
		end
		data.Coins -= cost
		data.Slots += 1
		sendData(player)
		return true, "🏟️ ¡Plantilla ampliada a " .. data.Slots .. " espacios!"
	elseif kind == "Sell" then
		if typeof(arg) ~= "string" then
			return false, "Venta inválida."
		end
		local index = table.find(data.Squad, arg)
		local f = Config.GetFootballer(arg)
		if not index or not f then
			return false, "Ese futbolista no está en tu plantilla."
		end
		table.remove(data.Squad, index)
		local sale = Config.GetSellPrice(f)
		data.Coins += sale
		sendData(player)
		return true, "Vendiste a " .. f.Name .. " por 💰" .. Config.FormatShort(sale)
	end

	return false, "Compra inválida."
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[-- Construye el mapa: lobby, punto de patada y un cañón de 30 zonas dividido en biomas.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local MapBuilder = {}

local W = Config.FIELD_WIDTH
local L = Config.ZONE_LENGTH
local SIDE = 26 -- ancho de las orillas con decoración
local WALL_X = W / 2 + SIDE -- donde empiezan las paredes del cañón

local function makePart(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		if key ~= "Parent" then
			(p :: any)[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

local function makeLabel(parent: Instance, text: string, size: UDim2, position: UDim2, color: Color3)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = size
	label.Position = position
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	label.TextStrokeTransparency = 0
	label.Text = text
	label.Parent = parent
	return label
end

-- ------------------------------------------------------------
-- Decoraciones (hechas con bloques, estilo Roblox clásico)
-- ------------------------------------------------------------
local Decorations = {}

function Decorations.Casa(model: Model, pos: Vector3, rng: Random)
	local colors = { Color3.fromRGB(240, 200, 120), Color3.fromRGB(200, 120, 90), Color3.fromRGB(150, 190, 230), Color3.fromRGB(240, 240, 230) }
	local size = Vector3.new(rng:NextInteger(10, 14), rng:NextInteger(8, 12), rng:NextInteger(10, 14))
	makePart({ Size = size, Position = pos + Vector3.new(0, size.Y / 2, 0), Color = colors[rng:NextInteger(1, #colors)], Material = Enum.Material.Brick, Parent = model })
	local roof = Instance.new("WedgePart")
	roof.Anchored = true
	roof.Size = Vector3.new(size.X + 1, 5, size.Z / 2 + 0.5)
	roof.Color = Color3.fromRGB(170, 60, 50)
	-- La parte alta de una cuña está atrás (+Z), así que las dos mitades se juntan en el centro
	roof.CFrame = CFrame.new(pos + Vector3.new(0, size.Y + 2.5, -size.Z / 4))
	roof.Parent = model
	local roof2 = roof:Clone()
	roof2.CFrame = CFrame.new(pos + Vector3.new(0, size.Y + 2.5, size.Z / 4)) * CFrame.Angles(0, math.pi, 0)
	roof2.Parent = model
	makePart({ Size = Vector3.new(3, 5, 0.4), Position = pos + Vector3.new(0, 2.5, -size.Z / 2 - 0.1), Color = Color3.fromRGB(100, 60, 40), Parent = model })
end

function Decorations.Arbol(model: Model, pos: Vector3, rng: Random)
	local h = rng:NextInteger(8, 14)
	makePart({ Size = Vector3.new(2, h, 2), Position = pos + Vector3.new(0, h / 2, 0), Color = Color3.fromRGB(110, 70, 40), Material = Enum.Material.Wood, Parent = model })
	local green = Color3.fromRGB(rng:NextInteger(60, 100), rng:NextInteger(160, 210), rng:NextInteger(50, 80))
	makePart({ Size = Vector3.new(10, 5, 10), Position = pos + Vector3.new(0, h + 1.5, 0), Color = green, Material = Enum.Material.Grass, Parent = model })
	makePart({ Size = Vector3.new(6, 4, 6), Position = pos + Vector3.new(0, h + 5.5, 0), Color = green, Material = Enum.Material.Grass, Parent = model })
end

function Decorations.Palmera(model: Model, pos: Vector3, rng: Random)
	local h = rng:NextInteger(14, 20)
	makePart({ Size = Vector3.new(1.6, h, 1.6), Position = pos + Vector3.new(0, h / 2, 0), Color = Color3.fromRGB(160, 120, 70), Material = Enum.Material.Wood, Parent = model })
	for i = 0, 3 do
		local angle = i * math.pi / 2 + rng:NextNumber(0, 0.4)
		makePart({
			Size = Vector3.new(2.5, 0.6, 9),
			CFrame = CFrame.new(pos + Vector3.new(0, h, 0)) * CFrame.Angles(0, angle, 0) * CFrame.new(0, -0.8, -4) * CFrame.Angles(math.rad(-15), 0, 0),
			Color = Color3.fromRGB(60, 170, 60),
			Material = Enum.Material.Grass,
			Parent = model,
		})
	end
	makePart({ Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 1.4, 1.4), Position = pos + Vector3.new(0.8, h - 1, 0.6), Color = Color3.fromRGB(110, 80, 40), Parent = model })
end

function Decorations.Cactus(model: Model, pos: Vector3, rng: Random)
	local h = rng:NextInteger(6, 11)
	local green = Color3.fromRGB(70, 150, 70)
	makePart({ Size = Vector3.new(2.4, h, 2.4), Position = pos + Vector3.new(0, h / 2, 0), Color = green, Material = Enum.Material.Grass, Parent = model })
	for side = -1, 1, 2 do
		if rng:NextNumber() < 0.7 then
			local armY = rng:NextNumber(h * 0.35, h * 0.6)
			makePart({ Size = Vector3.new(2.5, 1.6, 1.6), Position = pos + Vector3.new(side * 2.4, armY, 0), Color = green, Material = Enum.Material.Grass, Parent = model })
			makePart({ Size = Vector3.new(1.6, 3.5, 1.6), Position = pos + Vector3.new(side * 3.3, armY + 2.2, 0), Color = green, Material = Enum.Material.Grass, Parent = model })
		end
	end
end

function Decorations.Pino(model: Model, pos: Vector3, rng: Random)
	local h = rng:NextInteger(3, 5)
	makePart({ Size = Vector3.new(1.6, h, 1.6), Position = pos + Vector3.new(0, h / 2, 0), Color = Color3.fromRGB(100, 70, 45), Material = Enum.Material.Wood, Parent = model })
	local y = h
	for _, width in { 9, 7, 5, 3 } do
		makePart({ Size = Vector3.new(width, 2.5, width), Position = pos + Vector3.new(0, y + 1.25, 0), Color = Color3.fromRGB(40, 110, 70), Material = Enum.Material.Grass, Parent = model })
		makePart({ Size = Vector3.new(width - 0.6, 0.6, width - 0.6), Position = pos + Vector3.new(0, y + 2.8, 0), Color = Color3.new(1, 1, 1), Material = Enum.Material.Snow, Parent = model })
		y += 2.7
	end
end

function Decorations.Roca(model: Model, pos: Vector3, rng: Random)
	local s = rng:NextNumber(4, 8)
	makePart({
		Size = Vector3.new(s, s * 0.8, s),
		CFrame = CFrame.new(pos + Vector3.new(0, s * 0.3, 0)) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, math.pi), rng:NextNumber(-0.3, 0.3)),
		Color = Color3.fromRGB(60, 50, 50),
		Material = Enum.Material.Basalt,
		Parent = model,
	})
	-- grieta de lava
	makePart({
		Size = Vector3.new(rng:NextNumber(6, 12), 0.2, 1.2),
		CFrame = CFrame.new(pos + Vector3.new(rng:NextNumber(-3, 3), 0.05, rng:NextNumber(-3, 3))) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0),
		Color = Color3.fromRGB(255, 110, 30),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = model,
	})
end

-- ------------------------------------------------------------
-- Zonas
-- ------------------------------------------------------------
local function buildZone(map: Folder, zone: number)
	local biome = Config.GetBiome(zone)
	local startZ = (zone - 1) * L
	local zoneFolder = Instance.new("Folder")
	zoneFolder.Name = "Zona" .. zone
	zoneFolder.Parent = map
	local rng = Random.new(zone * 7919)

	-- Piso a cuadros (3 columnas x 2 filas)
	local cols, rows = 3, 2
	for c = 0, cols - 1 do
		for r = 0, rows - 1 do
			makePart({
				Name = "Piso",
				Size = Vector3.new(W / cols, 2, L / rows),
				Position = Vector3.new(-W / 2 + W / cols * (c + 0.5), -1, startZ + L / rows * (r + 0.5)),
				Color = Config.GetZoneColor(zone, (c + r + zone) % 2 == 0),
				Material = biome.GroundMaterial,
				Parent = zoneFolder,
			})
		end
	end

	-- Línea blanca al inicio de la zona y líneas laterales
	makePart({
		Name = "Linea",
		Size = Vector3.new(W, 0.2, 1.2),
		Position = Vector3.new(0, 0.1, startZ),
		Color = Color3.new(1, 1, 1),
		CanCollide = false,
		Parent = zoneFolder,
	})
	for side = -1, 1, 2 do
		makePart({
			Name = "LineaLateral",
			Size = Vector3.new(1, 0.2, L),
			Position = Vector3.new(side * (W / 2 - 0.5), 0.1, startZ + L / 2),
			Color = Color3.new(1, 1, 1),
			CanCollide = false,
			Parent = zoneFolder,
		})

		-- Orilla con decoración
		makePart({
			Name = "Orilla",
			Size = Vector3.new(SIDE, 2, L),
			Position = Vector3.new(side * (W / 2 + SIDE / 2), -0.6, startZ + L / 2),
			Color = biome.GroundAlt:Lerp(Color3.new(0, 0, 0), 0.12),
			Material = biome.GroundMaterial,
			Parent = zoneFolder,
		})

		-- Paredes del cañón en dos escalones
		makePart({
			Name = "Pared",
			Size = Vector3.new(12, 40, L),
			Position = Vector3.new(side * (WALL_X + 6), 19, startZ + L / 2),
			Color = biome.Wall,
			Material = Enum.Material.Slate,
			Parent = zoneFolder,
		})
		makePart({
			Name = "Cima",
			Size = Vector3.new(12.4, 3, L),
			Position = Vector3.new(side * (WALL_X + 6), 40.5, startZ + L / 2),
			Color = biome.WallTop,
			Material = Enum.Material.Grass,
			Parent = zoneFolder,
		})
		makePart({
			Name = "Pared2",
			Size = Vector3.new(16, 70, L),
			Position = Vector3.new(side * (WALL_X + 20), 34, startZ + L / 2),
			Color = biome.Wall:Lerp(Color3.new(0, 0, 0), 0.15),
			Material = Enum.Material.Slate,
			Parent = zoneFolder,
		})
		makePart({
			Name = "Cima2",
			Size = Vector3.new(16.4, 3, L),
			Position = Vector3.new(side * (WALL_X + 20), 70.5, startZ + L / 2),
			Color = biome.WallTop,
			Material = Enum.Material.Grass,
			Parent = zoneFolder,
		})

		-- Decoraciones en la orilla y arriba de la pared
		local builder = Decorations[biome.Decoration]
		for i = 1, 3 do
			local deco = Instance.new("Model")
			deco.Name = biome.Decoration
			local z = startZ + (i - 0.5) * L / 3 + rng:NextNumber(-8, 8)
			builder(deco, Vector3.new(side * (W / 2 + SIDE / 2 + rng:NextNumber(-6, 6)), 0.4, z), rng)
			deco.Parent = zoneFolder
		end
		for i = 1, 2 do
			local deco = Instance.new("Model")
			deco.Name = biome.Decoration
			local z = startZ + (i - 0.5) * L / 2 + rng:NextNumber(-10, 10)
			builder(deco, Vector3.new(side * (WALL_X + 6), 42, z), rng)
			deco.Parent = zoneFolder
		end
	end

	-- Cartel flotante con el número de zona y su suerte
	local anchor = makePart({
		Name = "Cartel",
		Size = Vector3.new(1, 1, 1),
		Position = Vector3.new(0, 30, startZ + 2),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Parent = zoneFolder,
	})
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(40, 16) -- en studs: se ve más chico de lejos
	billboard.LightInfluence = 0
	billboard.MaxDistance = 2500
	billboard.Parent = anchor
	makeLabel(billboard, "ZONA " .. zone, UDim2.fromScale(1, 0.6), UDim2.fromScale(0, 0), Color3.new(1, 1, 1))
	makeLabel(
		billboard,
		"🍀 x" .. Config.FormatLuck(Config.GetLuck(zone)),
		UDim2.fromScale(1, 0.4),
		UDim2.fromScale(0, 0.6),
		Color3.fromRGB(120, 255, 140)
	)
end

local function buildGoal(map: Folder)
	local z = Config.MAX_DISTANCE + 4
	local goalWidth, goalHeight = 60, 24
	local color = Color3.new(1, 1, 1)
	for side = -1, 1, 2 do
		makePart({ Name = "Poste", Size = Vector3.new(2, goalHeight, 2), Position = Vector3.new(side * goalWidth / 2, goalHeight / 2, z), Color = color, Parent = map })
	end
	makePart({ Name = "Travesano", Size = Vector3.new(goalWidth + 2, 2, 2), Position = Vector3.new(0, goalHeight, z), Color = color, Parent = map })
	makePart({
		Name = "Red",
		Size = Vector3.new(goalWidth, goalHeight, 0.2),
		Position = Vector3.new(0, goalHeight / 2, z + 10),
		Color = color,
		Transparency = 0.6,
		Material = Enum.Material.ForceField,
		Parent = map,
	})
	local lastBiome = Config.GetBiome(Config.NUM_ZONES)
	makePart({
		Name = "PisoFinal",
		Size = Vector3.new(W + SIDE * 2, 2, 20),
		Position = Vector3.new(0, -1, z + 6),
		Color = lastBiome.Ground,
		Material = lastBiome.GroundMaterial,
		Parent = map,
	})
	makePart({
		Name = "ParedFinal",
		Size = Vector3.new(W + SIDE * 2 + 60, 80, 6),
		Position = Vector3.new(0, 39, z + 19),
		Color = lastBiome.Wall,
		Material = Enum.Material.Slate,
		Parent = map,
	})
end

local function buildLobby(map: Folder)
	local first = Config.GetBiome(1)
	makePart({
		Name = "Lobby",
		Size = Vector3.new(W + SIDE * 2, 2, 90),
		Position = Vector3.new(0, -1, -45),
		Color = Color3.fromRGB(85, 90, 105),
		Material = Enum.Material.Concrete,
		Parent = map,
	})
	makePart({
		Name = "ParedLobby",
		Size = Vector3.new(W + SIDE * 2 + 60, 80, 6),
		Position = Vector3.new(0, 39, -93),
		Color = first.Wall,
		Material = Enum.Material.Slate,
		Parent = map,
	})
	for side = -1, 1, 2 do
		makePart({
			Name = "ParedLobbyLado",
			Size = Vector3.new(40, 70, 90),
			Position = Vector3.new(side * (WALL_X + 20), 34, -45),
			Color = first.Wall,
			Material = Enum.Material.Slate,
			Parent = map,
		})
	end

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = Vector3.new(14, 1, 14)
	spawn.Position = Vector3.new(0, 0.5, -60)
	spawn.Color = Color3.fromRGB(60, 160, 255)
	spawn.Material = Enum.Material.Neon
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = map

	-- Punto de patada (círculo blanco) con un arco encima
	local kickSpot = makePart({
		Name = "PuntoDePatada",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 16, 16),
		CFrame = CFrame.new(0, 0.15, -2) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.new(1, 1, 1),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		Parent = map,
	})
	for side = -1, 1, 2 do
		makePart({ Name = "Arco", Size = Vector3.new(3, 22, 3), Position = Vector3.new(side * 14, 11, -2), Color = Color3.fromRGB(255, 210, 60), Material = Enum.Material.SmoothPlastic, Parent = map })
	end
	makePart({ Name = "Arco", Size = Vector3.new(31, 3, 3), Position = Vector3.new(0, 23.5, -2), Color = Color3.fromRGB(255, 210, 60), Material = Enum.Material.SmoothPlastic, Parent = map })

	local kickSign = Instance.new("BillboardGui")
	kickSign.Size = UDim2.fromScale(24, 6)
	kickSign.StudsOffset = Vector3.new(0, 30, 0)
	kickSign.LightInfluence = 0
	kickSign.Parent = kickSpot
	makeLabel(kickSign, "⚽ ¡PATEA AQUÍ!", UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), Color3.fromRGB(255, 230, 80))
end

function MapBuilder.Build(): Folder
	-- Si el lugar ya tiene otros spawns (plantilla Baseplate), los desactivamos
	for _, obj in workspace:GetDescendants() do
		if obj:IsA("SpawnLocation") then
			obj.Enabled = false
		end
	end

	local old = workspace:FindFirstChild("Mapa")
	if old then
		old:Destroy()
	end

	local map = Instance.new("Folder")
	map.Name = "Mapa"

	buildLobby(map)
	for zone = 1, Config.NUM_ZONES do
		buildZone(map, zone)
	end
	buildGoal(map)
	map.Parent = workspace

	for _, name in { "Balones" } do
		if not workspace:FindFirstChild(name) then
			local folder = Instance.new("Folder")
			folder.Name = name
			folder.Parent = workspace
		end
	end

	return map
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
    </Item>
