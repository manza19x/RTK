	ZIndex = 5,
	Parent = gui,
})
local perfectLabel = textLabel({
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.new(0.5, 0, 0.62, 0),
	Size = UDim2.new(0, 360, 0, 64),
