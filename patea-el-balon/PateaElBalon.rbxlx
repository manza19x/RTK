  </Item>
  <Item class="StarterPlayer" referent="12">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <token name="GameSettingsAvatar">1</token>
    </Properties>
    <Item class="StarterPlayerScripts" referent="13">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="14">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">FootballerMoves</string>
            <string name="Source"><![CDATA[-- Movimientos de los futbolistas: correr, caminar, dominadas con el balón,
-- festejos, bailes y estiramientos. Usa las animaciones R15 que trae Roblox
-- y, para las dominadas y estiramientos, mueve las articulaciones con código.
local RunService = game:GetService("RunService")

local Moves = {}

-- Animaciones R15 por defecto de Roblox (sirven en cualquier juego)
Moves.ANIMS = {
	Walk = "rbxassetid://507777826",
	Run = "rbxassetid://913376220",
	Wave = "rbxassetid://507770239",
	Cheer = "rbxassetid://507770677",
	Dance = "rbxassetid://507771019",
	Dance2 = "rbxassetid://507776043",
	Dance3 = "rbxassetid://507777268",
	Point = "rbxassetid://507770453",
	Laugh = "rbxassetid://507770818",
}

local tracks: { [Model]: { [string]: AnimationTrack } } = setmetatable({}, { __mode = "k" }) :: any
local originals: { [Motor6D]: CFrame } = setmetatable({}, { __mode = "k" }) :: any

function Moves.Play(model: Model, name: string, looped: boolean, speed: number?): AnimationTrack?
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local id = Moves.ANIMS[name]
	if not humanoid or not id then
		return nil
	end
	local cache = tracks[model]
	if not cache then
		cache = {}
		tracks[model] = cache
	end
	local track = cache[name]
	if not track then
		local ok, loaded = pcall(function()
			local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
			local animation = Instance.new("Animation")
			animation.AnimationId = id
			return animator:LoadAnimation(animation)
		end)
		if not ok or not loaded then
			return nil
		end
		track = loaded
		cache[name] = loaded
	end
	track.Looped = looped
	track:Play(0.15, 1, speed or 1)
	return track
end

function Moves.Stop(model: Model, name: string, fade: number?)
	local cache = tracks[model]
	local track = cache and cache[name]
	if track and track.IsPlaying then
		track:Stop(fade or 0.2)
	end
end

function Moves.StopAll(model: Model, fade: number?)
	local cache = tracks[model]
	if cache then
		for _, track in cache do
			if track.IsPlaying then
				track:Stop(fade or 0.2)
			end
		end
	end
end

-- ------------------------------------------------------------
-- Articulaciones
-- ------------------------------------------------------------
local function getJoint(model: Model, partName: string, jointName: string): Motor6D?
	local part = model:FindFirstChild(partName)
	local joint = part and part:FindFirstChild(jointName)
	if joint and joint:IsA("Motor6D") then
		if not originals[joint] then
			originals[joint] = joint.C0
		end
		return joint
	end
	return nil
end

local function setJoint(joint: Motor6D?, rotation: CFrame)
	if joint and originals[joint] then
		joint.C0 = originals[joint] * rotation
	end
end

local function resetJoint(joint: Motor6D?)
	if joint and originals[joint] then
		joint.C0 = originals[joint]
	end
end

local function makeBall(color: Color3?): Part
	local ball = Instance.new("Part")
	ball.Name = "BalonDominadas"
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.new(1.4, 1.4, 1.4)
	ball.Color = color or Color3.new(1, 1, 1)
	ball.Anchored = true
	ball.CanCollide = false
	ball.CanQuery = false
	ball.CanTouch = false
	ball.Parent = workspace
	return ball
end

-- Dominadas: el balón sube y baja y el futbolista lo golpea con un pie y luego con el otro
function Moves.Juggle(model: Model, duration: number, ballColor: Color3?)
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local rightHip = getJoint(model, "RightUpperLeg", "RightHip")
	local leftHip = getJoint(model, "LeftUpperLeg", "LeftHip")
	local rightKnee = getJoint(model, "RightLowerLeg", "RightKnee")
	local leftKnee = getJoint(model, "LeftLowerLeg", "LeftKnee")
	local rightShoulder = getJoint(model, "RightUpperArm", "RightShoulder")
	local leftShoulder = getJoint(model, "LeftUpperArm", "LeftShoulder")
	local ball = makeBall(ballColor)
	local period = 0.55
	local started = os.clock()

	while model.Parent and os.clock() - started < duration do
		local t = os.clock() - started
		local bounce = math.floor(t / period)
		local u = (t % period) / period
		local right = bounce % 2 == 0
		local kick = math.max(0, 1 - u * 5) -- la pierna sube al principio de cada rebote
		local y = -2.1 + 3.4 * 4 * u * (1 - u)
		ball.CFrame = root.CFrame * CFrame.new(if right then 0.45 else -0.45, y, -1.4) * CFrame.Angles(t * 8, 0, 0)
		setJoint(if right then rightHip else leftHip, CFrame.Angles(math.rad(50 * kick), 0, 0))
		setJoint(if right then rightKnee else leftKnee, CFrame.Angles(math.rad(-25 * kick), 0, 0))
		resetJoint(if right then leftHip else rightHip)
		resetJoint(if right then leftKnee else rightKnee)
		-- brazos abiertos para el equilibrio
		setJoint(rightShoulder, CFrame.Angles(0, 0, math.rad(25)))
		setJoint(leftShoulder, CFrame.Angles(0, 0, math.rad(-25)))
		RunService.RenderStepped:Wait()
	end

	for _, joint in { rightHip, leftHip, rightKnee, leftKnee, rightShoulder, leftShoulder } do
		resetJoint(joint)
	end
	ball:Destroy()
end

-- Estiramiento: brazos arriba y se inclina de lado a lado
function Moves.Stretch(model: Model, duration: number)
	local waist = getJoint(model, "UpperTorso", "Waist")
	local rightShoulder = getJoint(model, "RightUpperArm", "RightShoulder")
	local leftShoulder = getJoint(model, "LeftUpperArm", "LeftShoulder")
	local started = os.clock()
	while model.Parent and os.clock() - started < duration do
		local t = os.clock() - started
		local lean = math.sin(t * 2.2) * math.rad(22)
		setJoint(waist, CFrame.Angles(0, 0, lean))
		setJoint(rightShoulder, CFrame.Angles(math.rad(170), 0, 0))
		setJoint(leftShoulder, CFrame.Angles(math.rad(170), 0, 0))
		RunService.RenderStepped:Wait()
	end
	resetJoint(waist)
	resetJoint(rightShoulder)
	resetJoint(leftShoulder)
end

-- Saltito de festejo con los brazos arriba
function Moves.Jump(model: Model, jumps: number)
	local rightShoulder = getJoint(model, "RightUpperArm", "RightShoulder")
	local leftShoulder = getJoint(model, "LeftUpperArm", "LeftShoulder")
	local base = model:GetPivot()
	local started = os.clock()
	local duration = jumps * 0.5
	while model.Parent and os.clock() - started < duration do
		local t = os.clock() - started
		local u = (t % 0.5) / 0.5
		model:PivotTo(base * CFrame.new(0, 2.2 * 4 * u * (1 - u), 0))
		setJoint(rightShoulder, CFrame.Angles(math.rad(160), 0, math.rad(15)))
		setJoint(leftShoulder, CFrame.Angles(math.rad(160), 0, math.rad(-15)))
		RunService.RenderStepped:Wait()
	end
	if model.Parent then
		model:PivotTo(base)
	end
	resetJoint(rightShoulder)
	resetJoint(leftShoulder)
end

return Moves
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">KickAnimation</string>
            <string name="Source"><![CDATA[-- Animaciones de la patada hechas con código (sin subir animaciones a Roblox):
-- movemos las articulaciones (Motor6D) del personaje R15 del jugador.
--   KickAnimation.SetHolding(true/false): agarrar el balón con las manos
--   KickAnimation.Play(chilena): patada normal o chilena
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local KickAnimation = {}

local player = Players.LocalPlayer

-- Articulaciones R15: nombre del Motor6D -> parte donde vive
local JOINTS = {
	RightShoulder = "RightUpperArm",
	LeftShoulder = "LeftUpperArm",
	RightElbow = "RightLowerArm",
	LeftElbow = "LeftLowerArm",
	RightHip = "RightUpperLeg",
	LeftHip = "LeftUpperLeg",
	RightKnee = "RightLowerLeg",
	LeftKnee = "LeftLowerLeg",
	Waist = "UpperTorso",
}

type Pose = { [string]: number } -- ángulo en grados (rotación hacia adelante)

local joints: { [string]: Motor6D } = {}
local originals: { [Motor6D]: CFrame } = {}
local heldBall: Part? = nil
local holding = false
local playing = false
local ballOffset = CFrame.new(0, 0.5, -1.9) -- dónde va el balón respecto al jugador

local function findJoints(character: Model)
	table.clear(joints)
	for jointName, partName in JOINTS do
		local part = character:FindFirstChild(partName)
		local joint = part and part:FindFirstChild(jointName)
		if joint and joint:IsA("Motor6D") then
			joints[jointName] = joint
			if not originals[joint] then
				originals[joint] = joint.C0
			end
		end
	end
end

local function setPose(pose: Pose)
	for name, joint in joints do
		local original = originals[joint]
		if original then
			joint.C0 = original * CFrame.Angles(math.rad(pose[name] or 0), 0, 0)
		end
	end
end

local function lerpPose(a: Pose, b: Pose, t: number): Pose
	local result: Pose = {}
	for name in JOINTS do
		local from, to = a[name] or 0, b[name] or 0
		result[name] = from + (to - from) * t
	end
	return result
end

local HOLD_POSE: Pose = { RightShoulder = 55, LeftShoulder = 55, RightElbow = 40, LeftElbow = 40 }
local REST_POSE: Pose = {}

local function getRoot(): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function ensureBall(): Part
	if heldBall and heldBall.Parent then
		return heldBall
	end
	local ball = Instance.new("Part")
	ball.Name = "BalonEnLasManos"
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.new(2.4, 2.4, 2.4)
	ball.Anchored = true
	ball.CanCollide = false
	ball.CanQuery = false
	ball.CanTouch = false
	ball.CastShadow = true
	ball.Parent = workspace
	heldBall = ball
	return ball
end

function KickAnimation.SetBallLook(ballTier: number)
	local info = Config.Balls[ballTier] or Config.Balls[1]
	local ball = ensureBall()
	ball.Color = info.Color
	ball.Material = info.Material
end

function KickAnimation.SetHolding(value: boolean)
	if playing or holding == value then
		return
	end
	holding = value
	local character = player.Character
	if not character then
		return
	end
	findJoints(character)
	setPose(if value then HOLD_POSE else REST_POSE)
	local ball = ensureBall()
	ball.Transparency = if value then 0 else 1
end

-- Cada cuadro: el balón sigue las manos mientras lo tienes agarrado
RunService.RenderStepped:Connect(function()
	if holding and not playing and heldBall then
		local root = getRoot()
		if root then
			heldBall.CFrame = root.CFrame * ballOffset
		end
	end
end)

-- ------------------------------------------------------------
-- Cuadros clave: { tiempo, pose, posición del balón (respecto a donde está parado) }
-- ------------------------------------------------------------
type Key = { T: number, Pose: Pose, Ball: Vector3? }

local KICK: { Key } = {
	{ T = 0, Pose = HOLD_POSE, Ball = Vector3.new(0, 0.5, -1.9) },
	{ T = 0.18, Pose = { RightShoulder = 25, LeftShoulder = 25, RightHip = -45, RightKnee = -55, LeftKnee = -10 }, Ball = Vector3.new(0, -1.2, -1.7) },
	{ T = Config.KICK_CONTACT_TIME, Pose = { RightShoulder = -20, LeftShoulder = 40, RightHip = 80, RightKnee = -5, LeftKnee = -15 }, Ball = Vector3.new(0, -1.9, -2.0) },
	{ T = 0.5, Pose = { RightShoulder = -25, LeftShoulder = 45, RightHip = 90, LeftKnee = -10 } },
	{ T = Config.KICK_ANIMATION_TIME, Pose = REST_POSE },
}

local CHILENA: { Key } = {
	{ T = 0, Pose = HOLD_POSE, Ball = Vector3.new(0, 0.5, -1.9) },
	{ T = 0.3, Pose = { RightShoulder = 170, LeftShoulder = 170 }, Ball = Vector3.new(0, 3.8, -1.2) },
	{ T = 0.45, Pose = { RightShoulder = 120, LeftShoulder = 120, RightHip = -30, LeftHip = 40, RightKnee = -40 }, Ball = Vector3.new(0, 3.6, -1.4) },
	{ T = Config.CHILENA_CONTACT_TIME, Pose = { RightShoulder = 90, LeftShoulder = 90, RightHip = 130, LeftHip = -30, RightKnee = -5 }, Ball = Vector3.new(0, 3.5, -1.6) },
	{ T = 0.85, Pose = { RightShoulder = 60, LeftShoulder = 60, RightHip = 60, LeftHip = 10 } },
	{ T = Config.CHILENA_ANIMATION_TIME, Pose = REST_POSE },
}

-- La chilena: vuelta hacia atrás mientras patea
local FLIP_START, FLIP_END = 0.35, 1.05

local function smooth(t: number): number
	return t * t * (3 - 2 * t)
end

local function sample(keys: { Key }, t: number): (Pose, Vector3?)
	for i = 1, #keys - 1 do
		local a, b = keys[i], keys[i + 1]
		if t <= b.T then
			local alpha = smooth(math.clamp((t - a.T) / (b.T - a.T), 0, 1))
			local ballPos = nil
			if a.Ball and b.Ball then
				ballPos = a.Ball:Lerp(b.Ball, alpha)
			elseif a.Ball then
				ballPos = a.Ball
			end
			return lerpPose(a.Pose, b.Pose, alpha), ballPos
		end
	end
	return keys[#keys].Pose, nil
end

-- Reproduce la patada. `onContact` se llama cuando el pie toca el balón.
function KickAnimation.Play(chilena: boolean, onContact: (() -> ())?)
	local character = player.Character
	local root = getRoot()
	if not character or not root then
		return
	end
	findJoints(character)
	playing = true
	holding = false
	local keys = if chilena then CHILENA else KICK
	local duration = keys[#keys].T
	local contact = if chilena then Config.CHILENA_CONTACT_TIME else Config.KICK_CONTACT_TIME
	local base = CFrame.lookAt(Config.KICK_STAND, Config.KICK_STAND + Vector3.new(0, 0, 10))
	local ball = ensureBall()
	ball.Transparency = 0
	local touched = false
	local started = os.clock()

	while true do
		local t = os.clock() - started
		local pose, ballPos = sample(keys, math.min(t, duration))
		setPose(pose)
		if not touched and ballPos then
			ball.CFrame = base * CFrame.new(ballPos)
		end
		if not touched and t >= contact then
			touched = true
			ball.Transparency = 1 -- desde aquí lo muestra el balón del servidor
			if onContact then
				onContact()
			end
		end
		if chilena and root.Parent then
			local flipAlpha = math.clamp((t - FLIP_START) / (FLIP_END - FLIP_START), 0, 1)
			local lift = math.sin(flipAlpha * math.pi) * 3.5
			root.CFrame = base * CFrame.new(0, lift, 0) * CFrame.Angles(smooth(flipAlpha) * math.pi * 2, 0, 0)
		end
		if t >= duration then
			break
		end
		RunService.RenderStepped:Wait()
	end

	setPose(REST_POSE)
	if chilena and root.Parent then
		root.CFrame = base
	end
	playing = false
end

-- Al reaparecer, limpiamos todo
player.CharacterAdded:Connect(function()
	table.clear(originals)
	holding = false
	playing = false
	if heldBall then
		heldBall.Transparency = 1
	end
end)

return KickAnimation
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="17">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Interfaz del jugador: barra de poder, patada, cámara, revelación del futbolista,
-- plantilla, índice y tienda.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local KickAnimation = require(script.Parent:WaitForChild("KickAnimation"))
local Moves = require(script.Parent:WaitForChild("FootballerMoves"))
local FootballerLook = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("FootballerLook"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Assets = ReplicatedStorage:WaitForChild("Assets")
local KickEvent = Remotes:WaitForChild("Kick") :: RemoteEvent
local BallLaunchedEvent = Remotes:WaitForChild("BallLaunched") :: RemoteEvent
local KickResultEvent = Remotes:WaitForChild("KickResult") :: RemoteEvent
local AnnouncementEvent = Remotes:WaitForChild("Announcement") :: RemoteEvent
local DataUpdatedEvent = Remotes:WaitForChild("DataUpdated") :: RemoteEvent
local GetDataFunction = Remotes:WaitForChild("GetData") :: RemoteFunction
local PurchaseFunction = Remotes:WaitForChild("Purchase") :: RemoteFunction
local NotifyEvent = Remotes:WaitForChild("Notify") :: RemoteEvent
local KickStartEvent = Remotes:WaitForChild("KickStart") :: RemoteEvent
local SpaceKickEvent = Remotes:WaitForChild("SpaceKick") :: RemoteEvent
local AdminFunction = Remotes:WaitForChild("Admin") :: RemoteFunction
local StartTrainingFunction = Remotes:WaitForChild("StartTraining") :: RemoteFunction
local TrainEvent = Remotes:WaitForChild("Train") :: RemoteEvent
local StopTrainingEvent = Remotes:WaitForChild("StopTraining") :: RemoteEvent

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local data: any = nil
local coins = 0 -- se actualiza cada segundo desde leaderstats
local kicking = false -- true desde que pateas hasta que cierras la revelación
local inKickZone = false -- true cuando cruzaste la línea de patada
local awaitingKickStart = false -- pateaste y esperamos que empiece la animación
local trainingIndex: number? = nil -- estación del gimnasio donde estás entrenando
local cameraMode = "normal" -- "normal", "chase" (sigue al balón) o "reveal"
local flyingBall: BasePart? = nil
local needleValue = 0
local needleTime = 0
local NEEDLE_PERIOD = 0.75 -- segundos que tarda la barra en ir de abajo a arriba

-- ============================================================
-- Ayudantes de UI
-- ============================================================
local COLORS = {
	Panel = Color3.fromRGB(24, 28, 42),
	PanelLight = Color3.fromRGB(38, 44, 64),
	Green = Color3.fromRGB(60, 200, 90),
	GreenDark = Color3.fromRGB(35, 140, 60),
	Gold = Color3.fromRGB(255, 200, 50),
	Red = Color3.fromRGB(230, 70, 70),
	Gray = Color3.fromRGB(110, 115, 130),
	Blue = Color3.fromRGB(70, 130, 255),
	Text = Color3.new(1, 1, 1),
	Muted = Color3.fromRGB(185, 190, 205),
	Money = Color3.fromRGB(120, 255, 120),
}
local FONT = Enum.Font.FredokaOne

local function create(className: string, props: { [string]: any }, children: { Instance }?): any
	local obj = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			(obj :: any)[key] = value
		end
	end
	if children then
		for _, child in children do
			child.Parent = obj
		end
	end
	if props.Parent then
		obj.Parent = props.Parent
	end
	return obj
end

local function corner(radius: number?): UICorner
	return create("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

local function stroke(color: Color3, thickness: number?): UIStroke
	return create("UIStroke", {
		Color = color,
		Thickness = thickness or 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

local function textLabel(props: { [string]: any }): TextLabel
	local defaults: { [string]: any } = {
		BackgroundTransparency = 1,
		Font = FONT,
		TextColor3 = COLORS.Text,
		TextScaled = true,
		TextStrokeTransparency = 0.5,
	}
	for key, value in props do
		defaults[key] = value
	end
	return create("TextLabel", defaults)
end

local function button(props: { [string]: any }, color: Color3): TextButton
	local defaults: { [string]: any } = {
		BackgroundColor3 = color,
		Font = FONT,
		TextColor3 = COLORS.Text,
		TextScaled = true,
		TextStrokeTransparency = 0.5,
		AutoButtonColor = true,
	}
	for key, value in props do
		defaults[key] = value
	end
	return create("TextButton", defaults, {
		corner(10),
		create("UIGradient", {
			Rotation = 90,
			Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 190)),
		}),
		create("UIPadding", {
			PaddingTop = UDim.new(0, 5),
			PaddingBottom = UDim.new(0, 5),
			PaddingLeft = UDim.new(0, 6),
			PaddingRight = UDim.new(0, 6),
		}),
	})
end

local function popIn(guiObject: GuiObject)
	local scale = guiObject:FindFirstChildOfClass("UIScale") or create("UIScale", { Parent = guiObject })
	scale.Scale = 0.3
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

local gui = create("ScreenGui", {
	Name = "PateaElBalonUI",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})

-- Todo lo que se esconde durante el vuelo y la revelación
local hud = create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = gui })

-- ============================================================
-- Estadísticas (abajo a la izquierda)
-- ============================================================
local statsFrame = create("Frame", {
	AnchorPoint = Vector2.new(0, 1),
	Position = UDim2.new(0, 12, 1, -12),
	Size = UDim2.new(0, 190, 0, 112),
	BackgroundTransparency = 1,
	Parent = hud,
}, { create("UIListLayout", { Padding = UDim.new(0, 4) }) })

local function statLabel(order: number, color: Color3, height: number): TextLabel
	return textLabel({
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, height),
		Text = "...",
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextStrokeTransparency = 0,
		Parent = statsFrame,
	})
end
local powerStat = statLabel(1, Color3.fromRGB(120, 200, 255), 36)
local coinsStat = statLabel(2, COLORS.Money, 36)
local incomeStat = statLabel(3, COLORS.Muted, 26)

-- ============================================================
-- Barra de poder vertical + botón de patear (abajo al centro)
-- ============================================================
local kickArea = create("Frame", {
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -14),
	Size = UDim2.new(0, 260, 0, 320),
	BackgroundTransparency = 1,
	Parent = hud,
})

local barBack = create("Frame", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 0),
	Size = UDim2.new(0, 54, 0, 230),
	BackgroundColor3 = Color3.new(1, 1, 1),
	Parent = kickArea,
}, {
	corner(14),
	stroke(Color3.new(0, 0, 0), 3),
	create("UIGradient", {
		Rotation = 270, -- de abajo (rojo) hacia arriba (verde)
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(230, 60, 50)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(250, 210, 50)),
			ColorSequenceKeypoint.new(0.89, Color3.fromRGB(90, 220, 90)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(90, 220, 90)),
		}),
	}),
})
-- Zona "PERFECTO" arriba
create("Frame", {
	Size = UDim2.fromScale(1, 1 - Config.PERFECT_THRESHOLD),
	BackgroundColor3 = COLORS.Gold,
	Parent = barBack,
}, {
	corner(14),
	textLabel({ Size = UDim2.fromScale(1, 1), Text = "★" }),
})
local needle = create("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 1),
	Size = UDim2.new(1, 18, 0, 8),
	BackgroundColor3 = Color3.new(1, 1, 1),
	ZIndex = 3,
	Parent = barBack,
}, { corner(4), stroke(Color3.new(0, 0, 0), 2) })

local kickButton = button({
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, 0),
	Size = UDim2.new(1, 0, 0, 70),
	Text = "⚽ PATEAR (clic o F)",
	Parent = kickArea,
}, COLORS.Green)
stroke(COLORS.GreenDark, 3).Parent = kickButton
kickArea.Visible = false

local kickHint = textLabel({
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -24),
	Size = UDim2.new(0.6, 0, 0, 36),
	Text = "⚽ Cruza la línea blanca para patear",
	TextStrokeTransparency = 0,
	Parent = hud,
})
create("UISizeConstraint", { MaxSize = Vector2.new(520, 36), Parent = kickHint })

-- "+20 PODER" y "¡PERFECTO!"
local powerGainLabel = textLabel({
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.new(0.5, 150, 0.45, 0),
	Size = UDim2.new(0, 260, 0, 56),
	Text = "",
	TextColor3 = Color3.fromRGB(150, 255, 150),
	TextStrokeTransparency = 0,
	Visible = false,
	ZIndex = 5,
	Parent = gui,
})
local perfectLabel = textLabel({
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.new(0.5, 0, 0.62, 0),
	Size = UDim2.new(0, 360, 0, 64),
	Text = "¡PERFECTO!",
	TextColor3 = COLORS.Gold,
	TextStrokeTransparency = 0,
	Visible = false,
	ZIndex = 5,
	Parent = gui,
})

-- ============================================================
-- HUD de vuelo: suerte en grande, bioma y distancia
-- ============================================================
local flightHud = create("Frame", {
	Size = UDim2.fromScale(1, 1),
	BackgroundTransparency = 1,
	Visible = false,
	Parent = gui,
})
local luckBox = create("Frame", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 10),
	Size = UDim2.new(0, 300, 0, 90),
	BackgroundColor3 = Color3.fromRGB(255, 255, 255),
	BackgroundTransparency = 0.6,
	Parent = flightHud,
}, { corner(16) })
local luckLabel = textLabel({
	Size = UDim2.new(1, 0, 0.7, 0),
	Text = "x1",
	TextStrokeTransparency = 0,
	Parent = luckBox,
})
textLabel({
	Position = UDim2.fromScale(0, 0.68),
	Size = UDim2.new(1, 0, 0.28, 0),
	Text = "SUERTE",
	TextStrokeTransparency = 0,
	Parent = luckBox,
})
local biomeBanner = create("Frame", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 110),
	Size = UDim2.new(1, 0, 0, 50),
	BackgroundColor3 = Color3.new(0, 0, 0),
	BackgroundTransparency = 0.55,
	Parent = flightHud,
})
local biomeLabel = textLabel({
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.new(0, 400, 1, -8),
	Text = "",
	TextStrokeTransparency = 0,
	Parent = biomeBanner,
})
local distanceLabel = textLabel({
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 166),
	Size = UDim2.new(0, 360, 0, 30),
	Text = "",
	TextStrokeTransparency = 0,
	Parent = flightHud,
})

-- ============================================================
-- Mensajes cortos y anuncios
-- ============================================================
local toastLabel = textLabel({
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 60),
	Size = UDim2.new(0.8, 0, 0, 40),
	Text = "",
	Visible = false,
	TextStrokeTransparency = 0,
	ZIndex = 30,
	Parent = gui,
})
create("UISizeConstraint", { MaxSize = Vector2.new(560, 40), Parent = toastLabel })
local toastId = 0
local function toast(text: string, color: Color3?)
	toastId += 1
	local myId = toastId
	toastLabel.Text = text
	toastLabel.TextColor3 = color or COLORS.Text
	toastLabel.Visible = true
	popIn(toastLabel)
	task.delay(2.5, function()
		if toastId == myId then
			toastLabel.Visible = false
		end
	end)
end

local announcementLabel = textLabel({
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 104),
