          <string name="Source"><![CDATA[--!strict
-- ============================================================
--  CONFIGURACIÓN DEL JUEGO "PATEA EL BALÓN"
--  Aquí puedes cambiar zonas, suerte, balones, futbolistas y precios.
-- ============================================================

local Config = {}

-- ------------------------------------------------------------
-- CAMPO Y ZONAS
-- ------------------------------------------------------------
Config.NUM_ZONES = 30 -- cantidad de zonas
Config.ZONE_LENGTH = 100 -- largo de cada zona (en studs, lo mostramos como "metros")
Config.FIELD_WIDTH = 90 -- ancho del campo
Config.MAX_DISTANCE = Config.NUM_ZONES * Config.ZONE_LENGTH -- el balón no pasa del final

-- La suerte sube poco a poco mientras más lejos cae el balón:
-- 100 m = x1,25 · 1.000 m = x9,3 · 2.000 m = x87 · 3.000 m = x808
Config.LUCK_GROWTH = 1.25 -- cuánto se multiplica la suerte cada 100 m

function Config.GetLuckAtDistance(distance: number): number
	return Config.LUCK_GROWTH ^ (math.max(distance, 0) / Config.ZONE_LENGTH)
end

-- Suerte al inicio de una zona (para los carteles)
function Config.GetLuck(zone: number): number
	return Config.GetLuckAtDistance((zone - 1) * Config.ZONE_LENGTH)
end

function Config.GetZoneFromDistance(distance: number): number
	return math.clamp(math.floor(distance / Config.ZONE_LENGTH) + 1, 1, Config.NUM_ZONES)
end

-- ------------------------------------------------------------
-- ZONAS: cada una tiene su propio escenario a los lados, y va mejorando:
-- barrios -> ciudad -> playa -> estadios -> lujo -> leyenda
-- Scene = qué se construye a los lados (ver server/Scenery.luau). Level = variante.
-- ------------------------------------------------------------
export type ZoneInfo = {
	Name: string,
	Emoji: string,
	Field: Color3,
	FieldAlt: Color3,
	Lot: Color3,
	Scene: string,
	Level: number?,
}

local rgb = Color3.fromRGB
Config.Zones = {
	-- Barrios
	{ Name = "Barrio de tierra", Emoji = "🏚️", Field = rgb(150, 190, 80), FieldAlt = rgb(135, 175, 70), Lot = rgb(175, 135, 95), Scene = "Chozas" },
	{ Name = "Barrio humilde", Emoji = "🧱", Field = rgb(125, 200, 80), FieldAlt = rgb(110, 185, 70), Lot = rgb(165, 150, 120), Scene = "Casitas", Level = 1 },
	{ Name = "Barrio colorido", Emoji = "🎨", Field = rgb(110, 210, 80), FieldAlt = rgb(95, 195, 70), Lot = rgb(175, 175, 165), Scene = "Casitas", Level = 2 },
	{ Name = "Barrio con canchita", Emoji = "⚽", Field = rgb(105, 215, 75), FieldAlt = rgb(90, 200, 65), Lot = rgb(160, 160, 150), Scene = "Canchita" },
	{ Name = "Colonia", Emoji = "🏡", Field = rgb(100, 220, 80), FieldAlt = rgb(85, 205, 70), Lot = rgb(120, 205, 90), Scene = "Colonia" },
	-- Ciudad
	{ Name = "Calle comercial", Emoji = "🛍️", Field = rgb(95, 210, 90), FieldAlt = rgb(80, 195, 80), Lot = rgb(180, 180, 185), Scene = "Tiendas" },
	{ Name = "Avenida", Emoji = "🚗", Field = rgb(90, 205, 95), FieldAlt = rgb(75, 190, 85), Lot = rgb(160, 160, 168), Scene = "Edificios", Level = 1 },
	{ Name = "Parque de la ciudad", Emoji = "🌳", Field = rgb(85, 215, 85), FieldAlt = rgb(70, 200, 75), Lot = rgb(105, 200, 85), Scene = "Parque" },
	{ Name = "Centro", Emoji = "🏙️", Field = rgb(90, 200, 100), FieldAlt = rgb(75, 185, 90), Lot = rgb(145, 145, 155), Scene = "Edificios", Level = 2 },
	{ Name = "Rascacielos", Emoji = "🌆", Field = rgb(95, 195, 110), FieldAlt = rgb(80, 180, 100), Lot = rgb(125, 130, 145), Scene = "Rascacielos" },
	-- Playa
	{ Name = "Playa", Emoji = "🏖️", Field = rgb(240, 220, 150), FieldAlt = rgb(230, 205, 135), Lot = rgb(245, 225, 160), Scene = "Playa" },
	{ Name = "Malecón", Emoji = "🌴", Field = rgb(235, 215, 150), FieldAlt = rgb(225, 200, 135), Lot = rgb(240, 220, 165), Scene = "Malecon" },
	{ Name = "Zona de hoteles", Emoji = "🏨", Field = rgb(110, 215, 120), FieldAlt = rgb(95, 200, 110), Lot = rgb(240, 228, 180), Scene = "Hoteles" },
	{ Name = "Puerto de yates", Emoji = "⛵", Field = rgb(100, 210, 140), FieldAlt = rgb(85, 195, 130), Lot = rgb(200, 190, 170), Scene = "Puerto" },
	{ Name = "Resort de lujo", Emoji = "🍹", Field = rgb(95, 220, 130), FieldAlt = rgb(80, 205, 120), Lot = rgb(245, 235, 200), Scene = "Resort" },
	-- Fútbol
	{ Name = "Escuela de fútbol", Emoji = "🎽", Field = rgb(80, 200, 80), FieldAlt = rgb(65, 180, 65), Lot = rgb(95, 190, 80), Scene = "Escuela" },
	{ Name = "Estadio de barrio", Emoji = "🏟️", Field = rgb(75, 200, 75), FieldAlt = rgb(60, 180, 60), Lot = rgb(120, 120, 128), Scene = "Gradas", Level = 1 },
	{ Name = "Estadio de ciudad", Emoji = "🏟️", Field = rgb(70, 205, 70), FieldAlt = rgb(55, 185, 55), Lot = rgb(110, 110, 120), Scene = "Gradas", Level = 2 },
	{ Name = "Estadio profesional", Emoji = "🏟️", Field = rgb(65, 210, 70), FieldAlt = rgb(50, 190, 55), Lot = rgb(100, 100, 112), Scene = "Gradas", Level = 3 },
	{ Name = "Gran estadio", Emoji = "🏆", Field = rgb(60, 215, 70), FieldAlt = rgb(45, 195, 55), Lot = rgb(90, 90, 105), Scene = "Gradas", Level = 4 },
	-- Lujo
	{ Name = "Mansiones", Emoji = "🏛️", Field = rgb(100, 220, 100), FieldAlt = rgb(85, 205, 85), Lot = rgb(130, 210, 110), Scene = "Mansiones" },
	{ Name = "Autos de lujo", Emoji = "🏎️", Field = rgb(90, 210, 110), FieldAlt = rgb(75, 195, 95), Lot = rgb(70, 70, 82), Scene = "Autos" },
	{ Name = "Castillos", Emoji = "🏰", Field = rgb(110, 200, 90), FieldAlt = rgb(95, 185, 80), Lot = rgb(150, 150, 140), Scene = "Castillo" },
	{ Name = "Ciudad dorada", Emoji = "✨", Field = rgb(235, 205, 95), FieldAlt = rgb(220, 190, 80), Lot = rgb(245, 220, 130), Scene = "Edificios", Level = 3 },
	{ Name = "Salón de trofeos", Emoji = "🏆", Field = rgb(240, 190, 60), FieldAlt = rgb(225, 175, 50), Lot = rgb(130, 40, 55), Scene = "Trofeos" },
	-- Leyenda
	{ Name = "Sobre las nubes", Emoji = "☁️", Field = rgb(200, 230, 255), FieldAlt = rgb(185, 215, 245), Lot = rgb(240, 248, 255), Scene = "Nubes" },
	{ Name = "Arcoíris", Emoji = "🌈", Field = rgb(255, 185, 220), FieldAlt = rgb(240, 170, 205), Lot = rgb(225, 240, 255), Scene = "Arcoiris" },
	{ Name = "La Luna", Emoji = "🌙", Field = rgb(175, 175, 185), FieldAlt = rgb(155, 155, 165), Lot = rgb(130, 130, 140), Scene = "Luna" },
	{ Name = "Galaxia", Emoji = "🪐", Field = rgb(80, 60, 135), FieldAlt = rgb(65, 50, 115), Lot = rgb(35, 25, 60), Scene = "Galaxia" },
	{ Name = "Salón de la Fama", Emoji = "👑", Field = rgb(255, 210, 80), FieldAlt = rgb(240, 195, 65), Lot = rgb(60, 30, 80), Scene = "Fama" },
} :: { ZoneInfo }

function Config.GetZoneInfo(zone: number): ZoneInfo
	return Config.Zones[math.clamp(zone, 1, #Config.Zones)]
end

function Config.GetZoneColor(zone: number, alternate: boolean?): Color3
	local info = Config.GetZoneInfo(zone)
	return if alternate then info.FieldAlt else info.Field
end

-- ------------------------------------------------------------
-- PATADA Y PODER
-- El poder se entrena pateando. Distancia = (BASE + Poder * POR_PODER) * balón * barra
-- ------------------------------------------------------------
Config.START_POWER = 10
Config.BASE_DISTANCE = 60
Config.DISTANCE_PER_POWER = 0.012
Config.PERFECT_THRESHOLD = 0.9 -- si la barra está arriba de 90% es "¡PERFECTO!"
Config.PERFECT_BONUS = 1.15 -- la patada perfecta va 15% más lejos
Config.PERFECT_POWER_MULTIPLIER = 2 -- y te da el doble de poder
Config.MIN_TIMING = 0.2 -- lo mínimo que cuenta la barra

-- Poder que ganas en una patada según la barra (de 1 a 10)
function Config.GetPowerGain(timing: number): number
	local gain = math.floor(1 + 4 * timing + 0.5)
	if timing >= Config.PERFECT_THRESHOLD then
		gain *= Config.PERFECT_POWER_MULTIPLIER
	end
	return gain
end

-- Línea de patada: al cruzarla aparece la barra de poder
Config.KICK_LINE_Z = -14 -- donde está la línea blanca
Config.KICK_ZONE_HALF_WIDTH = 14 -- ancho de la zona de patada (desde el centro)
Config.RETURN_POSITION = Vector3.new(0, 3, -26) -- a donde vuelves después de patear

function Config.IsInKickZone(position: Vector3): boolean
	return math.abs(position.X) <= Config.KICK_ZONE_HALF_WIDTH
		and position.Z >= Config.KICK_LINE_Z
		and position.Z <= 6
		and position.Y < 20
end

-- Animación de patada: el jugador se para aquí con el balón en las manos
Config.KICK_STAND = Vector3.new(0, 3, -2.4)
Config.KICK_ORIGIN = Vector3.new(0, 1.5, 0) -- de donde sale el balón
Config.KICK_CONTACT_TIME = 0.33 -- segundos hasta que el pie toca el balón
Config.KICK_ANIMATION_TIME = 0.75

-- Chilena: a veces el jugador hace una chilena (va más lejos y da más poder)
Config.CHILENA_CHANCE = 0.05 -- 5%
Config.CHILENA_BONUS = 1.25 -- 25% más lejos
Config.CHILENA_ORIGIN = Vector3.new(0, 6.5, -1.6)
Config.CHILENA_CONTACT_TIME = 0.62
Config.CHILENA_ANIMATION_TIME = 1.3

-- ------------------------------------------------------------
-- ESPACIO: si tu patada llegaría muy lejos, el balón sube al espacio,
-- rompe todos los planetas y cae al final con suerte extra.
-- ------------------------------------------------------------
Config.SPACE_DISTANCE = 4000 -- metros que tendría que llegar tu patada
Config.SPACE_APEX = 900 -- altura máxima del balón
Config.SPACE_LUCK_BONUS = 3 -- suerte x3
Config.SPACE_COINS_BONUS = 3 -- monedas x3
Config.SPACE_PLANET_STOPS = { 0.3, 0.4, 0.5, 0.6, 0.7 } -- en qué parte del vuelo están los planetas

-- Velocidad vertical, velocidad hacia adelante y duración del vuelo al espacio
function Config.GetSpaceFlight(gravity: number): (number, number, number)
	local vy = math.sqrt(2 * gravity * Config.SPACE_APEX)
	local duration = 2 * vy / gravity
	return vy, Config.MAX_DISTANCE / duration, duration
end

-- Dónde está el balón en el vuelo al espacio (alpha = 0 al patear, 1 al caer)
function Config.GetSpacePoint(alpha: number, gravity: number): Vector3
	local vy, vz, duration = Config.GetSpaceFlight(gravity)
	local t = alpha * duration
	return Config.KICK_ORIGIN + Vector3.new(0, vy * t - gravity * t * t / 2, vz * t)
end

-- ------------------------------------------------------------
-- ADMINISTRADOR
-- El dueño del juego (quien lo publicó) es OWNER automáticamente, y en Studio
-- todos los que prueban son OWNER. Para agregar a alguien más, pon su UserId aquí.
-- ------------------------------------------------------------
Config.OWNER_USER_IDS = {} :: { number }

-- ------------------------------------------------------------
-- GIMNASIO: estaciones para entrenar las piernas
-- Cada repetición da `Gain` de poder. Necesitas `Required` de poder para usarla.
-- ------------------------------------------------------------
export type Station = { Name: string, Gain: number, Required: number, Equipment: string }

Config.TRAIN_COOLDOWN = 0.8 -- segundos entre repeticiones
Config.TrainingStations = {
	{ Name = "Mancuernas", Gain = 1, Required = 0, Equipment = "Mancuernas" },
	{ Name = "Sentadillas", Gain = 2, Required = 200, Equipment = "Barra" },
	{ Name = "Prensa de piernas", Gain = 3, Required = 800, Equipment = "Prensa" },
	{ Name = "Saco de patadas", Gain = 5, Required = 2000, Equipment = "Saco" },
	{ Name = "Llantas gigantes", Gain = 8, Required = 4000, Equipment = "Llantas" },
	{ Name = "Máquina dorada", Gain = 12, Required = 7000, Equipment = "Dorada" },
} :: { Station }

-- ------------------------------------------------------------
-- BALONES DE LA TIENDA (se compran en orden)
-- ------------------------------------------------------------
export type Ball = {
	Name: string,
	Price: number,
	Multiplier: number,
	Color: Color3,
	Material: Enum.Material,
}

Config.Balls = {
	{ Name = "Balón de Trapo", Price = 0, Multiplier = 1, Color = Color3.fromRGB(196, 170, 130), Material = Enum.Material.Fabric },
	{ Name = "Balón de Plástico", Price = 450, Multiplier = 1.3, Color = Color3.fromRGB(255, 255, 255), Material = Enum.Material.SmoothPlastic },
	{ Name = "Balón de Cuero", Price = 1800, Multiplier = 1.6, Color = Color3.fromRGB(140, 85, 50), Material = Enum.Material.Leather },
	{ Name = "Balón Clásico", Price = 5700, Multiplier = 2, Color = Color3.fromRGB(240, 240, 240), Material = Enum.Material.Plastic },
	{ Name = "Balón de Fuego", Price = 15000, Multiplier = 2.5, Color = Color3.fromRGB(255, 110, 30), Material = Enum.Material.Neon },
	{ Name = "Balón de Hielo", Price = 40000, Multiplier = 3, Color = Color3.fromRGB(150, 220, 255), Material = Enum.Material.Ice },
	{ Name = "Balón Eléctrico", Price = 100000, Multiplier = 3.6, Color = Color3.fromRGB(255, 240, 60), Material = Enum.Material.Neon },
	{ Name = "Balón de Esmeralda", Price = 225000, Multiplier = 4.3, Color = Color3.fromRGB(40, 200, 110), Material = Enum.Material.Glass },
	{ Name = "Balón de Rubí", Price = 500000, Multiplier = 5, Color = Color3.fromRGB(220, 30, 60), Material = Enum.Material.Glass },
	{ Name = "Balón de Diamante", Price = 1100000, Multiplier = 6, Color = Color3.fromRGB(190, 245, 255), Material = Enum.Material.Glass },
	{ Name = "Balón Dorado", Price = 2250000, Multiplier = 7, Color = Color3.fromRGB(255, 200, 40), Material = Enum.Material.Foil },
	{ Name = "Balón Galáctico", Price = 5000000, Multiplier = 8, Color = Color3.fromRGB(150, 70, 255), Material = Enum.Material.Neon },
} :: { Ball }

-- Distancia máxima (con la barra al 100%) para un poder y un balón
function Config.GetKickDistance(power: number, ballTier: number): number
	local ball = Config.Balls[ballTier] or Config.Balls[1]
	return (Config.BASE_DISTANCE + power * Config.DISTANCE_PER_POWER) * ball.Multiplier
end

-- ------------------------------------------------------------
-- MONEDAS Y PLANTILLA
-- Los futbolistas de tu plantilla te dan monedas cada segundo.
-- ------------------------------------------------------------
function Config.GetCoinsForKick(distance: number): number
	return math.floor(distance / 10)
end

Config.START_SLOTS = 8 -- espacios iniciales en la plantilla
Config.MAX_SLOTS = 40
Config.SELL_SECONDS = 30 -- vender a un futbolista da lo que gana en 30 segundos

-- Costo para pasar de `slots` espacios a `slots + 1`
function Config.GetSlotCost(slots: number): number
	return math.floor(500 * 1.8 ^ (slots - Config.START_SLOTS))
end

-- ------------------------------------------------------------
-- RAREZAS Y FUTBOLISTAS
-- Chance = "1 en X". Mientras más grande, más difícil.
-- La suerte divide la dificultad: con suerte x10, "1 en 1.000" se vuelve "1 en 100".
-- ------------------------------------------------------------
export type Rarity = { Name: string, Color: Color3, Order: number }

Config.Rarities = {
	Comun = { Name = "Común", Color = Color3.fromRGB(205, 205, 205), Order = 1 },
	PocoComun = { Name = "Poco común", Color = Color3.fromRGB(85, 220, 110), Order = 2 },
	Raro = { Name = "Raro", Color = Color3.fromRGB(70, 150, 255), Order = 3 },
	Epico = { Name = "Épico", Color = Color3.fromRGB(175, 90, 255), Order = 4 },
	Legendario = { Name = "Legendario", Color = Color3.fromRGB(255, 190, 40), Order = 5 },
	Mitico = { Name = "Mítico", Color = Color3.fromRGB(255, 70, 70), Order = 6 },
	Secreto = { Name = "Secreto", Color = Color3.fromRGB(255, 90, 210), Order = 7 },
} :: { [string]: Rarity }

export type Footballer = {
	Id: string,
	Name: string,
	Chance: number,
	Rarity: string,
	Income: number, -- monedas por segundo
	Number: number?, -- número de la camiseta
	Hair: string?, -- "Corto", "Largo", "Cresta" o "Rapado"
	HairColor: Color3?,
	Shirt: Color3,
	Shorts: Color3,
}

-- El primero (Chance = 1) es el que sale si no te toca ninguno más raro.
Config.Footballers = {
	{ Id = "canterano", Name = "Canterano", Chance = 1, Rarity = "Comun", Income = 1, Shirt = Color3.fromRGB(230, 230, 230), Shorts = Color3.fromRGB(40, 40, 40) },
	{ Id = "gavi", Name = "Gavi", Chance = 4, Rarity = "Comun", Income = 3, Shirt = Color3.fromRGB(165, 0, 68), Shorts = Color3.fromRGB(0, 77, 152) },
	{ Id = "kounde", Name = "Koundé", Chance = 6, Rarity = "Comun", Income = 4, Shirt = Color3.fromRGB(165, 0, 68), Shorts = Color3.fromRGB(0, 77, 152) },
	{ Id = "valverde", Name = "Fede Valverde", Chance = 10, Rarity = "PocoComun", Income = 5, Shirt = Color3.fromRGB(250, 250, 250), Shorts = Color3.fromRGB(250, 250, 250) },
	{ Id = "rodri", Name = "Rodri", Chance = 15, Rarity = "PocoComun", Income = 7, Shirt = Color3.fromRGB(108, 171, 221), Shorts = Color3.fromRGB(250, 250, 250) },
	{ Id = "pedri", Name = "Pedri", Chance = 25, Rarity = "Raro", Income = 10, Shirt = Color3.fromRGB(165, 0, 68), Shorts = Color3.fromRGB(0, 77, 152) },
	{ Id = "rodrygo", Name = "Rodrygo", Chance = 40, Rarity = "Raro", Income = 13, Shirt = Color3.fromRGB(250, 250, 250), Shorts = Color3.fromRGB(250, 250, 250) },
	{ Id = "saka", Name = "Saka", Chance = 60, Rarity = "Raro", Income = 18, Shirt = Color3.fromRGB(220, 0, 0), Shorts = Color3.fromRGB(250, 250, 250) },
	{ Id = "musiala", Name = "Musiala", Chance = 150, Rarity = "Epico", Income = 33, Shirt = Color3.fromRGB(220, 5, 45), Shorts = Color3.fromRGB(220, 5, 45) },
	{ Id = "wirtz", Name = "Wirtz", Chance = 250, Rarity = "Epico", Income = 48, Shirt = Color3.fromRGB(200, 16, 46), Shorts = Color3.fromRGB(250, 250, 250) },
	{ Id = "yamal", Name = "Lamine Yamal", Chance = 500, Rarity = "Epico", Income = 78, Shirt = Color3.fromRGB(165, 0, 68), Shorts = Color3.fromRGB(0, 77, 152) },
	{ Id = "bellingham", Name = "Bellingham", Chance = 1000, Rarity = "Legendario", Income = 126, Shirt = Color3.fromRGB(250, 250, 250), Shorts = Color3.fromRGB(250, 250, 250) },
	{ Id = "vinicius", Name = "Vinícius Jr", Chance = 2500, Rarity = "Legendario", Income = 238, Shirt = Color3.fromRGB(250, 250, 250), Shorts = Color3.fromRGB(250, 250, 250) },
	{ Id = "salah", Name = "Salah", Chance = 5000, Rarity = "Legendario", Income = 387, Shirt = Color3.fromRGB(200, 16, 46), Shorts = Color3.fromRGB(200, 16, 46) },
	{ Id = "mbappe", Name = "Mbappé", Chance = 15000, Rarity = "Mitico", Income = 834, Shirt = Color3.fromRGB(250, 250, 250), Shorts = Color3.fromRGB(250, 250, 250) },
	{ Id = "haaland", Name = "Haaland", Chance = 40000, Rarity = "Mitico", Income = 1650, Shirt = Color3.fromRGB(108, 171, 221), Shorts = Color3.fromRGB(250, 250, 250) },
	{ Id = "messi", Name = "Messi", Chance = 250000, Rarity = "Secreto", Income = 6000, Shirt = Color3.fromRGB(245, 140, 170), Shorts = Color3.fromRGB(20, 20, 20) },
	{ Id = "cristiano", Name = "Cristiano Ronaldo", Chance = 1000000, Rarity = "Secreto", Income = 15000, Shirt = Color3.fromRGB(20, 120, 60), Shorts = Color3.fromRGB(250, 250, 250) },
} :: { Footballer }

-- Número de camiseta y peinado de cada futbolista
local BROWN, BLACK, BLONDE, LIGHT_BROWN = rgb(70, 45, 30), rgb(30, 25, 25), rgb(235, 205, 115), rgb(130, 85, 50)
local looks = {
	canterano = { 22, "Corto", LIGHT_BROWN },
	gavi = { 6, "Corto", BLACK },
	kounde = { 23, "Rapado", BLACK },
	valverde = { 8, "Corto", BROWN },
	rodri = { 16, "Corto", BROWN },
	pedri = { 8, "Corto", BLACK },
	rodrygo = { 11, "Corto", BLACK },
	saka = { 7, "Rapado", BLACK },
	musiala = { 10, "Corto", BROWN },
	wirtz = { 10, "Corto", LIGHT_BROWN },
	yamal = { 19, "Cresta", BLACK },
	bellingham = { 5, "Rapado", BLACK },
	vinicius = { 7, "Largo", BLACK },
	salah = { 11, "Largo", BLACK },
	mbappe = { 10, "Rapado", BLACK },
	haaland = { 9, "Largo", BLONDE },
	messi = { 10, "Corto", BROWN },
	cristiano = { 7, "Cresta", BROWN },
}
for _, f in Config.Footballers do
	local look = looks[f.Id]
	f.Number = f.Number or (if look then look[1] else 10)
	f.Hair = f.Hair or (if look then look[2] else "Corto")
	f.HairColor = f.HairColor or (if look then look[3] else BROWN)
end

-- Lista ordenada del más raro al más común (para el sorteo)
local rarestFirst = table.clone(Config.Footballers)
table.sort(rarestFirst, function(a, b)
	return a.Chance > b.Chance
end)

local footballersById: { [string]: Footballer } = {}
for _, f in Config.Footballers do
	footballersById[f.Id] = f
end

function Config.GetFootballer(id: string): Footballer?
	return footballersById[id]
end

-- Sortea un futbolista con la suerte dada.
-- Se prueba del más raro al más común: probabilidad = suerte / X.
function Config.RollFootballer(luck: number, rng: Random): Footballer
	for _, f in rarestFirst do
		if f.Chance > 1 and rng:NextNumber() < luck / f.Chance then
			return f
		end
	end
	return rarestFirst[#rarestFirst]
end

function Config.GetSellPrice(f: Footballer): number
	return f.Income * Config.SELL_SECONDS
end

-- Colores del muñeco de cada futbolista (piel amarilla clásica de Roblox)
Config.SKIN_COLOR = Color3.fromRGB(245, 205, 48)
Config.BOOTS_COLOR = Color3.fromRGB(25, 25, 25)

function Config.GetPartColor(partName: string, f: Footballer): Color3
	if partName == "Head" or partName:find("LowerArm") or partName:find("Hand") then
		return Config.SKIN_COLOR
	elseif partName:find("Foot") then
		return Config.BOOTS_COLOR
	elseif partName:find("UpperLeg") or partName == "LowerTorso" then
		return f.Shorts
	end
	return f.Shirt -- torso, brazos y medias
end

-- ------------------------------------------------------------
-- UTILIDADES
-- ------------------------------------------------------------
-- 1234567 -> "1.234.567"
function Config.FormatNumber(n: number): string
	local value = math.floor(math.abs(n))
	local s = tostring(value):reverse():gsub("(%d%d%d)", "%1.")
	local formatted = s:reverse()
	if formatted:sub(1, 1) == "." then
		formatted = formatted:sub(2)
	end
	return (if n < 0 then "-" else "") .. formatted
end

-- 155000 -> "155K", 1250000 -> "1,25M"
local SUFFIXES = { "K", "M", "B", "T", "Qa", "Qi" }
function Config.FormatShort(n: number): string
	local value = math.abs(n)
	if value < 1000 then
		return (if n < 0 then "-" else "") .. tostring(math.floor(value))
	end
	local index = 0
	while value >= 1000 and index < #SUFFIXES do
		value /= 1000
		index += 1
	end
	local text
	if value >= 100 then
		text = tostring(math.floor(value))
	else
		text = string.format("%.2f", value)
		text = text:gsub("%.?0+$", "")
		text = text:gsub("%.", ",")
	end
	return (if n < 0 then "-" else "") .. text .. SUFFIXES[index]
end

-- Para números de suerte: 2.07 -> "2,07", 14.5 -> "14,5", 646 -> "646"
function Config.FormatLuck(luck: number): string
	if luck >= 100 then
		return Config.FormatNumber(luck)
	end
	local text = string.format(if luck < 10 then "%.2f" else "%.1f", luck)
	text = text:gsub("%.?0+$", "")
	text = text:gsub("%.", ",")
	return text
end

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">FootballerLook</string>
          <string name="Source"><![CDATA[-- Viste a un futbolista: colores del uniforme, pelo, número y nombre en la camiseta,
-- tenis según la rareza y un aura para los más raros.
-- Lo usan el servidor (corrales) y el cliente (revelación).
local Config = require(script.Parent.Config)

local FootballerLook = {}

local ACCENTS = { ["á"] = "Á", ["é"] = "É", ["í"] = "Í", ["ó"] = "Ó", ["ú"] = "Ú", ["ñ"] = "Ñ", ["ü"] = "Ü" }
function FootballerLook.Upper(text: string): string
	local upper = string.upper(text)
	for lower, capital in ACCENTS do
		upper = upper:gsub(lower, capital)
	end
	return upper
end

local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 70, 70)),
	ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 220, 60)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(80, 220, 90)),
	ColorSequenceKeypoint.new(0.75, Color3.fromRGB(70, 160, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 90, 255)),
})

-- Pieza pegada (con soldadura) a una parte del cuerpo
local function attach(model: Model, to: BasePart, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?): Part
	local part = Instance.new("Part")
	part.Name = "Detalle"
	part.Size = size
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.Anchored = false
	part.CFrame = to.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = to
	weld.Part1 = part
	weld.Parent = part
	part.Parent = model
	return part
end

local function addHair(model: Model, head: BasePart, style: string, color: Color3)
	local s = head.Size
	if style == "Rapado" then
		attach(model, head, Vector3.new(s.X * 1.02, 0.12, s.Z * 1.02), CFrame.new(0, s.Y * 0.48, 0), color)
		return
	end
	if style == "Cresta" then
		attach(model, head, Vector3.new(s.X * 1.02, 0.12, s.Z * 1.02), CFrame.new(0, s.Y * 0.48, 0), color)
		attach(model, head, Vector3.new(s.X * 0.28, s.Y * 0.4, s.Z * 0.95), CFrame.new(0, s.Y * 0.62, 0.05), color)
		return
	end
	-- Corto y Largo: casquete arriba + parte de atrás
	attach(model, head, Vector3.new(s.X * 1.1, s.Y * 0.3, s.Z * 1.1), CFrame.new(0, s.Y * 0.43, 0.04), color)
	if style == "Largo" then
		attach(model, head, Vector3.new(s.X * 1.1, s.Y * 0.95, s.Z * 0.28), CFrame.new(0, -0.05, s.Z * 0.5), color)
		for _, x in { -1, 1 } do
			attach(model, head, Vector3.new(s.X * 0.16, s.Y * 0.7, s.Z * 0.8), CFrame.new(x * s.X * 0.52, 0.05, s.Z * 0.1), color)
		end
	else
		attach(model, head, Vector3.new(s.X * 1.06, s.Y * 0.5, s.Z * 0.2), CFrame.new(0, s.Y * 0.15, s.Z * 0.48), color)
	end
end

local function addShirtText(torso: BasePart, f: Config.Footballer)
	local shirt = f.Shirt
	local brightness = shirt.R * 0.299 + shirt.G * 0.587 + shirt.B * 0.114
	local textColor = if brightness > 0.6 then Color3.fromRGB(25, 25, 35) else Color3.new(1, 1, 1)

	local function surface(face: Enum.NormalId): SurfaceGui
		local gui = Instance.new("SurfaceGui")
		gui.Name = "Camiseta" .. face.Name
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 60
		gui.LightInfluence = 1
		gui.Parent = torso
		return gui
	end
	local function label(parent: Instance, text: string, size: UDim2, position: UDim2)
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Size = size
		l.Position = position
		l.Font = Enum.Font.FredokaOne
		l.TextScaled = true
		l.TextColor3 = textColor
		l.Text = text
		l.Parent = parent
	end

	-- Atrás: nombre y número grande
	local back = surface(Enum.NormalId.Back)
	local words = string.split(f.Name, " ")
	label(back, FootballerLook.Upper(words[#words]), UDim2.fromScale(0.9, 0.22), UDim2.fromScale(0.05, 0.08))
	label(back, tostring(f.Number), UDim2.fromScale(0.8, 0.62), UDim2.fromScale(0.1, 0.3))
	-- Adelante: número chico
	local front = surface(Enum.NormalId.Front)
	label(front, tostring(f.Number), UDim2.fromScale(0.3, 0.3), UDim2.fromScale(0.35, 0.2))
end

function FootballerLook.Dress(model: Model, f: Config.Footballer)
	local rarity = Config.Rarities[f.Rarity]
	local bootColor = if rarity.Order >= Config.Rarities.Legendario.Order
		then Color3.fromRGB(255, 200, 50)
		elseif rarity.Order >= Config.Rarities.Raro.Order then rarity.Color
		else Config.BOOTS_COLOR

	for _, obj in model:GetDescendants() do
		if obj:IsA("BasePart") and obj.Name ~= "HumanoidRootPart" then
			obj.Color = if obj.Name:find("Foot") then bootColor else Config.GetPartColor(obj.Name, f)
		end
	end

	local head = model:FindFirstChild("Head") :: BasePart?
	local torso = model:FindFirstChild("UpperTorso") :: BasePart?
	if head then
		addHair(model, head, f.Hair or "Corto", f.HairColor or Color3.fromRGB(70, 45, 30))
	end
	if torso then
		addShirtText(torso, f)
	end

	-- Espinilleras blancas
	for _, name in { "LeftLowerLeg", "RightLowerLeg" } do
		local leg = model:FindFirstChild(name) :: BasePart?
		if leg then
			attach(model, leg, Vector3.new(leg.Size.X * 0.7, leg.Size.Y * 0.45, 0.12), CFrame.new(0, 0.05, -leg.Size.Z / 2 - 0.02), Color3.new(1, 1, 1))
		end
	end

	-- Aura según la rareza
	local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
	if root and rarity.Order >= Config.Rarities.Epico.Order then
		local sparkles = Instance.new("ParticleEmitter")
		sparkles.Name = "Aura"
		sparkles.Color = if rarity.Order >= Config.Rarities.Secreto.Order then RAINBOW else ColorSequence.new(rarity.Color)
		sparkles.LightEmission = 1
		sparkles.Size = NumberSequence.new(0.5, 0)
		sparkles.Lifetime = NumberRange.new(0.8, 1.4)
		sparkles.Rate = if rarity.Order >= Config.Rarities.Mitico.Order then 18 else 8
		sparkles.Speed = NumberRange.new(1, 3)
		sparkles.SpreadAngle = Vector2.new(180, 180)
		sparkles.Parent = root
	end
	if root and rarity.Order >= Config.Rarities.Legendario.Order then
		local light = Instance.new("PointLight")
		light.Color = rarity.Color
		light.Range = 9
		light.Brightness = 1.3
		light.Parent = root
	end
	-- Corona para los Secretos
	if head and rarity.Order >= Config.Rarities.Secreto.Order then
		local s = head.Size
		attach(model, head, Vector3.new(s.X * 1.15, 0.25, s.Z * 1.15), CFrame.new(0, s.Y * 0.72, 0), Color3.fromRGB(255, 200, 50), Enum.Material.Foil)
		for _, corner in { Vector3.new(-1, 0, -1), Vector3.new(1, 0, -1), Vector3.new(-1, 0, 1), Vector3.new(1, 0, 1) } do
			attach(model, head, Vector3.new(0.22, 0.4, 0.22), CFrame.new(corner.X * s.X * 0.5, s.Y * 0.9, corner.Z * s.Z * 0.5), Color3.fromRGB(255, 200, 50), Enum.Material.Foil)
		end
	end
end

return FootballerLook
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="5">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="6">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">DataManager</string>
          <string name="Source"><![CDATA[-- Guarda y carga los datos de cada jugador (monedas, fuerza, balón, colección).
-- En Studio: Home > Game Settings > Security > "Enable Studio Access to API Services"
-- para que se guarde mientras pruebas.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)

local STORE_NAME = "PateaElBalon_v1"
local AUTOSAVE_SECONDS = 120

export type PlayerData = {
	Coins: number,
	Power: number,
	BallTier: number,
	BestDistance: number,
	TotalKicks: number,
	Collection: { [string]: number }, -- cuántas veces te salió cada futbolista (Índice)
	Squad: { string }, -- ids de los futbolistas en tu plantilla
	Slots: number, -- espacios de la plantilla
	Unclaimed: number, -- dinero esperando en el plato del corral
}

local function defaultData(): PlayerData
	return {
		Coins = 0,
		Power = Config.START_POWER,
		BallTier = 1,
		BestDistance = 0,
		TotalKicks = 0,
		Collection = {},
		Squad = {},
		Slots = Config.START_SLOTS,
		Unclaimed = 0,
	}
end

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[Datos] DataStore no disponible, no se guardará el progreso:", result)
	end
end

local DataManager = {}

local profiles: { [Player]: PlayerData } = {}
-- Si la carga falló, NO guardamos para no borrar el progreso real del jugador
local canSave: { [Player]: boolean } = {}

local function keyFor(player: Player): string
	return "jugador_" .. player.UserId
end

-- Completa campos que falten (por si agregas cosas nuevas en el futuro)
local function reconcile(saved: any): PlayerData
	local data = defaultData()
	if type(saved) == "table" then
		for key, value in saved do
			if (data :: any)[key] ~= nil and type(value) == type((data :: any)[key]) then
				(data :: any)[key] = value
			end
		end
	end
	-- Quitamos futbolistas que ya no existan en Config (por si cambiaste la lista)
	local squad = {}
	for _, id in data.Squad do
		if Config.GetFootballer(id) and #squad < data.Slots then
			table.insert(squad, id)
		end
	end
	data.Squad = squad
	data.BallTier = math.clamp(data.BallTier, 1, #Config.Balls)
	return data
end

function DataManager.Load(player: Player): PlayerData
	local saved = nil
	local loaded = store == nil -- sin DataStore no hay nada que perder
	if store then
		-- En Studio sin acceso a la API no tiene caso reintentar
		local attempts = if RunService:IsStudio() then 1 else 3
		for attempt = 1, attempts do
			local ok, result = pcall(function()
				return (store :: DataStore):GetAsync(keyFor(player))
			end)
			if ok then
				saved = result
				loaded = true
				break
			end
			warn(string.format("[Datos] Error cargando a %s (intento %d): %s", player.Name, attempt, tostring(result)))
			if attempt < attempts then
				task.wait(attempt)
			end
		end
	end

	local data = reconcile(saved)
	if player.Parent == nil then
		return data -- se salió mientras cargaba
	end
	profiles[player] = data
	canSave[player] = loaded and store ~= nil
	if not loaded then
		warn("[Datos] No se pudo cargar a " .. player.Name .. "; su progreso de esta sesión no se guardará.")
	end
	return data
end

function DataManager.Get(player: Player): PlayerData?
	return profiles[player]
end

-- Deja al jugador como nuevo (lo usa el panel de administrador)
function DataManager.Reset(player: Player)
	if profiles[player] then
		profiles[player] = defaultData()
	end
end

function DataManager.Save(player: Player)
	local data = profiles[player]
	if not data or not canSave[player] or not store then
		return
	end
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			(store :: DataStore):SetAsync(keyFor(player), data, { player.UserId })
		end)
		if ok then
			return
		end
		warn(string.format("[Datos] Error guardando a %s (intento %d): %s", player.Name, attempt, tostring(err)))
		task.wait(attempt)
	end
end

function DataManager.Release(player: Player)
	DataManager.Save(player)
	profiles[player] = nil
	canSave[player] = nil
end

function DataManager.Start()
	Players.PlayerRemoving:Connect(DataManager.Release)

	game:BindToClose(function()
		local pending = 0
		for _, player in Players:GetPlayers() do
			pending += 1
			task.spawn(function()
				DataManager.Save(player)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.1)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_SECONDS)
			for _, player in Players:GetPlayers() do
				task.spawn(DataManager.Save, player)
			end
		end
	end)
end

return DataManager
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="8">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Lógica principal del servidor: patadas, poder, vuelo del balón, sorteo, plantilla y tienda.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")

local Config = require(ReplicatedStorage.Shared.Config)
local MapBuilder = require(script.Parent.MapBuilder)
local DataManager = require(script.Parent.DataManager)
local PlotManager = require(script.Parent.PlotManager)

local rng = Random.new()

-- ------------------------------------------------------------
-- Remotes (comunicación servidor <-> cliente)
-- ------------------------------------------------------------
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"

local function remote(className: string, name: string): any
	local r = Instance.new(className)
	r.Name = name
	r.Parent = remotes
	return r
end

local KickEvent: RemoteEvent = remote("RemoteEvent", "Kick")
local BallLaunchedEvent: RemoteEvent = remote("RemoteEvent", "BallLaunched")
local KickResultEvent: RemoteEvent = remote("RemoteEvent", "KickResult")
local AnnouncementEvent: RemoteEvent = remote("RemoteEvent", "Announcement")
local DataUpdatedEvent: RemoteEvent = remote("RemoteEvent", "DataUpdated")
local NotifyEvent: RemoteEvent = remote("RemoteEvent", "Notify")
local KickStartEvent: RemoteEvent = remote("RemoteEvent", "KickStart")
local SpaceKickEvent: RemoteEvent = remote("RemoteEvent", "SpaceKick")
local AdminFunction: RemoteFunction = remote("RemoteFunction", "Admin")
local StartTrainingFunction: RemoteFunction = remote("RemoteFunction", "StartTraining")
local TrainEvent: RemoteEvent = remote("RemoteEvent", "Train")
local StopTrainingEvent: RemoteEvent = remote("RemoteEvent", "StopTraining")
local GetDataFunction: RemoteFunction = remote("RemoteFunction", "GetData")
local PurchaseFunction: RemoteFunction = remote("RemoteFunction", "Purchase")

-- ------------------------------------------------------------
-- Modelo base de futbolista (el cliente lo clona y lo pinta)
-- ------------------------------------------------------------
local function buildSimpleRig(): Model
	-- Plan B si no se puede crear un avatar R15
	local model = Instance.new("Model")
	local function block(name: string, size: Vector3, offset: Vector3): Part
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Anchored = true
		p.CanCollide = false
		p.CFrame = CFrame.new(offset)
		p.Parent = model
		return p
	end
	local root = block("HumanoidRootPart", Vector3.new(2, 2, 1), Vector3.new(0, 3, 0))
	root.Transparency = 1
	block("UpperTorso", Vector3.new(2, 2, 1), Vector3.new(0, 3, 0))
	block("Head", Vector3.new(1.2, 1.2, 1.2), Vector3.new(0, 4.6, 0))
	block("LeftHand", Vector3.new(1, 2, 1), Vector3.new(-1.5, 3, 0))
	block("RightHand", Vector3.new(1, 2, 1), Vector3.new(1.5, 3, 0))
	block("LeftUpperLeg", Vector3.new(1, 2, 1), Vector3.new(-0.5, 1, 0))
	block("RightUpperLeg", Vector3.new(1, 2, 1), Vector3.new(0.5, 1, 0))
	model.PrimaryPart = root
	return model
end

local function buildRigTemplate(): Model
	local ok, result = pcall(function()
		return Players:CreateHumanoidModelFromDescription(Instance.new("HumanoidDescription"), Enum.HumanoidRigType.R15)
	end)
	local model: Model
	if ok and result then
		model = result
		local animate = model:FindFirstChild("Animate")
		if animate then
			animate:Destroy()
		end
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		end
		for _, obj in model:GetDescendants() do
			if obj:IsA("BasePart") then
				obj.CanCollide = false
				obj.Anchored = obj.Name == "HumanoidRootPart"
			end
		end
	else
		warn("[Futbolista] No se pudo crear el avatar R15, uso uno de bloques:", result)
		model = buildSimpleRig()
	end
	model.Name = "FootballerRig"
	return model
end

MapBuilder.SetupSky()
local map = MapBuilder.Build()

local assets = Instance.new("Folder")
assets.Name = "Assets"
local rigTemplate = buildRigTemplate()
rigTemplate.Parent = assets
assets.Parent = ReplicatedStorage
remotes.Parent = ReplicatedStorage
DataManager.Start()

local KICK_ORIGIN = Config.KICK_ORIGIN

-- ------------------------------------------------------------
-- Dueño del juego (OWNER)
-- ------------------------------------------------------------
local function isOwner(player: Player): boolean
	if table.find(Config.OWNER_USER_IDS, player.UserId) then
		return true
	end
	if RunService:IsStudio() then
		return true -- probando en Studio
	end
	if game.CreatorType == Enum.CreatorType.User then
		return game.CreatorId ~= 0 and player.UserId == game.CreatorId
	elseif game.CreatorType == Enum.CreatorType.Group then
		local ok, rank = pcall(function()
			return player:GetRankInGroup(game.CreatorId)
		end)
		return ok and rank == 255
	end
	return false
end

local function addOwnerTag(character: Model)
	local head = character:WaitForChild("Head", 10)
	if not head or head:FindFirstChild("OwnerTag") then
		return
	end
	local tag = Instance.new("BillboardGui")
	tag.Name = "OwnerTag"
	tag.Size = UDim2.fromScale(7, 1.8)
	tag.StudsOffset = Vector3.new(0, 3.2, 0)
	tag.LightInfluence = 0
	tag.MaxDistance = 150
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = "👑 OWNER"
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0
	label.Parent = tag
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 220, 60)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 120, 60)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 70, 160)),
	})
	gradient.Parent = label
	tag.Parent = head
end

local function setupOwner(player: Player)
	if not isOwner(player) then
		return
	end
	player:SetAttribute("IsOwner", true)
	player.CharacterAdded:Connect(addOwnerTag)
	if player.Character then
		task.spawn(addOwnerTag, player.Character)
	end
end

-- ------------------------------------------------------------
-- Datos, plantilla y leaderstats
-- ------------------------------------------------------------
local function getIncome(data: DataManager.PlayerData): number
	local total = 0
	for _, id in data.Squad do
		local f = Config.GetFootballer(id)
		if f then
			total += f.Income
		end
	end
	return total
end

local function updateLeaderstats(player: Player)
	local data = DataManager.Get(player)
	local stats = player:FindFirstChild("leaderstats")
	if not data or not stats then
		return
	end
	(stats:FindFirstChild("Monedas") :: IntValue).Value = data.Coins;
	(stats:FindFirstChild("Poder") :: IntValue).Value = data.Power;
	(stats:FindFirstChild("Ingreso/s") :: IntValue).Value = getIncome(data)
end

local function sendData(player: Player)
	local data = DataManager.Get(player)
	if data then
		DataUpdatedEvent:FireClient(player, data)
		updateLeaderstats(player)
		PlotManager.Sync(player)
	end
end

local function buySlot(player: Player): (boolean, string)
	local data = DataManager.Get(player)
	if not data then
		return false, "Tus datos todavía están cargando."
	end
	if data.Slots >= Config.MAX_SLOTS then
		return false, "¡Ya tienes el máximo de espacios!"
	end
	local cost = Config.GetSlotCost(data.Slots)
	if data.Coins < cost then
		return false, "¡No tienes suficientes monedas!"
	end
	data.Coins -= cost
	data.Slots += 1
	sendData(player)
	return true, "🐾 ¡Plantilla ampliada a " .. data.Slots .. " espacios!"
end

PlotManager.Init(map, rigTemplate, {
	GetData = DataManager.Get,
	OnCollect = function(player: Player, amount: number)
		updateLeaderstats(player)
		NotifyEvent:FireClient(player, "💰 +" .. Config.FormatShort(amount), Color3.fromRGB(120, 255, 120))
	end,
	OnUpgrade = function(player: Player)
		local ok, message = buySlot(player)
		NotifyEvent:FireClient(player, message, if ok then Color3.fromRGB(60, 200, 90) else Color3.fromRGB(230, 70, 70))
	end,
})

GetDataFunction.OnServerInvoke = function(player: Player)
	-- Esperamos a que termine de cargar
	local started = os.clock()
	while not DataManager.Get(player) and player.Parent and os.clock() - started < 30 do
		task.wait(0.2)
	end
	return DataManager.Get(player)
end

local function onPlayerAdded(player: Player)
	setupOwner(player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	for _, name in { "Monedas", "Poder", "Ingreso/s" } do
		local value = Instance.new("IntValue")
		value.Name = name
		value.Parent = stats
	end
	stats.Parent = player

	DataManager.Load(player)
	if player.Parent then
		PlotManager.Assign(player)
		sendData(player)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
-- Por si alguien entró antes de que corriera este script
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

-- Los futbolistas de la plantilla pagan cada segundo. El dinero se junta en el plato
-- del corral y se cobra pisándolo (si no hay corral libre, se cobra solo).
task.spawn(function()
	while true do
		task.wait(1)
		for _, player in Players:GetPlayers() do
			local data = DataManager.Get(player)
			if data then
				if PlotManager.HasPlot(player) then
					data.Unclaimed += getIncome(data)
					PlotManager.Refresh(player)
				else
					data.Coins += getIncome(data)
				end
				updateLeaderstats(player)
			end
		end
	end
end)

-- Mete al futbolista en la plantilla. Si está llena, se queda con los mejores
-- y vende automáticamente al peor.
local function addToSquad(data: DataManager.PlayerData, f: Config.Footballer): (string, string?, number)
	if #data.Squad < data.Slots then
		table.insert(data.Squad, f.Id)
		return "Fichado", nil, 0
	end

	local worstIndex, worstIncome = 0, math.huge
	for i, id in data.Squad do
		local other = Config.GetFootballer(id)
		local income = if other then other.Income else 0
		if income < worstIncome then
			worstIndex, worstIncome = i, income
		end
	end

	if worstIndex > 0 and f.Income > worstIncome then
		local replacedId = data.Squad[worstIndex]
		local replaced = Config.GetFootballer(replacedId)
		local sale = if replaced then Config.GetSellPrice(replaced) else 0
		data.Squad[worstIndex] = f.Id
		data.Coins += sale
		return "Reemplazo", replacedId, sale
	end

	local sale = Config.GetSellPrice(f)
	data.Coins += sale
	return "Vendido", nil, sale
end

-- ------------------------------------------------------------
-- Patada
-- ------------------------------------------------------------
local busy: { [Player]: boolean } = {}

local function createBall(ballTier: number): Part
	local info = Config.Balls[ballTier] or Config.Balls[1]
	local ball = Instance.new("Part")
	ball.Name = "Balon"
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.new(3, 3, 3)
	ball.Color = info.Color
	ball.Material = info.Material
	ball.CanCollide = false
	ball.CanQuery = false
	ball.TopSurface = Enum.SurfaceType.Smooth
	ball.BottomSurface = Enum.SurfaceType.Smooth

	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0.8, 0)
	a0.Parent = ball
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -0.8, 0)
	a1.Parent = ball
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = ColorSequence.new(info.Color)
	trail.Transparency = NumberSequence.new(0.2, 1)
	trail.Lifetime = 0.6
	trail.LightEmission = 0.5
	trail.FaceCamera = true
	trail.Parent = ball

	-- Los balones buenos sueltan destellos
	if ballTier >= 5 then
		local sparkles = Instance.new("ParticleEmitter")
		sparkles.Color = ColorSequence.new(info.Color, Color3.new(1, 1, 1))
		sparkles.LightEmission = 1
		sparkles.Size = NumberSequence.new(0.8, 0)
		sparkles.Lifetime = NumberRange.new(0.4, 0.8)
		sparkles.Rate = 40
		sparkles.Speed = NumberRange.new(2, 5)
		sparkles.SpreadAngle = Vector2.new(180, 180)
		sparkles.Parent = ball
	end
	return ball
end

local function getRoot(player: Player): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function returnBehindLine(player: Player)
	local character = player.Character
	if character and getRoot(player) then
		character:PivotTo(CFrame.lookAt(Config.RETURN_POSITION, Config.RETURN_POSITION + Vector3.new(0, 0, 10)))
	end
end

-- Para el panel de administrador
local forceSpace: { [Player]: boolean } = {}
local forceChilena: { [Player]: boolean } = {}
local globalLuck = 1

local function handleKick(player: Player, timing: number)
	local data = DataManager.Get(player)
	local root = getRoot(player)
	local character = player.Character
	-- Solo se puede patear después de cruzar la línea (con un poco de tolerancia por el lag)
	if not data or not root or not character or not Config.IsInKickZone(root.Position + Vector3.new(0, 0, 4)) then
		return
	end

	timing = math.clamp(timing, 0, 1)
	local perfect = timing >= Config.PERFECT_THRESHOLD
	local chilena = forceChilena[player] or rng:NextNumber() < Config.CHILENA_CHANCE
	forceChilena[player] = nil
	local timingMultiplier = if perfect then Config.PERFECT_BONUS else math.max(timing, Config.MIN_TIMING)
	local rawDistance = Config.GetKickDistance(data.Power, data.BallTier)
		* timingMultiplier
		* rng:NextNumber(0.95, 1.05)
		* (if chilena then Config.CHILENA_BONUS else 1)
	local space = forceSpace[player] or rawDistance >= Config.SPACE_DISTANCE
	forceSpace[player] = nil
	local distance = if space then Config.MAX_DISTANCE else math.clamp(rawDistance, 5, Config.MAX_DISTANCE)

	-- Entrenar: cada patada te da poder (la chilena el doble)
	local powerGain = Config.GetPowerGain(timing) * (if chilena then 2 else 1)
	data.Power += powerGain
	updateLeaderstats(player)

	-- El jugador se pone en posición con el balón y se queda quieto durante la animación
	character:PivotTo(CFrame.lookAt(Config.KICK_STAND, Config.KICK_STAND + Vector3.new(0, 0, 10)))
	root.Anchored = true
	KickStartEvent:FireClient(player, {
		Chilena = chilena,
		Perfect = perfect,
		PowerGain = powerGain,
		Power = data.Power,
		Space = space,
		BallTier = data.BallTier,
	})
	local contactTime = if chilena then Config.CHILENA_CONTACT_TIME else Config.KICK_CONTACT_TIME
	local animationTime = if chilena then Config.CHILENA_ANIMATION_TIME else Config.KICK_ANIMATION_TIME
	task.wait(contactTime)
	task.delay(animationTime - contactTime + 0.1, function()
		if root.Parent then
			root.Anchored = false
		end
	end)

	-- Vuelo con física: calculamos la velocidad exacta para caer en `landing` en `flightTime` segundos
	local gravity = workspace.Gravity
	local origin, landing, flightTime, velocity
	if space then
		local vy, vz, duration = Config.GetSpaceFlight(gravity)
		origin = KICK_ORIGIN
		landing = Vector3.new(0, KICK_ORIGIN.Y, Config.MAX_DISTANCE)
		flightTime = duration
		velocity = Vector3.new(0, vy, vz)
	else
		origin = if chilena then Config.CHILENA_ORIGIN else KICK_ORIGIN
		local maxSide = math.min(distance * 0.06, Config.FIELD_WIDTH / 2 - 8)
		landing = Vector3.new(rng:NextNumber(-maxSide, maxSide), KICK_ORIGIN.Y, distance)
		flightTime = math.clamp(1.2 + distance / 600, 1.2, 6)
		local horizontal = (landing - origin) / flightTime
		local vy = (landing.Y - origin.Y + gravity * flightTime * flightTime / 2) / flightTime
		velocity = Vector3.new(horizontal.X, vy, horizontal.Z)
	end

	local ball = createBall(data.BallTier)
	ball.Position = origin
	ball.Parent = workspace.Balones
	ball:SetNetworkOwner(nil)
	ball.AssemblyLinearVelocity = velocity
	ball.AssemblyAngularVelocity = Vector3.new(20, 0, 0)

	BallLaunchedEvent:FireClient(player, ball, {
		FlightTime = flightTime,
		Space = space,
		Chilena = chilena,
	})
	if space then
		SpaceKickEvent:FireAllClients(ball)
		AnnouncementEvent:FireAllClients(
			"🚀 ¡" .. player.DisplayName .. " pateó el balón al ESPACIO y rompió todos los planetas!",
			Color3.fromRGB(190, 120, 255)
		)
	elseif chilena then
		AnnouncementEvent:FireAllClients("⚡ ¡CHILENA de " .. player.DisplayName .. "!", Color3.fromRGB(255, 220, 60))
	end

	task.wait(flightTime)
	if ball.Parent then
		ball.Anchored = true
		ball.AssemblyLinearVelocity = Vector3.zero
		ball.Position = landing
	end
	Debris:AddItem(ball, 12)

	-- Resultado
	local current = DataManager.Get(player)
	if not current then
		return
	end
	local zone = Config.GetZoneFromDistance(distance)
	local luck = Config.GetLuckAtDistance(distance) * (if space then Config.SPACE_LUCK_BONUS else 1) * globalLuck
	local footballer = Config.RollFootballer(luck, rng)
	local isNew = (current.Collection[footballer.Id] or 0) == 0
	local kickCoins = Config.GetCoinsForKick(distance) * (if space then Config.SPACE_COINS_BONUS else 1)
	local newRecord = distance > current.BestDistance

	current.Coins += kickCoins
	current.TotalKicks += 1
	current.Collection[footballer.Id] = (current.Collection[footballer.Id] or 0) + 1
	if newRecord then
		current.BestDistance = distance
	end
	local squadStatus, replacedId, saleCoins = addToSquad(current, footballer)
	returnBehindLine(player)

	KickResultEvent:FireClient(player, {
		FootballerId = footballer.Id,
		Distance = distance,
		Zone = zone,
		Luck = luck,
		Coins = kickCoins,
		IsNew = isNew,
		NewRecord = newRecord,
		Landing = landing,
		SquadStatus = squadStatus,
		ReplacedId = replacedId,
		SaleCoins = saleCoins,
		Space = space,
		Chilena = chilena,
	})
	sendData(player)

	local rarity = Config.Rarities[footballer.Rarity]
	if rarity.Order >= Config.Rarities.Legendario.Order then
		AnnouncementEvent:FireAllClients(
			string.format(
				"🎉 ¡%s sacó a %s! (%s · 1 en %s)",
				player.DisplayName,
				footballer.Name,
				rarity.Name,
				Config.FormatNumber(footballer.Chance)
			),
			rarity.Color
		)
	end
end

KickEvent.OnServerEvent:Connect(function(player: Player, timing: any)
	if busy[player] or typeof(timing) ~= "number" or timing ~= timing then
		return
	end
	busy[player] = true
	local ok, err = pcall(handleKick, player, timing)
	if not ok then
		warn("[Patada] Error:", err)
		local root = getRoot(player)
		if root then
			root.Anchored = false
		end
	end
	busy[player] = nil
end)

Players.PlayerRemoving:Connect(function(player)
	busy[player] = nil
	forceSpace[player] = nil
	forceChilena[player] = nil
end)

-- ------------------------------------------------------------
-- Gimnasio
-- ------------------------------------------------------------
type TrainingState = { Index: number, LastRep: number }
local training: { [Player]: TrainingState } = {}
local gym = map:FindFirstChild("Gimnasio", true)

local function stopTraining(player: Player)
	if not training[player] then
		return
	end
	training[player] = nil
	local root = getRoot(player)
	if root then
		root.Anchored = false
	end
end

StartTrainingFunction.OnServerInvoke = function(player: Player, index: any): (boolean, string)
	local data = DataManager.Get(player)
	local root = getRoot(player)
	local info = if typeof(index) == "number" then Config.TrainingStations[index] else nil
	local station = gym and info and gym:FindFirstChild("Estacion" .. index)
	if not data or not root or not info or not station then
		return false, "No puedes entrenar ahora."
	end
	if busy[player] then
		return false, "¡Espera a que caiga tu balón!"
	end
	local stand = station:FindFirstChild("Punto") :: BasePart
	if (root.Position - stand.Position).Magnitude > 16 then
		return false, "Acércate más al aparato."
	end
	if data.Power < info.Required then
		return false, "🔒 Necesitas " .. Config.FormatShort(info.Required) .. " de poder para " .. info.Name .. "."
	end
	stopTraining(player)
	training[player] = { Index = index, LastRep = 0 }
	root.Anchored = true
	player.Character:PivotTo(stand.CFrame)
	return true, info.Name
end

TrainEvent.OnServerEvent:Connect(function(player: Player)
	local state = training[player]
	local data = DataManager.Get(player)
	if not state or not data then
		return
	end
	local now = os.clock()
	if now - state.LastRep < Config.TRAIN_COOLDOWN * 0.85 then
		return -- demasiado rápido
	end
	state.LastRep = now
	data.Power += Config.TrainingStations[state.Index].Gain
	updateLeaderstats(player)
end)

StopTrainingEvent.OnServerEvent:Connect(stopTraining)

Players.PlayerRemoving:Connect(function(player)
	training[player] = nil
end)

local function watchCharacter(player: Player)
	player.CharacterRemoving:Connect(function()
		training[player] = nil
	end)
end
Players.PlayerAdded:Connect(watchCharacter)
for _, player in Players:GetPlayers() do
	watchCharacter(player)
end

-- ------------------------------------------------------------
-- Panel de administrador (solo el OWNER)
-- ------------------------------------------------------------
local function filterForEveryone(text: string, from: Player): string?
	local ok, result = pcall(function()
		local filtered = TextService:FilterStringAsync(text, from.UserId, Enum.TextFilterContext.PublicChat)
		return filtered:GetNonChatStringForBroadcastAsync()
	end)
	return if ok then result else nil
end

AdminFunction.OnServerInvoke = function(player: Player, action: any, targetId: any, value: any): (boolean, string)
	if not isOwner(player) then
		return false, "No eres administrador."
	end
	if typeof(action) ~= "string" then
		return false, "Acción inválida."
	end

	-- Acciones para todo el servidor
	if action == "LuckBoost" then
		globalLuck = if globalLuck > 1 then 1 else 2
		AnnouncementEvent:FireAllClients(
			if globalLuck > 1 then "🍀 ¡El OWNER activó SUERTE x2 para todos!" else "🍀 La suerte x2 terminó.",
			Color3.fromRGB(120, 255, 140)
		)
		return true, if globalLuck > 1 then "Suerte x2 activada" else "Suerte x2 desactivada"
	elseif action == "Announce" then
		if typeof(value) ~= "string" or #value == 0 then
			return false, "Escribe un mensaje."
		end
		local filtered = filterForEveryone(string.sub(value, 1, 150), player)
		if not filtered then
			return false, "No se pudo enviar el mensaje."
		end
		AnnouncementEvent:FireAllClients("📢 " .. filtered, Color3.fromRGB(255, 220, 80))
		return true, "Anuncio enviado"
	end

	local target = Players:GetPlayerByUserId(tonumber(targetId) or 0) or player
	local data = DataManager.Get(target)
	if not data then
		return false, "Ese jugador todavía no tiene datos."
	end
	local name = target.DisplayName
	local amount = math.clamp(math.floor(tonumber(value) or 0), 0, 1e15)

	if action == "Coins" then
		data.Coins += amount
		sendData(target)
		return true, "+" .. Config.FormatShort(amount) .. " monedas para " .. name
	elseif action == "Power" then
		data.Power += amount
		sendData(target)
		return true, "+" .. Config.FormatShort(amount) .. " de poder para " .. name
	elseif action == "MaxBall" then
		data.BallTier = #Config.Balls
		sendData(target)
		return true, name .. " ahora tiene el " .. Config.Balls[#Config.Balls].Name
	elseif action == "MaxSlots" then
		data.Slots = Config.MAX_SLOTS
		sendData(target)
		return true, name .. " tiene " .. Config.MAX_SLOTS .. " espacios"
	elseif action == "GiveFootballer" then
		local f = if typeof(value) == "string" then Config.GetFootballer(value) else nil
		if not f then
			return false, "Ese futbolista no existe."
		end
		data.Collection[f.Id] = (data.Collection[f.Id] or 0) + 1
		addToSquad(data, f)
		sendData(target)
		return true, f.Name .. " fichado para " .. name
	elseif action == "Teleport" then
		local zone = math.clamp(amount, 1, Config.NUM_ZONES)
		local character = target.Character
		if not character then
			return false, "No tiene personaje."
		end
		character:PivotTo(CFrame.new(0, 4, (zone - 1) * Config.ZONE_LENGTH + Config.ZONE_LENGTH / 2))
		return true, name .. " fue a la zona " .. zone
	elseif action == "ForceSpace" then
		forceSpace[target] = true
		return true, "La próxima patada de " .. name .. " se va al ESPACIO 🚀"
	elseif action == "ForceChilena" then
		forceChilena[target] = true
		return true, "La próxima patada de " .. name .. " es una CHILENA ⚡"
	elseif action == "Reset" then
		DataManager.Reset(target)
		sendData(target)
		return true, "Datos de " .. name .. " reiniciados"
	end
	return false, "Acción desconocida."
end

-- ------------------------------------------------------------
-- Tienda y plantilla
-- ------------------------------------------------------------
PurchaseFunction.OnServerInvoke = function(player: Player, kind: any, arg: any): (boolean, string)
	local data = DataManager.Get(player)
	if not data then
		return false, "Tus datos todavía están cargando."
	end

	if kind == "Ball" then
		local nextTier = data.BallTier + 1
		local ball = Config.Balls[nextTier]
		if not ball then
			return false, "¡Ya tienes el mejor balón!"
		end
		if data.Coins < ball.Price then
			return false, "¡No tienes suficientes monedas!"
		end
		data.Coins -= ball.Price
		data.BallTier = nextTier
		sendData(player)
		return true, "⚽ ¡Compraste el " .. ball.Name .. "!"
	elseif kind == "Slot" then
		return buySlot(player)
	elseif kind == "Sell" then
		if typeof(arg) ~= "string" then
			return false, "Venta inválida."
		end
		local index = table.find(data.Squad, arg)
		local f = Config.GetFootballer(arg)
		if not index or not f then
			return false, "Ese futbolista no está en tu plantilla."
		end
		table.remove(data.Squad, index)
		local sale = Config.GetSellPrice(f)
		data.Coins += sale
		sendData(player)
		return true, "Vendiste a " .. f.Name .. " por 💰" .. Config.FormatShort(sale)
	end

	return false, "Compra inválida."
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[-- Construye el mapa: lobby, punto de patada y un cañón de 30 zonas dividido en biomas.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Scenery = require(script.Parent.Scenery)

local MapBuilder = {}

local W = Config.FIELD_WIDTH
local L = Config.ZONE_LENGTH
local OUTER_X = Scenery.EDGE + Scenery.LOT -- borde exterior de los escenarios

local function makePart(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		if key ~= "Parent" then
			(p :: any)[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

local function makeLabel(parent: Instance, text: string, size: UDim2, position: UDim2, color: Color3)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = size
	label.Position = position
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	label.TextStrokeTransparency = 0
	label.Text = text
	label.Parent = parent
	return label
end

-- ------------------------------------------------------------
-- Decoraciones (hechas con bloques, estilo Roblox clásico)
-- ------------------------------------------------------------
local Decorations = {}

function Decorations.Casa(model: Model, pos: Vector3, rng: Random)
	local colors = { Color3.fromRGB(240, 200, 120), Color3.fromRGB(200, 120, 90), Color3.fromRGB(150, 190, 230), Color3.fromRGB(240, 240, 230) }
	local size = Vector3.new(rng:NextInteger(10, 14), rng:NextInteger(8, 12), rng:NextInteger(10, 14))
	makePart({ Size = size, Position = pos + Vector3.new(0, size.Y / 2, 0), Color = colors[rng:NextInteger(1, #colors)], Material = Enum.Material.Brick, Parent = model })
	local roof = Instance.new("WedgePart")
	roof.Anchored = true
	roof.Size = Vector3.new(size.X + 1, 5, size.Z / 2 + 0.5)
	roof.Color = Color3.fromRGB(170, 60, 50)
	-- La parte alta de una cuña está atrás (+Z), así que las dos mitades se juntan en el centro
	roof.CFrame = CFrame.new(pos + Vector3.new(0, size.Y + 2.5, -size.Z / 4))
	roof.Parent = model
	local roof2 = roof:Clone()
	roof2.CFrame = CFrame.new(pos + Vector3.new(0, size.Y + 2.5, size.Z / 4)) * CFrame.Angles(0, math.pi, 0)
	roof2.Parent = model
	makePart({ Size = Vector3.new(3, 5, 0.4), Position = pos + Vector3.new(0, 2.5, -size.Z / 2 - 0.1), Color = Color3.fromRGB(100, 60, 40), Parent = model })
end

function Decorations.Arbol(model: Model, pos: Vector3, rng: Random)
	local h = rng:NextInteger(8, 14)
	makePart({ Size = Vector3.new(2, h, 2), Position = pos + Vector3.new(0, h / 2, 0), Color = Color3.fromRGB(110, 70, 40), Material = Enum.Material.Wood, Parent = model })
	local green = Color3.fromRGB(rng:NextInteger(60, 100), rng:NextInteger(160, 210), rng:NextInteger(50, 80))
	makePart({ Size = Vector3.new(10, 5, 10), Position = pos + Vector3.new(0, h + 1.5, 0), Color = green, Material = Enum.Material.Grass, Parent = model })
	makePart({ Size = Vector3.new(6, 4, 6), Position = pos + Vector3.new(0, h + 5.5, 0), Color = green, Material = Enum.Material.Grass, Parent = model })
end

function Decorations.Palmera(model: Model, pos: Vector3, rng: Random)
	local h = rng:NextInteger(14, 20)
	makePart({ Size = Vector3.new(1.6, h, 1.6), Position = pos + Vector3.new(0, h / 2, 0), Color = Color3.fromRGB(160, 120, 70), Material = Enum.Material.Wood, Parent = model })
	for i = 0, 3 do
		local angle = i * math.pi / 2 + rng:NextNumber(0, 0.4)
		makePart({
			Size = Vector3.new(2.5, 0.6, 9),
			CFrame = CFrame.new(pos + Vector3.new(0, h, 0)) * CFrame.Angles(0, angle, 0) * CFrame.new(0, -0.8, -4) * CFrame.Angles(math.rad(-15), 0, 0),
			Color = Color3.fromRGB(60, 170, 60),
			Material = Enum.Material.Grass,
			Parent = model,
		})
	end
	makePart({ Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 1.4, 1.4), Position = pos + Vector3.new(0.8, h - 1, 0.6), Color = Color3.fromRGB(110, 80, 40), Parent = model })
end

function Decorations.Cactus(model: Model, pos: Vector3, rng: Random)
	local h = rng:NextInteger(6, 11)
	local green = Color3.fromRGB(70, 150, 70)
	makePart({ Size = Vector3.new(2.4, h, 2.4), Position = pos + Vector3.new(0, h / 2, 0), Color = green, Material = Enum.Material.Grass, Parent = model })
	for side = -1, 1, 2 do
		if rng:NextNumber() < 0.7 then
			local armY = rng:NextNumber(h * 0.35, h * 0.6)
			makePart({ Size = Vector3.new(2.5, 1.6, 1.6), Position = pos + Vector3.new(side * 2.4, armY, 0), Color = green, Material = Enum.Material.Grass, Parent = model })
			makePart({ Size = Vector3.new(1.6, 3.5, 1.6), Position = pos + Vector3.new(side * 3.3, armY + 2.2, 0), Color = green, Material = Enum.Material.Grass, Parent = model })
		end
	end
end

function Decorations.Pino(model: Model, pos: Vector3, rng: Random)
	local h = rng:NextInteger(3, 5)
	makePart({ Size = Vector3.new(1.6, h, 1.6), Position = pos + Vector3.new(0, h / 2, 0), Color = Color3.fromRGB(100, 70, 45), Material = Enum.Material.Wood, Parent = model })
	local y = h
	for _, width in { 9, 7, 5, 3 } do
		makePart({ Size = Vector3.new(width, 2.5, width), Position = pos + Vector3.new(0, y + 1.25, 0), Color = Color3.fromRGB(40, 110, 70), Material = Enum.Material.Grass, Parent = model })
		makePart({ Size = Vector3.new(width - 0.6, 0.6, width - 0.6), Position = pos + Vector3.new(0, y + 2.8, 0), Color = Color3.new(1, 1, 1), Material = Enum.Material.Snow, Parent = model })
		y += 2.7
	end
end

function Decorations.Roca(model: Model, pos: Vector3, rng: Random)
	local s = rng:NextNumber(4, 8)
	makePart({
		Size = Vector3.new(s, s * 0.8, s),
		CFrame = CFrame.new(pos + Vector3.new(0, s * 0.3, 0)) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, math.pi), rng:NextNumber(-0.3, 0.3)),
		Color = Color3.fromRGB(60, 50, 50),
		Material = Enum.Material.Basalt,
		Parent = model,
	})
	-- grieta de lava
	makePart({
		Size = Vector3.new(rng:NextNumber(6, 12), 0.2, 1.2),
		CFrame = CFrame.new(pos + Vector3.new(rng:NextNumber(-3, 3), 0.05, rng:NextNumber(-3, 3))) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0),
		Color = Color3.fromRGB(255, 110, 30),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = model,
	})
end

-- Arco al inicio de cada zona con su número, nombre y suerte
local function buildZoneArch(parent: Instance, zone: number, startZ: number, info: Config.ZoneInfo)
	local pillarColor = Color3.fromRGB(245, 245, 245)
	local barColor = Color3.fromRGB(35, 35, 48)
	for side = -1, 1, 2 do
		makePart({ Name = "Pilar", Size = Vector3.new(4, 28, 4), Position = Vector3.new(side * (W / 2 + 3), 14, startZ), Color = pillarColor, TopSurface = Enum.SurfaceType.Studs, Parent = parent })
		makePart({ Name = "Gema", Size = Vector3.new(3.5, 3.5, 3.5), CFrame = CFrame.new(side * (W / 2 + 3), 36, startZ) * CFrame.Angles(0, math.rad(45), math.rad(45)), Color = info.Field, Material = Enum.Material.Neon, CanCollide = false, Parent = parent })
	end
	local bar = makePart({ Name = "Letrero", Size = Vector3.new(W + 10, 8, 3), Position = Vector3.new(0, 31, startZ), Color = barColor, TopSurface = Enum.SurfaceType.Studs, Parent = parent })
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local surface = Instance.new("SurfaceGui")
		surface.Face = face
		surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		surface.PixelsPerStud = 12
		surface.LightInfluence = 0
		surface.Parent = bar
		makeLabel(surface, string.format("%s ZONA %d: %s", info.Emoji, zone, info.Name), UDim2.fromScale(0.96, 0.55), UDim2.fromScale(0.02, 0.05), Color3.new(1, 1, 1))
		makeLabel(surface, "🍀 Suerte x" .. Config.FormatLuck(Config.GetLuck(zone)), UDim2.fromScale(0.96, 0.36), UDim2.fromScale(0.02, 0.6), Color3.fromRGB(120, 255, 140))
	end
end

-- ------------------------------------------------------------
-- Zonas: campo al centro y un escenario distinto a cada lado
-- ------------------------------------------------------------
local function buildZone(map: Folder, zone: number)
	local info = Config.GetZoneInfo(zone)
	local startZ = (zone - 1) * L
	local zoneFolder = Instance.new("Folder")
	zoneFolder.Name = "Zona" .. zone
	zoneFolder.Parent = map

	-- Piso a cuadros con relieve (3 columnas x 2 filas)
	local cols, rows = 3, 2
	for c = 0, cols - 1 do
		for r = 0, rows - 1 do
			makePart({
				Name = "Piso",
				Size = Vector3.new(W / cols, 2, L / rows),
				Position = Vector3.new(-W / 2 + W / cols * (c + 0.5), -1, startZ + L / rows * (r + 0.5)),
				Color = Config.GetZoneColor(zone, (c + r + zone) % 2 == 0),
				Material = Enum.Material.SmoothPlastic,
				TopSurface = Enum.SurfaceType.Studs,
				Parent = zoneFolder,
			})
		end
	end

	-- Líneas blancas: inicio de zona, centro y costados
	local white = Color3.new(1, 1, 1)
	makePart({ Name = "Linea", Size = Vector3.new(W, 0.2, 1.2), Position = Vector3.new(0, 0.1, startZ), Color = white, CanCollide = false, Parent = zoneFolder })
	makePart({ Name = "LineaCentro", Size = Vector3.new(1, 0.2, L), Position = Vector3.new(0, 0.1, startZ + L / 2), Color = white, Transparency = 0.2, CanCollide = false, Parent = zoneFolder })
	if zone > 1 then
		buildZoneArch(zoneFolder, zone, startZ, info)
	end

	for side = -1, 1, 2 do
		makePart({ Name = "LineaLateral", Size = Vector3.new(1, 0.2, L), Position = Vector3.new(side * (W / 2 - 0.5), 0.1, startZ + L / 2), Color = white, CanCollide = false, Parent = zoneFolder })
		-- bordillo entre el campo y el escenario
		makePart({ Name = "Bordillo", Size = Vector3.new(3, 1.2, L), Position = Vector3.new(side * (W / 2 + 1.5), 0.6, startZ + L / 2), Color = white, TopSurface = Enum.SurfaceType.Studs, Parent = zoneFolder })
		-- terreno del escenario
		makePart({
			Name = "Terreno",
			Size = Vector3.new(Scenery.LOT, 2, L),
			Position = Vector3.new(side * (Scenery.EDGE + Scenery.LOT / 2), -1, startZ + L / 2),
			Color = info.Lot,
			Material = Enum.Material.SmoothPlastic,
			TopSurface = Enum.SurfaceType.Studs,
			Parent = zoneFolder,
		})
		-- pared invisible para no caerse del mapa
		makePart({ Name = "Limite", Size = Vector3.new(2, 120, L), Position = Vector3.new(side * (OUTER_X + 1), 59, startZ + L / 2), Transparency = 1, Parent = zoneFolder })

		local scene = Instance.new("Model")
		scene.Name = info.Scene .. (if side < 0 then "Izquierda" else "Derecha")
		Scenery.Build(scene, zone, side, startZ)
		scene.Parent = zoneFolder
	end
end

local function buildGoal(map: Folder)
	local z = Config.MAX_DISTANCE + 4
	local goalWidth, goalHeight = 60, 24
	local color = Color3.new(1, 1, 1)
	for side = -1, 1, 2 do
		makePart({ Name = "Poste", Size = Vector3.new(2, goalHeight, 2), Position = Vector3.new(side * goalWidth / 2, goalHeight / 2, z), Color = color, Parent = map })
	end
	makePart({ Name = "Travesano", Size = Vector3.new(goalWidth + 2, 2, 2), Position = Vector3.new(0, goalHeight, z), Color = color, Parent = map })
	makePart({
		Name = "Red",
		Size = Vector3.new(goalWidth, goalHeight, 0.2),
		Position = Vector3.new(0, goalHeight / 2, z + 10),
		Color = color,
		Transparency = 0.6,
		Material = Enum.Material.ForceField,
		Parent = map,
	})
	local lastZone = Config.GetZoneInfo(Config.NUM_ZONES)
	makePart({
		Name = "PisoFinal",
		Size = Vector3.new(OUTER_X * 2, 2, 20),
		Position = Vector3.new(0, -1, z + 6),
		Color = lastZone.Field,
		Material = Enum.Material.SmoothPlastic,
		Parent = map,
	})
	makePart({
		Name = "ParedFinal",
		Size = Vector3.new(OUTER_X * 2 + 20, 80, 6),
		Position = Vector3.new(0, 39, z + 19),
		Color = lastZone.Lot,
		Material = Enum.Material.Slate,
		Parent = map,
	})
end

-- ------------------------------------------------------------
-- Lobby colorido con los corrales de cada jugador
-- ------------------------------------------------------------
local LOBBY_HALF_WIDTH = 110
local LOBBY_DEPTH = 260
local TILE = 20
local GRASS_A = Color3.fromRGB(95, 225, 60)
local GRASS_B = Color3.fromRGB(130, 245, 85)
local DIRT = Color3.fromRGB(150, 95, 60)
local GRASS_TOP = Color3.fromRGB(110, 230, 70)
local WOOD = Color3.fromRGB(160, 105, 60)

MapBuilder.PEN_SIZE = Vector3.new(44, 0, 40)
MapBuilder.PEN_CENTERS = {
	Vector3.new(-72, 0, -40),
	Vector3.new(72, 0, -40),
	Vector3.new(-72, 0, -88),
	Vector3.new(72, 0, -88),
	Vector3.new(-72, 0, -136),
	Vector3.new(72, 0, -136),
}

local function fence(parent: Instance, from: Vector3, to: Vector3)
	local length = (to - from).Magnitude
	local dir = (to - from).Unit
	local posts = math.max(math.floor(length / 6), 1)
	for i = 0, posts do
		local pos = from + dir * (length * i / posts)
		makePart({ Name = "Poste", Size = Vector3.new(1.4, 5, 1.4), Position = pos + Vector3.new(0, 2.5, 0), Color = WOOD, Material = Enum.Material.Wood, TopSurface = Enum.SurfaceType.Studs, Parent = parent })
	end
	for _, y in { 1.8, 3.8 } do
		makePart({
			Name = "Tabla",
			Size = Vector3.new(0.8, 0.9, length),
			CFrame = CFrame.lookAt(from:Lerp(to, 0.5) + Vector3.new(0, y, 0), to + Vector3.new(0, y, 0)),
			Color = WOOD:Lerp(Color3.new(1, 1, 1), 0.1),
			Material = Enum.Material.Wood,
			Parent = parent,
		})
	end
end

local function flowers(parent: Instance, center: Vector3, rng: Random)
	local petals = { Color3.fromRGB(255, 90, 120), Color3.fromRGB(255, 220, 60), Color3.fromRGB(150, 110, 255), Color3.fromRGB(255, 150, 40), Color3.new(1, 1, 1) }
	for _ = 1, 6 do
		local pos = center + Vector3.new(rng:NextNumber(-4, 4), 0, rng:NextNumber(-4, 4))
		makePart({ Size = Vector3.new(0.4, 1.4, 0.4), Position = pos + Vector3.new(0, 0.7, 0), Color = Color3.fromRGB(60, 170, 60), CanCollide = false, Parent = parent })
		makePart({ Size = Vector3.new(1.2, 0.6, 1.2), Position = pos + Vector3.new(0, 1.6, 0), Color = petals[rng:NextInteger(1, #petals)], CanCollide = false, Parent = parent })
	end
end

local function buildPen(map: Folder, index: number, center: Vector3)
	local pen = Instance.new("Model")
	pen.Name = "Corral" .. index
	pen:SetAttribute("Center", center)
	pen:SetAttribute("Size", MapBuilder.PEN_SIZE)
	local sx, sz = MapBuilder.PEN_SIZE.X / 2, MapBuilder.PEN_SIZE.Z / 2
	local inward = if center.X > 0 then -1 else 1 -- lado que mira al camino central

	-- Piso del corral (pasto más oscuro, con relieve)
	makePart({
		Name = "Piso",
		Size = Vector3.new(sx * 2, 0.4, sz * 2),
		Position = center + Vector3.new(0, 0.2, 0),
		Color = Color3.fromRGB(75, 190, 55),
		Material = Enum.Material.SmoothPlastic,
		TopSurface = Enum.SurfaceType.Studs,
		Parent = pen,
	})

	-- Cerca en 3 lados + el lado del camino con una puerta en medio
	local back = center.X - inward * sx
	local front = center.X + inward * sx
	fence(pen, Vector3.new(back, 0, center.Z - sz), Vector3.new(back, 0, center.Z + sz))
	fence(pen, Vector3.new(back, 0, center.Z - sz), Vector3.new(front, 0, center.Z - sz))
	fence(pen, Vector3.new(back, 0, center.Z + sz), Vector3.new(front, 0, center.Z + sz))
	fence(pen, Vector3.new(front, 0, center.Z - sz), Vector3.new(front, 0, center.Z - 7))
	fence(pen, Vector3.new(front, 0, center.Z + 7), Vector3.new(front, 0, center.Z + sz))

	-- Plato para cobrar (afuera de la puerta)
	local pad = makePart({
		Name = "Cobrar",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 9, 9),
		CFrame = CFrame.new(front + inward * 7, 0.3, center.Z) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(255, 205, 40),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = pen,
	})
	local padGui = Instance.new("BillboardGui")
	padGui.Name = "Dinero"
	padGui.Size = UDim2.fromScale(14, 5)
	padGui.StudsOffset = Vector3.new(0, 5, 0)
	padGui.LightInfluence = 0
	padGui.MaxDistance = 150
	padGui.Parent = pad
	makeLabel(padGui, "💰 0", UDim2.fromScale(1, 0.65), UDim2.fromScale(0, 0), Color3.fromRGB(120, 255, 120)).Name = "Cantidad"
	makeLabel(padGui, "Písalo para cobrar", UDim2.fromScale(1, 0.35), UDim2.fromScale(0, 0.65), Color3.new(1, 1, 1))

	-- Cartel de madera para mejorar los espacios
	local signPos = Vector3.new(front + inward * 4, 4, center.Z + 13)
	local sign = makePart({
		Name = "CartelMejora",
		Size = Vector3.new(11, 6, 0.8),
		CFrame = CFrame.lookAt(signPos, signPos + Vector3.new(inward, 0, -0.35)),
		Color = WOOD,
		Material = Enum.Material.Wood,
		Parent = pen,
	})
	makePart({ Name = "Pata", Size = Vector3.new(1, 4, 1), Position = signPos - Vector3.new(0, 4, 0), Color = WOOD, Material = Enum.Material.Wood, Parent = pen })
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local surface = Instance.new("SurfaceGui")
		surface.Name = "Texto" .. face.Name
		surface.Face = face
		surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		surface.PixelsPerStud = 40
		surface.LightInfluence = 0
		surface.Parent = sign
		makeLabel(surface, "🐾 8 > 9", UDim2.fromScale(0.9, 0.5), UDim2.fromScale(0.05, 0.05), Color3.new(1, 1, 1)).Name = "Espacios"
		makeLabel(surface, "💰 500", UDim2.fromScale(0.9, 0.38), UDim2.fromScale(0.05, 0.57), Color3.fromRGB(120, 255, 120)).Name = "Precio"
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "Mejorar"
	prompt.ActionText = "Mejorar espacios"
	prompt.ObjectText = "Plantilla"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Enabled = false
	prompt.Parent = sign

	-- Letrero con el nombre del dueño
	local nameAnchor = makePart({
		Name = "Letrero",
		Size = Vector3.one,
		Position = Vector3.new(back, 12, center.Z),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Parent = pen,
	})
	local nameGui = Instance.new("BillboardGui")
	nameGui.Name = "Nombre"
	nameGui.Size = UDim2.fromScale(30, 6)
	nameGui.LightInfluence = 0
	nameGui.MaxDistance = 300
	nameGui.Parent = nameAnchor
	makeLabel(nameGui, "Corral libre", UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), Color3.fromRGB(255, 230, 80)).Name = "Texto"

	local footballers = Instance.new("Folder")
	footballers.Name = "Futbolistas"
	footballers.Parent = pen

	pen.Parent = map
	return pen
end

-- Puesto con toldo a rayas (Tienda / Índice). `facing` es hacia dónde mira el mostrador.
local function buildStall(parent: Instance, pos: Vector3, facing: Vector3, stripe: Color3, title: string, promptName: string, action: string)
	local model = Instance.new("Model")
	model.Name = promptName
	local base = CFrame.lookAt(pos, pos + facing)
	local function piece(size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?): Part
		return makePart({ Size = size, CFrame = base * offset, Color = color, Material = material or Enum.Material.SmoothPlastic, TopSurface = Enum.SurfaceType.Studs, Parent = model })
	end
	local counter = piece(Vector3.new(14, 4, 4), CFrame.new(0, 2, -2), WOOD, Enum.Material.Wood)
	piece(Vector3.new(14.6, 0.6, 4.6), CFrame.new(0, 4.3, -2), WOOD:Lerp(Color3.new(1, 1, 1), 0.25), Enum.Material.Wood)
	for _, x in { -6.5, 6.5 } do
		for _, z in { -3.5, 3.5 } do
			piece(Vector3.new(1, 10, 1), CFrame.new(x, 5, z), Color3.new(1, 1, 1))
		end
	end
	piece(Vector3.new(14, 8, 0.6), CFrame.new(0, 4, 3.8), stripe:Lerp(Color3.new(0, 0, 0), 0.3))
	-- toldo a rayas
	for i = 0, 6 do
		piece(
			Vector3.new(2, 0.5, 10),
			CFrame.new(-6 + i * 2, 10.6, -0.5) * CFrame.Angles(math.rad(-14), 0, 0), -- más bajo adelante
			if i % 2 == 0 then stripe else Color3.new(1, 1, 1)
		)
	end
	-- letrero arriba
	local sign = piece(Vector3.new(12, 3.2, 0.6), CFrame.new(0, 13.4, 2), Color3.fromRGB(30, 30, 40))
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local surface = Instance.new("SurfaceGui")
		surface.Face = face
		surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		surface.PixelsPerStud = 30
		surface.LightInfluence = 0
		surface.Parent = sign
		makeLabel(surface, title, UDim2.fromScale(0.95, 0.9), UDim2.fromScale(0.025, 0.05), Color3.fromRGB(255, 230, 80))
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = promptName
	prompt.ActionText = action
	prompt.ObjectText = title
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = counter
	model.Parent = parent
end

local RAINBOW = {
	Color3.fromRGB(255, 70, 70),
	Color3.fromRGB(255, 160, 40),
	Color3.fromRGB(255, 230, 60),
	Color3.fromRGB(80, 220, 90),
	Color3.fromRGB(70, 160, 255),
	Color3.fromRGB(180, 90, 255),
}

-- Banderitas de colores colgando sobre el camino
local function buildBunting(parent: Instance, z: number, halfWidth: number)
	for side = -1, 1, 2 do
		makePart({ Name = "Poste", Size = Vector3.new(1.2, 16, 1.2), Position = Vector3.new(side * halfWidth, 8, z), Color = Color3.new(1, 1, 1), TopSurface = Enum.SurfaceType.Studs, Parent = parent })
	end
	makePart({ Name = "Cuerda", Size = Vector3.new(halfWidth * 2, 0.2, 0.2), Position = Vector3.new(0, 15.5, z), Color = Color3.fromRGB(80, 60, 40), CanCollide = false, Parent = parent })
	local count = math.floor(halfWidth * 2 / 3)
	for i = 1, count - 1 do
		local x = -halfWidth + i * (halfWidth * 2 / count)
		makePart({
			Name = "Banderita",
			Size = Vector3.new(0.2, 1.6, 1.6),
			CFrame = CFrame.new(x, 14.6, z) * CFrame.Angles(0, math.rad(90), 0) * CFrame.Angles(math.rad(45), 0, 0),
			Color = RAINBOW[(i - 1) % #RAINBOW + 1],
			CanCollide = false,
			Parent = parent,
		})
	end
end

local function buildLamp(parent: Instance, pos: Vector3)
	makePart({ Name = "Farol", Size = Vector3.new(0.9, 12, 0.9), Position = pos + Vector3.new(0, 6, 0), Color = Color3.fromRGB(50, 55, 70), Parent = parent })
	makePart({ Name = "Base", Size = Vector3.new(2.4, 1, 2.4), Position = pos + Vector3.new(0, 0.5, 0), Color = Color3.fromRGB(50, 55, 70), TopSurface = Enum.SurfaceType.Studs, Parent = parent })
	local bulb = makePart({ Name = "Foco", Shape = Enum.PartType.Ball, Size = Vector3.new(2.4, 2.4, 2.4), Position = pos + Vector3.new(0, 12.8, 0), Color = Color3.fromRGB(255, 230, 150), Material = Enum.Material.Neon, Parent = parent })
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 220, 160)
	light.Range = 22
	light.Brightness = 1.5
	light.Parent = bulb
end

local function buildBush(parent: Instance, pos: Vector3, rng: Random)
	local green = Color3.fromRGB(rng:NextInteger(50, 80), rng:NextInteger(170, 210), rng:NextInteger(50, 70))
	for _ = 1, 3 do
		local size = rng:NextNumber(3.5, 5.5)
		makePart({ Name = "Arbusto", Shape = Enum.PartType.Ball, Size = Vector3.new(size, size, size), Position = pos + Vector3.new(rng:NextNumber(-2, 2), size / 2 - 0.5, rng:NextNumber(-2, 2)), Color = green, Parent = parent })
	end
end

-- Monumento: balón gigante sobre un pedestal
local function buildMonument(parent: Instance, pos: Vector3)
	makePart({ Name = "Pedestal", Size = Vector3.new(16, 4, 16), Position = pos + Vector3.new(0, 2, 0), Color = Color3.fromRGB(240, 240, 245), TopSurface = Enum.SurfaceType.Studs, Parent = parent })
	makePart({ Name = "Pedestal", Size = Vector3.new(12, 4, 12), Position = pos + Vector3.new(0, 6, 0), Color = Color3.fromRGB(255, 200, 50), Material = Enum.Material.Foil, TopSurface = Enum.SurfaceType.Studs, Parent = parent })
	local center = pos + Vector3.new(0, 15, 0)
	makePart({ Name = "BalonGigante", Shape = Enum.PartType.Ball, Size = Vector3.new(14, 14, 14), Position = center, Color = Color3.new(1, 1, 1), Parent = parent })
	for _, dir in { Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0), Vector3.new(0, 1, 0), Vector3.new(0, 0, 1), Vector3.new(0, 0, -1), Vector3.new(0.7, 0.7, 0), Vector3.new(-0.7, 0.7, 0), Vector3.new(0, 0.7, 0.7), Vector3.new(0, 0.7, -0.7) } do
		makePart({ Name = "Mancha", Shape = Enum.PartType.Ball, Size = Vector3.new(4.5, 4.5, 4.5), Position = center + dir.Unit * 5.4, Color = Color3.fromRGB(25, 25, 30), CanCollide = false, Parent = parent })
	end
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(40, 9)
	billboard.StudsOffset = Vector3.new(0, 13, 0)
	billboard.LightInfluence = 0
	billboard.MaxDistance = 400
	billboard.Parent = parent:FindFirstChild("BalonGigante")
	local title = makeLabel(billboard, "⚽ PATEA EL BALÓN", UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), Color3.new(1, 1, 1))
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 220, 60)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 140, 40)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 80, 120)),
	})
	gradient.Parent = title
end

-- Colinas a cuadros detrás de las paredes con árboles arriba
local function buildHills(parent: Instance, rng: Random)
	local hills = {
		{ Size = Vector3.new(320, 80, 30), Position = Vector3.new(0, 38, -285) },
		{ Size = Vector3.new(400, 105, 40), Position = Vector3.new(0, 50, -320) },
		{ Size = Vector3.new(40, 85, 310), Position = Vector3.new(-150, 40, -135) },
		{ Size = Vector3.new(40, 85, 310), Position = Vector3.new(150, 40, -135) },
		{ Size = Vector3.new(50, 110, 380), Position = Vector3.new(-195, 53, -150) },
		{ Size = Vector3.new(50, 110, 380), Position = Vector3.new(195, 53, -150) },
	}
	for i, hill in hills do
		makePart({ Name = "Colina", Size = hill.Size, Position = hill.Position, Color = DIRT:Lerp(Color3.new(0, 0, 0), (i % 2) * 0.1), Material = Enum.Material.SmoothPlastic, Parent = parent })
		local top = hill.Position.Y + hill.Size.Y / 2
		makePart({ Name = "Pasto", Size = Vector3.new(hill.Size.X + 1, 4, hill.Size.Z + 1), Position = Vector3.new(hill.Position.X, top + 2, hill.Position.Z), Color = if i % 2 == 0 then GRASS_A else GRASS_TOP, Material = Enum.Material.SmoothPlastic, TopSurface = Enum.SurfaceType.Studs, Parent = parent })
		local trees = math.floor(math.max(hill.Size.X, hill.Size.Z) / 45)
		for _ = 1, trees do
			local tree = Instance.new("Model")
			tree.Name = "Arbol"
			local offset = Vector3.new(rng:NextNumber(-0.4, 0.4) * hill.Size.X, 0, rng:NextNumber(-0.4, 0.4) * hill.Size.Z)
			Decorations.Arbol(tree, Vector3.new(hill.Position.X, top + 4, hill.Position.Z) + offset, rng)
			tree.Parent = parent
		end
	end
end

-- ------------------------------------------------------------
-- Gimnasio
-- ------------------------------------------------------------
-- El gimnasio está al fondo del lobby, detrás del monumento: 6 estaciones en fila
local STATION_X = { -50, -30, -10, 10, 30, 50 }
local GYM_Z = -220

-- Cada aparato recibe `base` (en el piso, mirando hacia donde se para el jugador)
-- y pone las partes que se mueven al entrenar dentro del modelo "Peso".
local Equipment = {}

local function gymPart(parent: Instance, base: CFrame, size: Vector3, offset: CFrame, color: Color3, props: { [string]: any }?): Part
	local all: { [string]: any } = { Size = size, CFrame = base * offset, Color = color, Material = Enum.Material.SmoothPlastic, Parent = parent }
	if props then
		for key, value in props do
			all[key] = value
		end
	end
	return makePart(all)
end

local METAL = Color3.fromRGB(70, 75, 90)
local CYL = { Shape = Enum.PartType.Cylinder }

function Equipment.Mancuernas(model: Model, peso: Model, base: CFrame)
	gymPart(model, base, Vector3.new(8, 2.5, 3), CFrame.new(0, 1.25, 1), METAL)
	gymPart(peso, base, Vector3.new(4, 0.6, 0.6), CFrame.new(0, 3.3, 0.5), Color3.fromRGB(200, 200, 210), CYL)
	for _, x in { -1.8, 1.8 } do
		gymPart(peso, base, Vector3.new(0.8, 2.2, 2.2), CFrame.new(x, 3.3, 0.5), Color3.fromRGB(60, 140, 255), CYL)
	end
end

function Equipment.Barra(model: Model, peso: Model, base: CFrame)
	for _, x in { -4, 4 } do
		gymPart(model, base, Vector3.new(0.8, 9, 0.8), CFrame.new(x, 4.5, 1), METAL)
	end
	gymPart(peso, base, Vector3.new(10, 0.5, 0.5), CFrame.new(0, 6.5, 1), Color3.fromRGB(200, 200, 210), CYL)
	for _, x in { -4.8, 4.8 } do
		gymPart(peso, base, Vector3.new(0.8, 4, 4), CFrame.new(x, 6.5, 1), Color3.fromRGB(230, 60, 60), CYL)
	end
end

function Equipment.Prensa(model: Model, peso: Model, base: CFrame)
	gymPart(model, base, Vector3.new(4, 1.5, 7), CFrame.new(0, 0.75, -0.5), METAL)
	gymPart(model, base, Vector3.new(3.6, 4, 1), CFrame.new(0, 3, -3.5) * CFrame.Angles(math.rad(-20), 0, 0), Color3.fromRGB(40, 40, 50))
	for _, x in { -1.8, 1.8 } do
		gymPart(model, base, Vector3.new(0.6, 8, 0.6), CFrame.new(x, 4, 3), METAL)
	end
	for i = 0, 3 do
		gymPart(peso, base, Vector3.new(3, 0.6, 2.2), CFrame.new(0, 1.8 + i * 0.7, 3), if i == 3 then Color3.fromRGB(255, 150, 40) else Color3.fromRGB(35, 35, 40))
	end
end

function Equipment.Saco(model: Model, peso: Model, base: CFrame)
	gymPart(model, base, Vector3.new(1, 13, 1), CFrame.new(0, 6.5, 3), METAL)
	gymPart(model, base, Vector3.new(1, 1, 5), CFrame.new(0, 12.5, 1), METAL)
	gymPart(model, base, Vector3.new(0.2, 2.5, 0.2), CFrame.new(0, 10.8, -1), Color3.fromRGB(150, 150, 150))
	gymPart(peso, base, Vector3.new(6, 3.4, 3.4), CFrame.new(0, 6.6, -1) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(210, 40, 50), CYL)
end

function Equipment.Llantas(model: Model, peso: Model, base: CFrame)
	for i = 0, 1 do
		gymPart(model, base, Vector3.new(1.6, 6, 6), CFrame.new(-4.5, 0.8 + i * 1.6, 2) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(30, 30, 35), CYL)
	end
	gymPart(peso, base, Vector3.new(2.4, 7.5, 7.5), CFrame.new(1, 3.75, 1) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(30, 30, 35), CYL)
	gymPart(peso, base, Vector3.new(2.5, 4, 4), CFrame.new(1, 3.75, 1) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(255, 200, 50), CYL)
end

function Equipment.Dorada(model: Model, peso: Model, base: CFrame)
	local gold = Color3.fromRGB(255, 200, 50)
	gymPart(model, base, Vector3.new(10, 1, 6), CFrame.new(0, 0.5, 1), gold, { Material = Enum.Material.Foil })
	for _, x in { -4.4, 4.4 } do
		gymPart(model, base, Vector3.new(1, 10, 1), CFrame.new(x, 5.5, 1), Color3.fromRGB(80, 220, 255), { Material = Enum.Material.Neon })
	end
	gymPart(peso, base, Vector3.new(10, 0.6, 0.6), CFrame.new(0, 6.5, 1), gold, { Shape = Enum.PartType.Cylinder, Material = Enum.Material.Foil })
	for _, x in { -3.6, 3.6 } do
		gymPart(peso, base, Vector3.new(0.9, 4.5, 4.5), CFrame.new(x, 6.5, 1), Color3.fromRGB(190, 90, 255), { Shape = Enum.PartType.Cylinder, Material = Enum.Material.Neon })
	end
end

local STATION_COLORS = { Color3.fromRGB(70, 160, 255), Color3.fromRGB(80, 220, 90), Color3.fromRGB(255, 200, 50), Color3.fromRGB(255, 140, 40), Color3.fromRGB(230, 60, 70), Color3.fromRGB(190, 90, 255) }

local function buildGym(parent: Instance)
	local gym = Instance.new("Folder")
	gym.Name = "Gimnasio"
	gym.Parent = parent

	makePart({ Name = "PisoGimnasio", Size = Vector3.new(128, 0.4, 36), Position = Vector3.new(0, 0.2, GYM_Z), Color = Color3.fromRGB(55, 65, 90), TopSurface = Enum.SurfaceType.Studs, Parent = gym })
	for _, dz in { -18.5, 18.5 } do
		makePart({ Name = "Borde", Size = Vector3.new(128, 0.6, 1), Position = Vector3.new(0, 0.3, GYM_Z + dz), Color = Color3.fromRGB(255, 200, 50), Parent = gym })
	end
	local signAnchor = makePart({ Name = "Letrero", Size = Vector3.one, Position = Vector3.new(0, 24, GYM_Z - 6), Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false, Parent = gym })
	local sign = Instance.new("BillboardGui")
	sign.Size = UDim2.fromScale(34, 8)
	sign.LightInfluence = 0
	sign.MaxDistance = 400
	sign.Parent = signAnchor
	makeLabel(sign, "🏋️ GIMNASIO", UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), Color3.fromRGB(255, 220, 80))

	for index, x in STATION_X do
		local info = Config.TrainingStations[index]
		if not info then
			continue
		end
		local station = Instance.new("Model")
		station.Name = "Estacion" .. index
		station:SetAttribute("Index", index)

		local standPos = Vector3.new(x, 0.4, GYM_Z + 6)
		local equipPos = Vector3.new(x, 0.4, GYM_Z - 6)
		local base = CFrame.lookAt(equipPos, Vector3.new(standPos.X, equipPos.Y, standPos.Z))

		local peso = Instance.new("Model")
		peso.Name = "Peso"
		peso.Parent = station
		Equipment[info.Equipment](station, peso, base)

		-- Tapete donde se para el jugador
		local mat = makePart({ Name = "Tapete", Size = Vector3.new(6, 0.2, 6), Position = standPos + Vector3.new(0, 0.1, 0), Color = STATION_COLORS[index], TopSurface = Enum.SurfaceType.Studs, CanCollide = false, Parent = station })
		local stand = makePart({ Name = "Punto", Size = Vector3.one, CFrame = CFrame.lookAt(standPos + Vector3.new(0, 3, 0), Vector3.new(equipPos.X, standPos.Y + 3, equipPos.Z)), Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false, Parent = station })
		stand.Name = "Punto"
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "Entrenar"
		prompt.ActionText = "Entrenar"
		prompt.ObjectText = info.Name
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.MaxActivationDistance = 9
		prompt.RequiresLineOfSight = false
		prompt.Parent = mat

		local labelAnchor = makePart({ Name = "Etiqueta", Size = Vector3.one, Position = equipPos + Vector3.new(0, 15, 0), Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false, Parent = station })
		local billboard = Instance.new("BillboardGui")
		billboard.Size = UDim2.fromScale(14, 6)
		billboard.LightInfluence = 0
		billboard.MaxDistance = 120
		billboard.Parent = labelAnchor
		makeLabel(billboard, info.Name, UDim2.fromScale(1, 0.4), UDim2.fromScale(0, 0), Color3.new(1, 1, 1))
		makeLabel(billboard, "+" .. info.Gain .. " 💪 por repetición", UDim2.fromScale(1, 0.3), UDim2.fromScale(0, 0.4), Color3.fromRGB(120, 255, 120))
		makeLabel(
			billboard,
			if info.Required > 0 then "Requiere " .. Config.FormatShort(info.Required) .. " 💪" else "¡Para todos!",
			UDim2.fromScale(1, 0.3),
			UDim2.fromScale(0, 0.7),
			STATION_COLORS[index]
		)
		station.Parent = gym
	end
end

-- Línea de patada: al cruzarla aparece la barra de poder
local function buildKickLine(parent: Instance)
	local half = Config.KICK_ZONE_HALF_WIDTH
	local z = Config.KICK_LINE_Z
	makePart({ Name = "LineaDePatada", Size = Vector3.new(half * 2, 0.3, 1.6), Position = Vector3.new(0, 0.15, z), Color = Color3.new(1, 1, 1), Material = Enum.Material.Neon, CanCollide = false, Parent = parent })
	makePart({ Name = "ZonaDePatada", Size = Vector3.new(half * 2, 0.24, -z + 6), Position = Vector3.new(0, 0.12, (z + 6) / 2), Color = Color3.fromRGB(120, 255, 150), Material = Enum.Material.Neon, Transparency = 0.8, CanCollide = false, Parent = parent })
	for side = -1, 1, 2 do
		makePart({ Name = "PosteLinea", Size = Vector3.new(1.2, 6, 1.2), Position = Vector3.new(side * (half + 1), 3, z), Color = Color3.new(1, 1, 1), Material = Enum.Material.Neon, Parent = parent })
	end
	local anchor = makePart({ Name = "Aviso", Size = Vector3.one, Position = Vector3.new(0, 7, z - 1), Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false, Parent = parent })
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(22, 3.5)
	billboard.LightInfluence = 0
	billboard.MaxDistance = 200
	billboard.Parent = anchor
	makeLabel(billboard, "⚽ Cruza la línea para patear", UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), Color3.new(1, 1, 1))
end

local function decorateLobby(lobby: Instance, rng: Random)
	-- Camino de baldosas naranjas y amarillas del spawn al punto de patada
	local tile = 12
	for row = 0, 11 do
		for col = 0, 1 do
			makePart({
				Name = "Camino",
				Size = Vector3.new(tile, 0.2, tile),
				Position = Vector3.new(-tile / 2 + col * tile, 0.1, -10 - tile * (row + 0.5)),
				Color = if (row + col) % 2 == 0 then Color3.fromRGB(255, 160, 45) else Color3.fromRGB(255, 205, 70),
				Material = Enum.Material.SmoothPlastic,
				TopSurface = Enum.SurfaceType.Studs,
				Parent = lobby,
			})
		end
	end
	for _, z in { -30, -62, -94, -126 } do
		buildBunting(lobby, z, 18)
	end
	for _, z in { -46, -78, -110, -142 } do
		buildLamp(lobby, Vector3.new(-18, 0, z))
		buildLamp(lobby, Vector3.new(18, 0, z))
	end
	buildStall(lobby, Vector3.new(-32, 0, -160), Vector3.new(1, 0, 0.4), Color3.fromRGB(230, 60, 70), "🛒 TIENDA", "AbrirTienda", "Abrir tienda")
	buildStall(lobby, Vector3.new(32, 0, -160), Vector3.new(-1, 0, 0.4), Color3.fromRGB(60, 120, 240), "📖 ÍNDICE", "AbrirIndice", "Ver índice")
	buildMonument(lobby, Vector3.new(0, 0, -170))
	buildGym(lobby)
	buildKickLine(lobby)
	for _, x in { -104, 104 } do
		for z = -20, -250, -25 do
			buildBush(lobby, Vector3.new(x, 0, z), rng)
		end
	end
	for _, x in { -60, -82, 60, 82 } do
		buildBush(lobby, Vector3.new(x, 0, -254), rng)
	end
end

local function buildLobby(map: Folder)
	local lobby = Instance.new("Folder")
	lobby.Name = "Lobby"
	lobby.Parent = map
	local rng = Random.new(42)

	-- Piso a cuadros verde brillante con relieve
	local cols = math.ceil(LOBBY_HALF_WIDTH * 2 / TILE)
	local rows = math.ceil(LOBBY_DEPTH / TILE)
	for c = 0, cols - 1 do
		for r = 0, rows - 1 do
			makePart({
				Name = "Piso",
				Size = Vector3.new(TILE, 2, TILE),
				Position = Vector3.new(-LOBBY_HALF_WIDTH + TILE * (c + 0.5), -1, -TILE * (r + 0.5)),
				Color = if (c + r) % 2 == 0 then GRASS_A else GRASS_B,
				Material = Enum.Material.SmoothPlastic,
				TopSurface = Enum.SurfaceType.Studs,
				Parent = lobby,
			})
		end
	end

	-- Paredes de tierra con pasto arriba
	local function wall(size: Vector3, position: Vector3)
		makePart({ Name = "Pared", Size = size, Position = position, Color = DIRT, Material = Enum.Material.SmoothPlastic, TopSurface = Enum.SurfaceType.Studs, Parent = lobby })
		makePart({
			Name = "Pasto",
			Size = Vector3.new(size.X + 1, 4, size.Z + 1),
			Position = position + Vector3.new(0, size.Y / 2 + 2, 0),
			Color = GRASS_TOP,
			Material = Enum.Material.SmoothPlastic,
			TopSurface = Enum.SurfaceType.Studs,
			Parent = lobby,
		})
	end
	local wallHeight = 60
	wall(Vector3.new(LOBBY_HALF_WIDTH * 2 + 40, wallHeight, 10), Vector3.new(0, wallHeight / 2 - 2, -LOBBY_DEPTH - 5))
	for side = -1, 1, 2 do
		wall(Vector3.new(20, wallHeight, LOBBY_DEPTH + 10), Vector3.new(side * (LOBBY_HALF_WIDTH + 10), wallHeight / 2 - 2, -LOBBY_DEPTH / 2 - 5))
	end

	-- Árboles y flores
	for _, pos in { Vector3.new(-100, 0, -252), Vector3.new(100, 0, -252), Vector3.new(-100, 0, -175), Vector3.new(100, 0, -175) } do
		local tree = Instance.new("Model")
		tree.Name = "Arbol"
		Decorations.Arbol(tree, pos, rng)
		tree.Parent = lobby
	end
	for _, pos in { Vector3.new(-25, 0, -130), Vector3.new(25, 0, -130), Vector3.new(-22, 0, -20), Vector3.new(22, 0, -20) } do
		flowers(lobby, pos, rng)
	end

	decorateLobby(lobby, rng)
	buildHills(lobby, rng)

	-- Corrales
	for index, center in MapBuilder.PEN_CENTERS do
		buildPen(map, index, center)
	end

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = Vector3.new(14, 1, 14)
	spawn.Position = Vector3.new(0, 0.5, -150)
	spawn.Color = Color3.fromRGB(60, 170, 255)
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.TopSurface = Enum.SurfaceType.Studs
	spawn.Parent = map

	-- Punto de patada (círculo blanco) con un arco dorado
	local kickSpot = makePart({
		Name = "PuntoDePatada",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 16, 16),
		CFrame = CFrame.new(0, 0.15, -2) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.new(1, 1, 1),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		Parent = map,
	})
	local arch = Color3.fromRGB(255, 210, 60)
	for side = -1, 1, 2 do
		makePart({ Name = "Arco", Size = Vector3.new(3, 22, 3), Position = Vector3.new(side * 14, 11, -2), Color = arch, Material = Enum.Material.SmoothPlastic, TopSurface = Enum.SurfaceType.Studs, Parent = map })
		makePart({ Name = "Gema", Size = Vector3.new(4, 4, 4), CFrame = CFrame.new(side * 14, 24, -2) * CFrame.Angles(0, math.rad(45), math.rad(45)), Color = Color3.fromRGB(80, 220, 255), Material = Enum.Material.Neon, Parent = map })
	end
	makePart({ Name = "Arco", Size = Vector3.new(31, 3, 3), Position = Vector3.new(0, 21.5, -2), Color = arch, Material = Enum.Material.SmoothPlastic, Parent = map })

	local kickSign = Instance.new("BillboardGui")
	kickSign.Size = UDim2.fromScale(24, 6)
	kickSign.StudsOffset = Vector3.new(0, 30, 0)
	kickSign.LightInfluence = 0
	kickSign.Parent = kickSpot
	makeLabel(kickSign, "⚽ ¡PATEA AQUÍ!", UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), Color3.fromRGB(255, 230, 80))
end

-- Planetas en el cielo, justo en el camino del balón cuando se va al espacio
local function buildSpace(map: Folder)
	local space = Instance.new("Folder")
	space.Name = "Espacio"
	space.Parent = map
	local planets = Instance.new("Folder")
	planets.Name = "Planetas"
	planets.Parent = space
	local rng = Random.new(2024)
	local colors = {
		Color3.fromRGB(255, 140, 60),
		Color3.fromRGB(110, 170, 255),
		Color3.fromRGB(200, 100, 255),
		Color3.fromRGB(255, 215, 90),
		Color3.fromRGB(90, 230, 170),
	}
	for i, alpha in Config.SPACE_PLANET_STOPS do
		local center = Config.GetSpacePoint(alpha, workspace.Gravity) + Vector3.new(rng:NextNumber(-6, 6), 0, 0)
		local size = rng:NextNumber(45, 80)
		local planet = Instance.new("Model")
		planet.Name = "Planeta" .. i
		local body = makePart({
			Name = "Cuerpo",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(size, size, size),
			Position = center,
			Color = colors[(i - 1) % #colors + 1],
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			Parent = planet,
		})
		if i % 2 == 1 then
			makePart({
				Name = "Anillo",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(0.6, size * 1.8, size * 1.8),
				CFrame = CFrame.new(center) * CFrame.Angles(rng:NextNumber(-0.4, 0.4), 0, math.rad(90) + rng:NextNumber(-0.3, 0.3)),
				Color = Color3.fromRGB(235, 225, 255),
				Material = Enum.Material.Neon,
				Transparency = 0.4,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
				Parent = planet,
			})
		end
		planet.PrimaryPart = body
		planet:SetAttribute("Radius", size / 2)
		planet.Parent = planets
	end
	for _ = 1, 70 do
		makePart({
			Name = "Estrella",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(3, 3, 3),
			Position = Vector3.new(rng:NextNumber(-500, 500), rng:NextNumber(500, 1300), rng:NextNumber(-200, 3200)),
			Color = Color3.new(1, 1, 1),
			Material = Enum.Material.Neon,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			Parent = space,
		})
	end
end

-- Cielo azul con nubes, sol y colores más vivos
function MapBuilder.SetupSky()
	local Lighting = game:GetService("Lighting")
	Lighting.ClockTime = 13.5
	Lighting.Brightness = 3
	Lighting.Ambient = Color3.fromRGB(120, 125, 140)
	Lighting.OutdoorAmbient = Color3.fromRGB(165, 170, 185)
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.3

	local function ensure(className: string, parent: Instance): any
		local existing = parent:FindFirstChildOfClass(className)
		if existing then
			return existing
		end
		local obj = Instance.new(className)
		obj.Parent = parent
		return obj
	end

	local sky = ensure("Sky", Lighting) :: Sky
	sky.SunAngularSize = 14
	sky.CelestialBodiesShown = true

	local atmosphere = ensure("Atmosphere", Lighting) :: Atmosphere
	atmosphere.Density = 0.22
	atmosphere.Offset = 0.2
	atmosphere.Color = Color3.fromRGB(190, 225, 255)
	atmosphere.Decay = Color3.fromRGB(110, 170, 235)
	atmosphere.Glare = 0.25
	atmosphere.Haze = 1

	local terrain = workspace:FindFirstChildOfClass("Terrain")
	if terrain then
		local clouds = ensure("Clouds", terrain) :: Clouds
		clouds.Cover = 0.55
		clouds.Density = 0.75
		clouds.Color = Color3.new(1, 1, 1)
	end

	local color = ensure("ColorCorrectionEffect", Lighting) :: ColorCorrectionEffect
	color.Saturation = 0.25
	color.Contrast = 0.08
	color.Brightness = 0.02
	color.TintColor = Color3.fromRGB(255, 252, 245)

	local bloom = ensure("BloomEffect", Lighting) :: BloomEffect
	bloom.Intensity = 0.5
	bloom.Size = 24
	bloom.Threshold = 1.5

	local rays = ensure("SunRaysEffect", Lighting) :: SunRaysEffect
	rays.Intensity = 0.06
	rays.Spread = 0.6
end

function MapBuilder.Build(): Folder
	-- Si el lugar ya tiene otros spawns (plantilla Baseplate), los desactivamos
	for _, obj in workspace:GetDescendants() do
		if obj:IsA("SpawnLocation") then
			obj.Enabled = false
		end
	end

	local old = workspace:FindFirstChild("Mapa")
	if old then
		old:Destroy()
	end

	local map = Instance.new("Folder")
	map.Name = "Mapa"

	buildLobby(map)
	for zone = 1, Config.NUM_ZONES do
		buildZone(map, zone)
	end
	buildGoal(map)
	buildSpace(map)
	map.Parent = workspace

	for _, name in { "Balones" } do
		if not workspace:FindFirstChild(name) then
			local folder = Instance.new("Folder")
			folder.Name = name
			folder.Parent = workspace
		end
	end

	return map
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">PlotManager</string>
          <string name="Source"><![CDATA[-- Corrales: cada jugador recibe uno. Ahí caminan sus futbolistas, se junta el dinero
-- (se cobra pisando el plato dorado) y se mejoran los espacios con el cartel.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local FootballerLook = require(ReplicatedStorage.Shared.FootballerLook)

local PlotManager = {}

type Plot = {
	Model: Model,
	Owner: Player?,
}

export type Callbacks = {
	GetData: (Player) -> any,
	OnCollect: (Player, number) -> (),
	OnUpgrade: (Player) -> (),
}

local plots: { Plot } = {}
local plotOf: { [Player]: Plot } = {}
local callbacks: Callbacks
local template: Model
local templateLift = 3

local function setSignTexts(plot: Plot)
	local pen = plot.Model
	local owner = plot.Owner
	local data = owner and callbacks.GetData(owner)

	local nameLabel = pen.Letrero.Nombre.Texto :: TextLabel
	nameLabel.Text = if owner then "⚽ Plantilla de " .. owner.DisplayName else "Corral libre"

	local sign = pen.CartelMejora
	for _, face in { "TextoFront", "TextoBack" } do
		local surface = sign:FindFirstChild(face)
		if surface then
			local slotsLabel = surface.Espacios :: TextLabel
			local priceLabel = surface.Precio :: TextLabel
			if not data then
				slotsLabel.Text = "🐾 Plantilla"
				priceLabel.Text = ""
			elseif data.Slots >= Config.MAX_SLOTS then
				slotsLabel.Text = "🐾 " .. data.Slots .. " (MÁX)"
				priceLabel.Text = ""
			else
				slotsLabel.Text = string.format("🐾 %d > %d", data.Slots, data.Slots + 1)
				priceLabel.Text = "💰 " .. Config.FormatShort(Config.GetSlotCost(data.Slots))
			end
		end
	end
	(sign.Mejorar :: ProximityPrompt).Enabled = owner ~= nil

	local amount = pen.Cobrar.Dinero.Cantidad :: TextLabel
	amount.Text = "💰 " .. Config.FormatShort(if data then data.Unclaimed else 0)
end

local function randomSpot(pen: Model): Vector3
	local center = pen:GetAttribute("Center") :: Vector3
	local size = pen:GetAttribute("Size") :: Vector3
	local margin = 4
	return Vector3.new(
		center.X + (math.random() - 0.5) * (size.X - margin * 2),
		0,
		center.Z + (math.random() - 0.5) * (size.Z - margin * 2)
	)
end

local function createFootballer(f: Config.Footballer, pen: Model): Model
	local model = template:Clone()
	model.Name = f.Name
	model:SetAttribute("Id", f.Id)
	FootballerLook.Dress(model, f)

	local rarity = Config.Rarities[f.Rarity]
	local head = model:FindFirstChild("Head") or model.PrimaryPart
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(8, 2.4)
	billboard.StudsOffset = Vector3.new(0, 3.2, 0)
	billboard.LightInfluence = 0
	billboard.MaxDistance = 90
	billboard.Parent = head
	for i, info in { { f.Name, rarity.Color }, { "💰 " .. Config.FormatShort(f.Income) .. "/s", Color3.fromRGB(120, 255, 120) } } do
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 0.5)
		label.Position = UDim2.fromScale(0, (i - 1) * 0.5)
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextStrokeTransparency = 0
		label.Text = info[1]
		label.TextColor3 = info[2]
		label.Parent = billboard
	end

	local spot = randomSpot(pen)
	model:PivotTo(CFrame.new(spot.X, templateLift, spot.Z) * CFrame.Angles(0, math.random() * math.pi * 2, 0))
	model.Parent = pen.Futbolistas
	return model
end

-- Deja en el corral exactamente a los futbolistas de la plantilla
function PlotManager.Sync(player: Player)
	local plot = plotOf[player]
	local data = callbacks.GetData(player)
	if not plot or not data then
		return
	end
	local wanted: { [string]: number } = {}
	for _, id in data.Squad do
		wanted[id] = (wanted[id] or 0) + 1
	end
	local folder = plot.Model.Futbolistas
	for _, model in folder:GetChildren() do
		local id = model:GetAttribute("Id")
		if id and (wanted[id] or 0) > 0 then
			wanted[id] -= 1
		else
			model:Destroy()
		end
	end
	for id, count in wanted do
		local f = Config.GetFootballer(id)
		if f then
			for _ = 1, count do
				createFootballer(f, plot.Model)
			end
		end
	end
	setSignTexts(plot)
end

function PlotManager.HasPlot(player: Player): boolean
	return plotOf[player] ~= nil
end

-- Solo actualiza los textos (se llama cada segundo)
function PlotManager.Refresh(player: Player)
	local plot = plotOf[player]
	if plot then
		setSignTexts(plot)
	end
end

function PlotManager.Assign(player: Player)
	for _, plot in plots do
		if not plot.Owner then
			plot.Owner = player
			plotOf[player] = plot
			PlotManager.Sync(player)
			return
		end
	end
	-- Sin corral libre: el dinero se cobra solo (ver Main)
end

function PlotManager.Release(player: Player)
	local plot = plotOf[player]
	if not plot then
		return
	end
	plotOf[player] = nil
	plot.Owner = nil
	plot.Model.Futbolistas:ClearAllChildren()
	setSignTexts(plot)
end

local function ownerOfPart(part: BasePart): Player?
	local character = part:FindFirstAncestorOfClass("Model")
	return character and Players:GetPlayerFromCharacter(character)
end

function PlotManager.Init(map: Folder, rigTemplate: Model, cb: Callbacks)
	callbacks = cb
	template = rigTemplate

	-- Cuánto hay que subir el modelo para que sus pies toquen el piso (y = 0)
	local probe = template:Clone()
	probe:PivotTo(CFrame.new())
	local box, size = probe:GetBoundingBox()
	templateLift = -(box.Position.Y - size.Y / 2) + 0.4 -- + el piso del corral
	probe:Destroy()

	local index = 1
	while map:FindFirstChild("Corral" .. index) do
		local pen = map:FindFirstChild("Corral" .. index) :: Model
		local plot: Plot = { Model = pen, Owner = nil }
		table.insert(plots, plot)

		local debounce: { [Player]: number } = {}
		pen.Cobrar.Touched:Connect(function(hit)
			local player = ownerOfPart(hit)
			if not player or plot.Owner ~= player then
				return
			end
			if debounce[player] and os.clock() - debounce[player] < 1 then
				return
			end
			debounce[player] = os.clock()
			local data = callbacks.GetData(player)
			if data and data.Unclaimed > 0 then
				local amount = data.Unclaimed
				data.Unclaimed = 0
				data.Coins += amount
				callbacks.OnCollect(player, amount)
				setSignTexts(plot)
			end
		end)

		pen.CartelMejora.Mejorar.Triggered:Connect(function(player)
			if plot.Owner == player then
				callbacks.OnUpgrade(player)
			end
		end)

		setSignTexts(plot)
		index += 1
	end

	Players.PlayerRemoving:Connect(PlotManager.Release)
end

return PlotManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Scenery</string>
          <string name="Source"><![CDATA[-- Escenarios a los lados del campo. Cada zona tiene el suyo (ver Config.Zones)
-- y van mejorando: barrios -> ciudad -> playa -> estadios -> lujo -> leyenda.
--
-- Cada constructor recibe el lado (-1 izquierda, 1 derecha) y arma cosas en un
-- terreno de LOT studs de ancho por ZONE_LENGTH de largo. Usamos coordenadas
-- locales: `spot(x, z)` da un CFrame en el piso, a `x` studs del borde del campo y
-- `z` studs desde el inicio de la zona, mirando hacia el campo.
-- OJO con los ejes locales de `spot`: X local = a lo largo de la zona,
-- Z local = alejándose del campo (el frente, -Z, mira al campo).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local Scenery = {}

local W = Config.FIELD_WIDTH
local L = Config.ZONE_LENGTH
Scenery.EDGE = W / 2 + 3 -- donde empieza el terreno de cada lado
Scenery.LOT = 92 -- ancho del terreno

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local WHITE = Color3.new(1, 1, 1)
local DARK = rgb(40, 40, 48)
local GLASS = rgb(160, 210, 245)
local WOOD = rgb(150, 100, 60)
local GOLD = rgb(255, 200, 50)
local CYL = Enum.PartType.Cylinder
local BALL = Enum.PartType.Ball
local NEON = Enum.Material.Neon
local FOIL = Enum.Material.Foil

-- Estado del constructor actual
local current: Instance = workspace
local side = 1
local startZ = 0
local rng = Random.new()

local function make(className: string, size: Vector3, cf: CFrame, color: Color3, props: { [string]: any }?): BasePart
	local p = Instance.new(className) :: BasePart
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	if props and props.Shape then
		(p :: any).Shape = props.Shape
	end
	p.Size = size
	p.CFrame = cf
	p.Color = color
	if props then
		for key, value in props do
			if key ~= "Shape" then
				(p :: any)[key] = value
			end
		end
	end
	p.Parent = current
	return p
end

local function P(size: Vector3, cf: CFrame, color: Color3, props: { [string]: any }?): BasePart
	return make("Part", size, cf, color, props)
end

local function Wedge(size: Vector3, cf: CFrame, color: Color3, props: { [string]: any }?): BasePart
	return make("WedgePart", size, cf, color, props)
end

-- Cilindro de pie (los cilindros de Roblox van a lo largo del eje X)
local function column(cf: CFrame, height: number, diameter: number, color: Color3, props: { [string]: any }?): BasePart
	local all: { [string]: any } = { Shape = CYL }
	if props then
		for key, value in props do
			all[key] = value
		end
	end
	return P(Vector3.new(height, diameter, diameter), cf * CFrame.new(0, height / 2, 0) * CFrame.Angles(0, 0, math.rad(90)), color, all)
end

-- Disco acostado (para fuentes, albercas redondas, platos)
local function disc(pos: Vector3, thickness: number, diameter: number, color: Color3, props: { [string]: any }?): BasePart
	local all: { [string]: any } = { Shape = CYL }
	if props then
		for key, value in props do
			all[key] = value
		end
	end
	return P(Vector3.new(thickness, diameter, diameter), CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)), color, all)
end

local function ball(pos: Vector3, diameter: number, color: Color3, props: { [string]: any }?): BasePart
	local all: { [string]: any } = { Shape = BALL }
	if props then
		for key, value in props do
			all[key] = value
		end
	end
	return P(Vector3.new(diameter, diameter, diameter), CFrame.new(pos), color, all)
end

-- CFrame en el piso del terreno, mirando hacia el campo
local function spot(x: number, z: number, y: number?): CFrame
	local pos = Vector3.new(side * (Scenery.EDGE + x), y or 0, startZ + z)
	return CFrame.lookAt(pos, pos + Vector3.new(-side, 0, 0))
end

-- Lado de los edificios que ve la cámara (la cámara mira hacia +Z)
local function cameraSide(): number
	return side
end

local function pick<T>(list: { T }): T
	return list[rng:NextInteger(1, #list)]
end

local function text(part: BasePart, face: Enum.NormalId, value: string, color: Color3, pixelsPerStud: number?)
	local surface = Instance.new("SurfaceGui")
	surface.Face = face
	surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	surface.PixelsPerStud = pixelsPerStud or 20
	surface.LightInfluence = 0
	surface.Parent = part
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(0.94, 0.86)
	label.Position = UDim2.fromScale(0.03, 0.07)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.3
	label.Text = value
	label.Parent = surface
end

-- ============================================================
-- Piezas reutilizables
-- ============================================================
local function tree(pos: Vector3, kind: string?)
	if kind == "Palmera" then
		local h = rng:NextInteger(14, 20)
		P(Vector3.new(1.6, h, 1.6), CFrame.new(pos + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, rng:NextNumber(-0.08, 0.08)), rgb(160, 120, 70), { Material = Enum.Material.Wood })
		for i = 0, 3 do
			local angle = i * math.pi / 2 + rng:NextNumber(0, 0.4)
			P(Vector3.new(2.5, 0.6, 9), CFrame.new(pos + Vector3.new(0, h, 0)) * CFrame.Angles(0, angle, 0) * CFrame.new(0, -0.8, -4) * CFrame.Angles(math.rad(-15), 0, 0), rgb(60, 170, 60))
		end
		return
	elseif kind == "Pino" then
		P(Vector3.new(1.6, 4, 1.6), CFrame.new(pos + Vector3.new(0, 2, 0)), rgb(100, 70, 45), { Material = Enum.Material.Wood })
		local y = 4
		for _, width in { 9, 7, 5, 3 } do
			P(Vector3.new(width, 2.5, width), CFrame.new(pos + Vector3.new(0, y + 1.25, 0)), rgb(40, 130, 70))
			y += 2.6
		end
		return
	end
	local h = rng:NextInteger(7, 12)
	P(Vector3.new(2, h, 2), CFrame.new(pos + Vector3.new(0, h / 2, 0)), rgb(110, 70, 40), { Material = Enum.Material.Wood })
	local green = rgb(rng:NextInteger(60, 100), rng:NextInteger(165, 210), rng:NextInteger(50, 80))
	P(Vector3.new(10, 5, 10), CFrame.new(pos + Vector3.new(0, h + 1.5, 0)), green)
	P(Vector3.new(6, 4, 6), CFrame.new(pos + Vector3.new(0, h + 5.5, 0)), green)
end

local function bush(pos: Vector3, color: Color3?)
	local c = color or rgb(60, 170, 60)
	for _ = 1, 2 do
		local size = rng:NextNumber(3, 4.5)
		ball(pos + Vector3.new(rng:NextNumber(-1.5, 1.5), size / 2 - 0.4, rng:NextNumber(-1.5, 1.5)), size, c)
	end
end

local function lamp(pos: Vector3, color: Color3?)
	P(Vector3.new(0.8, 11, 0.8), CFrame.new(pos + Vector3.new(0, 5.5, 0)), DARK)
	ball(pos + Vector3.new(0, 11.6, 0), 2.2, color or rgb(255, 235, 160), { Material = NEON })
end

local function car(cf: CFrame, color: Color3, sport: boolean?)
	if sport then
		P(Vector3.new(4.8, 1.2, 10), cf * CFrame.new(0, 1.1, 0), color, { Material = Enum.Material.SmoothPlastic })
		P(Vector3.new(4, 1.1, 3.6), cf * CFrame.new(0, 2.2, 0.8), rgb(30, 35, 50))
		P(Vector3.new(4.8, 0.3, 1.2), cf * CFrame.new(0, 2.6, 4.6), DARK)
	else
		P(Vector3.new(4.6, 1.6, 9), cf * CFrame.new(0, 1.3, 0), color)
		P(Vector3.new(4.2, 1.5, 4.6), cf * CFrame.new(0, 2.85, 0.5), rgb(60, 75, 100))
	end
	for _, x in { -2.3, 2.3 } do
		for _, z in { -3, 3 } do
			P(Vector3.new(0.8, 2, 2), cf * CFrame.new(x, 1, z), DARK, { Shape = CYL })
		end
	end
end

-- Casa con techo de dos aguas (o plano). w = ancho (lado al campo), d = fondo
local function house(cf: CFrame, w: number, d: number, h: number, wall: Color3, roof: Color3, opts: { [string]: any }?)
	local o = opts or {}
	P(Vector3.new(w, h, d), cf * CFrame.new(0, h / 2, 0), wall, { Material = o.material or Enum.Material.SmoothPlastic })
	if o.flat then
		P(Vector3.new(w + 1, 1, d + 1), cf * CFrame.new(0, h + 0.5, 0), roof)
	else
		local rh = o.roofHeight or math.min(w, d) * 0.35
		-- la parte alta de una cuña está atrás (+Z): las dos mitades se juntan en el centro
		Wedge(Vector3.new(w + 1, rh, d / 2 + 0.5), cf * CFrame.new(0, h + rh / 2, -d / 4), roof)
		Wedge(Vector3.new(w + 1, rh, d / 2 + 0.5), cf * CFrame.new(0, h + rh / 2, d / 4) * CFrame.Angles(0, math.pi, 0), roof)
	end
	P(Vector3.new(3, 5, 0.3), cf * CFrame.new(0, 2.5, -d / 2 - 0.15), o.door or rgb(110, 70, 45))
	local floors = o.floors or 1
	local fh = h / floors
	for f = 1, floors do
		local y = (f - 1) * fh + fh * 0.6
		for _, x in { -w / 3.2, w / 3.2 } do
			if f > 1 or math.abs(x) > 2.5 then
				P(Vector3.new(2.4, 2.4, 0.3), cf * CFrame.new(x, y, -d / 2 - 0.1), o.window or GLASS)
			end
		end
		P(Vector3.new(0.3, 2.4, 2.6), cf * CFrame.new(cameraSide() * (w / 2 + 0.1), y, 0), o.window or GLASS)
	end
end

-- Edificio de varios pisos con franjas de ventanas
local function building(cf: CFrame, w: number, d: number, floors: number, color: Color3, windowColor: Color3, opts: { [string]: any }?)
	local o = opts or {}
	local h = floors * 5
	P(Vector3.new(w, h, d), cf * CFrame.new(0, h / 2, 0), color, { Material = o.material or Enum.Material.SmoothPlastic })
	P(Vector3.new(w + 0.8, 0.8, d + 0.8), cf * CFrame.new(0, h + 0.4, 0), color:Lerp(Color3.new(0, 0, 0), 0.25), { Material = o.material or Enum.Material.SmoothPlastic })
	for f = 1, floors do
		local y = (f - 1) * 5 + 2.8
		P(Vector3.new(w - 2, 2.4, 0.3), cf * CFrame.new(0, y, -d / 2 - 0.1), windowColor, { Material = o.windowMaterial or Enum.Material.SmoothPlastic })
		P(Vector3.new(0.3, 2.4, d - 2), cf * CFrame.new(cameraSide() * (w / 2 + 0.1), y, 0), windowColor, { Material = o.windowMaterial or Enum.Material.SmoothPlastic })
	end
	P(Vector3.new(4, 5.5, 0.3), cf * CFrame.new(0, 2.75, -d / 2 - 0.15), o.door or rgb(60, 70, 90))
	if o.antenna then
		P(Vector3.new(0.5, 8, 0.5), cf * CFrame.new(w / 4, h + 4.8, d / 4), DARK)
		ball((cf * CFrame.new(w / 4, h + 9, d / 4)).Position, 1, rgb(255, 60, 60), { Material = NEON })
	end
end

local function goal(cf: CFrame, width: number, height: number)
	for _, x in { -width / 2, width / 2 } do
		P(Vector3.new(0.5, height, 0.5), cf * CFrame.new(x, height / 2, 0), WHITE)
	end
	P(Vector3.new(width + 0.5, 0.5, 0.5), cf * CFrame.new(0, height, 0), WHITE)
	P(Vector3.new(width, height, 0.1), cf * CFrame.new(0, height / 2, 2.5), WHITE, { Transparency = 0.6, Material = Enum.Material.ForceField })
end

local function bench(cf: CFrame)
	P(Vector3.new(5, 0.4, 1.6), cf * CFrame.new(0, 1.6, 0), WOOD, { Material = Enum.Material.Wood })
	P(Vector3.new(5, 1.4, 0.3), cf * CFrame.new(0, 2.6, 0.7), WOOD, { Material = Enum.Material.Wood })
	for _, x in { -2, 2 } do
		P(Vector3.new(0.4, 1.4, 1.4), cf * CFrame.new(x, 0.7, 0), DARK)
	end
end

local function umbrella(pos: Vector3, color: Color3)
	P(Vector3.new(0.3, 7, 0.3), CFrame.new(pos + Vector3.new(0, 3.5, 0)), WHITE)
	disc(pos + Vector3.new(0, 7, 0), 0.5, 7, color)
	ball(pos + Vector3.new(0, 7.3, 0), 1, WHITE)
end

local function fountain(pos: Vector3, scale: number?)
	local s = scale or 1
	disc(pos + Vector3.new(0, 0.6 * s, 0), 1.2 * s, 14 * s, rgb(210, 210, 220))
	disc(pos + Vector3.new(0, 1.25 * s, 0), 0.2, 12 * s, rgb(80, 180, 240), { Material = Enum.Material.Glass, Transparency = 0.2 })
	P(Vector3.new(1.4 * s, 5 * s, 1.4 * s), CFrame.new(pos + Vector3.new(0, 2.5 * s, 0)), rgb(210, 210, 220))
	ball(pos + Vector3.new(0, 5.5 * s, 0), 2 * s, rgb(150, 220, 255), { Material = NEON, Transparency = 0.3 })
end

local function flowers(pos: Vector3)
	local colors = { rgb(255, 90, 120), rgb(255, 220, 60), rgb(150, 110, 255), rgb(255, 150, 40), WHITE }
	for _ = 1, 4 do
		local p = pos + Vector3.new(rng:NextNumber(-2.5, 2.5), 0, rng:NextNumber(-2.5, 2.5))
		P(Vector3.new(0.3, 1.4, 0.3), CFrame.new(p + Vector3.new(0, 0.7, 0)), rgb(60, 170, 60), { CanCollide = false })
		P(Vector3.new(1, 0.5, 1), CFrame.new(p + Vector3.new(0, 1.6, 0)), pick(colors), { CanCollide = false })
	end
end

local function water(x: number, width: number)
	P(Vector3.new(L, 1, width), spot(x + width / 2, L / 2, -0.4), rgb(60, 170, 230), { Material = Enum.Material.Glass, Transparency = 0.15, CanCollide = false })
	P(Vector3.new(L, 0.3, 1.2), spot(x, L / 2, 0.15), WHITE, { CanCollide = false })
end

local function cloud(pos: Vector3, size: number)
	for _ = 1, 4 do
		ball(pos + Vector3.new(rng:NextNumber(-size, size), rng:NextNumber(-size * 0.2, size * 0.3), rng:NextNumber(-size, size)), size * rng:NextNumber(0.9, 1.4), WHITE, { CanCollide = false })
	end
end

local function trophy(pos: Vector3, scale: number, color: Color3)
	local s = scale
	P(Vector3.new(4 * s, 1.5 * s, 4 * s), CFrame.new(pos + Vector3.new(0, 0.75 * s, 0)), rgb(60, 40, 30), { Material = Enum.Material.Wood })
	P(Vector3.new(1 * s, 3 * s, 1 * s), CFrame.new(pos + Vector3.new(0, 3 * s, 0)), color, { Material = FOIL })
	P(Vector3.new(3.4 * s, 3.4 * s, 3.4 * s), CFrame.new(pos + Vector3.new(0, 6 * s, 0)), color, { Material = FOIL, Shape = BALL })
	P(Vector3.new(3.8 * s, 0.6 * s, 3.8 * s), CFrame.new(pos + Vector3.new(0, 7.6 * s, 0)), color, { Material = FOIL })
	for _, x in { -2.2, 2.2 } do
		P(Vector3.new(0.6 * s, 2.4 * s, 0.6 * s), CFrame.new(pos + Vector3.new(x * s, 6.2 * s, 0)), color, { Material = FOIL })
	end
end

local function flag(pos: Vector3, colors: { Color3 })
	P(Vector3.new(0.4, 12, 0.4), CFrame.new(pos + Vector3.new(0, 6, 0)), WHITE)
	for i, c in colors do
		P(Vector3.new(0.2, 1.5, 5), CFrame.new(pos + Vector3.new(0, 12 - i * 1.5 + 0.75, 2.7)), c)
	end
end

-- Estructura en cuadrícula: llama fn(cf, anchoCelda, fondoCelda, índice)
local function grid(cols: number, rows: number, fn: (CFrame, number, number, number) -> ())
	local cellW, cellD = Scenery.LOT / cols, L / rows
	local i = 0
	for c = 1, cols do
		for r = 1, rows do
			i += 1
			local x = (c - 0.5) * cellW + rng:NextNumber(-2, 2)
			local z = (r - 0.5) * cellD + rng:NextNumber(-2, 2)
			fn(spot(x, z), cellW, cellD, i)
		end
	end
end

-- ============================================================
-- Escenarios
-- ============================================================
local Scenes = {}

function Scenes.Chozas()
	local walls = { rgb(150, 110, 75), rgb(160, 90, 60), rgb(110, 130, 150), rgb(140, 140, 130), rgb(170, 150, 110) }
	grid(3, 4, function(cf, _cw, _cd, i)
		if i % 5 == 0 then
			-- montón de llantas
			for k = 0, 2 do
				P(Vector3.new(1.2, 3, 3), cf * CFrame.new(0, 0.6 + k * 1.2, 0) * CFrame.Angles(0, 0, math.rad(90)), DARK, { Shape = CYL })
			end
			return
		end
		local w, d, h = rng:NextNumber(7, 10), rng:NextNumber(7, 9), rng:NextNumber(5.5, 7)
		P(Vector3.new(w, h, d), cf * CFrame.new(0, h / 2, 0), pick(walls), { Material = Enum.Material.WoodPlanks })
		P(Vector3.new(w + 1.5, 0.4, d + 1.5), cf * CFrame.new(0, h + 0.4, 0) * CFrame.Angles(math.rad(8), 0, 0), rgb(150, 150, 155), { Material = Enum.Material.CorrodedMetal })
		P(Vector3.new(2.6, 4.6, 0.3), cf * CFrame.new(rng:NextNumber(-1.5, 1.5), 2.3, -d / 2 - 0.15), rgb(70, 50, 35))
		if i % 3 == 0 then
			-- tendedero con ropa
			for _, x in { -5, 5 } do
				P(Vector3.new(0.3, 5, 0.3), cf * CFrame.new(x, 2.5, -d / 2 - 4), WOOD)
			end
			P(Vector3.new(10, 0.1, 0.1), cf * CFrame.new(0, 4.8, -d / 2 - 4), DARK)
			for _, x in { -3, 0, 3 } do
				P(Vector3.new(1.8, 2, 0.1), cf * CFrame.new(x, 3.8, -d / 2 - 4), pick({ rgb(230, 70, 70), rgb(70, 130, 230), rgb(250, 220, 80), WHITE }))
			end
		end
	end)
end

function Scenes.Casitas(level: number)
	local colorful = { rgb(255, 150, 180), rgb(255, 220, 90), rgb(120, 220, 230), rgb(160, 230, 120), rgb(255, 170, 90), rgb(190, 160, 255) }
	grid(3, 4, function(cf, _cw, _cd, i)
		if i % 4 == 0 then
			tree(cf.Position)
			return
		end
		local w, d, h = rng:NextNumber(10, 13), rng:NextNumber(9, 12), rng:NextNumber(7, 8.5)
		if level == 1 then
			house(cf, w, d, h, rgb(185, 100, 70), rgb(120, 60, 45), { material = Enum.Material.Brick })
		else
			house(cf, w, d, h, pick(colorful), pick({ rgb(200, 60, 50), rgb(60, 90, 180), rgb(60, 140, 80) }))
			flowers((cf * CFrame.new(-w / 2 + 1.5, 0, -d / 2 - 2.5)).Position)
		end
	end)
end

function Scenes.Canchita()
	-- canchita de fútbol con malla
	local center = spot(32, L / 2)
	P(Vector3.new(76, 0.2, 44), center * CFrame.new(0, 0.1, 0), rgb(70, 175, 70), { TopSurface = Enum.SurfaceType.Studs })
	for _, z in { -21, 21 } do
		P(Vector3.new(74, 0.25, 0.6), center * CFrame.new(0, 0.15, z), WHITE)
	end
	for _, x in { -36.7, 0, 36.7 } do
		P(Vector3.new(0.6, 0.25, 42), center * CFrame.new(x, 0.15, 0), WHITE)
	end
	goal(center * CFrame.new(-36, 0, 0) * CFrame.Angles(0, math.rad(-90), 0), 10, 5)
	goal(center * CFrame.new(36, 0, 0) * CFrame.Angles(0, math.rad(90), 0), 10, 5)
	for _, z in { -23, 23 } do
		P(Vector3.new(80, 8, 0.3), center * CFrame.new(0, 4, z), rgb(150, 160, 170), { Transparency = 0.55 })
	end
	-- casitas atrás
	for i = 0, 3 do
		house(spot(72, 12 + i * 25), 12, 10, 8, pick({ rgb(255, 200, 120), rgb(150, 210, 255), rgb(255, 160, 160), rgb(200, 240, 150) }), rgb(190, 70, 50))
	end
end

function Scenes.Colonia()
	grid(2, 3, function(cf, cw, cd, _i)
		local w, d = rng:NextNumber(16, 20), 14
		house(cf * CFrame.new(0, 0, 4), w, d, 12, pick({ rgb(245, 235, 215), rgb(230, 245, 255), rgb(255, 230, 200), rgb(220, 240, 220) }), pick({ rgb(160, 60, 50), rgb(60, 70, 90) }), { floors = 2 })
		-- jardín con seto y árbol
		P(Vector3.new(cd - 4, 1.6, 1.4), cf * CFrame.new(0, 0.8, -cw / 2 + 2), rgb(50, 150, 60))
		tree((cf * CFrame.new(w / 2 + 2, 0, -3)).Position)
		P(Vector3.new(0.8, 3, 0.8), cf * CFrame.new(-4, 1.5, -d / 2 - 1), rgb(40, 90, 200))
		bush((cf * CFrame.new(-w / 2 + 2, 0, -cw / 2 + 5)).Position)
		bush((cf * CFrame.new(w / 2 - 2, 0, -cw / 2 + 5)).Position, rgb(230, 120, 170))
	end)
end

function Scenes.Tiendas()
	local names = { "🥖 Panadería", "🌮 Tacos", "⚽ Deportes", "🍦 Helados", "💊 Farmacia", "👟 Zapatos", "🍕 Pizza", "🎮 Juegos" }
	local colors = { rgb(255, 120, 120), rgb(120, 190, 255), rgb(255, 210, 100), rgb(150, 230, 150), rgb(230, 150, 255) }
	-- banqueta
	P(Vector3.new(L, 0.6, 14), spot(7, L / 2, 0.3), rgb(200, 200, 205), { TopSurface = Enum.SurfaceType.Studs })
	for i = 0, 4 do
		local cf = spot(22, 10 + i * 20)
		local color = pick(colors)
		house(cf, 18, 14, 12, color, color:Lerp(Color3.new(0, 0, 0), 0.4), { flat = true, floors = 2 })
		-- toldo a rayas
		for k = 0, 2 do
			P(Vector3.new(6, 0.4, 4), cf * CFrame.new(-6 + k * 6, 5.6, -9) * CFrame.Angles(math.rad(-15), 0, 0), if k % 2 == 0 then rgb(230, 60, 70) else WHITE)
		end
		local sign = P(Vector3.new(14, 2.6, 0.4), cf * CFrame.new(0, 9.6, -7.3), DARK)
		text(sign, Enum.NormalId.Front, names[(i + rng:NextInteger(0, 7)) % #names + 1], rgb(255, 230, 90))
		if i % 2 == 0 then
			car(spot(4, 10 + i * 20 + 8) * CFrame.Angles(0, math.rad(90), 0), pick({ rgb(220, 50, 50), rgb(50, 120, 220), rgb(240, 240, 240) }))
		end
	end
	for i = 0, 2 do
		building(spot(62, 16 + i * 33), 22, 20, rng:NextInteger(3, 4), pick({ rgb(200, 170, 140), rgb(170, 190, 210), rgb(220, 200, 170) }), GLASS)
	end
end

function Scenes.Edificios(level: number)
	-- calle con autos
	P(Vector3.new(L, 0.15, 12), spot(6, L / 2, 0.08), rgb(55, 55, 60))
	for k = 0, 4 do
		P(Vector3.new(6, 0.2, 0.6), spot(6, 10 + k * 20, 0.2), rgb(255, 220, 60))
	end
	for k = 0, 2 do
		car(spot(rng:NextNumber(3, 9), 15 + k * 33) * CFrame.Angles(0, math.rad(90), 0), pick({ rgb(220, 50, 50), rgb(50, 120, 220), rgb(240, 240, 240), rgb(250, 200, 40), rgb(40, 40, 45) }))
	end
	for k = 0, 3 do
		lamp((spot(13, 12 + k * 25)).Position, if level == 3 then GOLD else nil)
	end
	local palettes = {
		{ rgb(200, 170, 140), rgb(170, 190, 210), rgb(220, 200, 170), rgb(180, 150, 150) },
		{ rgb(150, 160, 175), rgb(120, 140, 170), rgb(200, 195, 185), rgb(90, 110, 140) },
		{ GOLD, rgb(255, 220, 120), rgb(240, 180, 40) },
	}
	local floorRange = ({ { 3, 5 }, { 6, 10 }, { 5, 12 } })[level]
	local cols, rows = 2, 3
	local cellW, cellD = (Scenery.LOT - 18) / cols, L / rows
	for c = 1, cols do
		for r = 1, rows do
			local cf = spot(18 + (c - 0.5) * cellW, (r - 0.5) * cellD)
			local floors = rng:NextInteger(floorRange[1], floorRange[2])
			if level == 3 then
				building(cf, cellD - 8, cellW - 8, floors, pick(palettes[3]), rgb(255, 250, 200), { material = FOIL, windowMaterial = NEON, antenna = true })
			else
				building(cf, cellD - 8, cellW - 8, floors, pick(palettes[level]), GLASS, { antenna = floors > 7 })
			end
		end
	end
end

function Scenes.Parque()
	-- caminito
	P(Vector3.new(L, 0.2, 6), spot(20, L / 2, 0.1), rgb(230, 210, 170))
	P(Vector3.new(6, 0.2, 50), spot(45, L / 2, 0.1), rgb(230, 210, 170))
	fountain((spot(45, L / 2)).Position)
	for _ = 1, 9 do
		tree((spot(rng:NextNumber(30, 88), rng:NextNumber(5, 95))).Position, if rng:NextNumber() < 0.3 then "Pino" else nil)
	end
	for k = 0, 3 do
		bench(spot(15, 12 + k * 25))
	end
	for _ = 1, 5 do
		flowers((spot(rng:NextNumber(5, 85), rng:NextNumber(5, 95))).Position)
	end
	disc((spot(70, 20, 0.1)).Position, 0.2, 18, rgb(80, 170, 230), { Material = Enum.Material.Glass, Transparency = 0.2 })
	for k = 0, 2 do
		lamp((spot(24, 20 + k * 30)).Position)
	end
end

function Scenes.Rascacielos()
	local glassColors = { rgb(120, 180, 230), rgb(90, 140, 200), rgb(150, 200, 220), rgb(80, 110, 160) }
	for c = 0, 1 do
		for r = 0, 1 do
			local cf = spot(24 + c * 40, 25 + r * 50)
			local h = rng:NextInteger(70, 110)
			local color = pick(glassColors)
			P(Vector3.new(24, h, 24), cf * CFrame.new(0, h / 2, 0), color, { Material = Enum.Material.Glass, Reflectance = 0.15 })
			for k = 1, 5 do
				P(Vector3.new(24.6, 1, 24.6), cf * CFrame.new(0, h * k / 6, 0), WHITE)
			end
			P(Vector3.new(16, 8, 16), cf * CFrame.new(0, h + 4, 0), color:Lerp(WHITE, 0.3), { Material = Enum.Material.Glass })
			P(Vector3.new(0.8, 14, 0.8), cf * CFrame.new(0, h + 15, 0), rgb(200, 200, 210))
			ball((cf * CFrame.new(0, h + 22.5, 0)).Position, 1.4, rgb(255, 60, 60), { Material = NEON })
		end
	end
	P(Vector3.new(L, 0.15, 12), spot(6, L / 2, 0.08), rgb(55, 55, 60))
end

function Scenes.Playa()
	water(52, 40)
	for _ = 1, 5 do
		tree((spot(rng:NextNumber(4, 45), rng:NextNumber(5, 95))).Position, "Palmera")
	end
	local colors = { rgb(255, 80, 80), rgb(255, 210, 60), rgb(80, 170, 255), rgb(255, 120, 200), rgb(100, 220, 120) }
	for k = 0, 5 do
		local pos = (spot(rng:NextNumber(10, 44), 8 + k * 16)).Position
		umbrella(pos, pick(colors))
		P(Vector3.new(2.6, 0.15, 5), CFrame.new(pos + Vector3.new(2.5, 0.1, 0)), pick(colors))
	end
	for _ = 1, 3 do
		ball((spot(rng:NextNumber(10, 45), rng:NextNumber(5, 95))).Position + Vector3.new(0, 1, 0), 2, pick(colors))
	end
	-- torre de salvavidas
	local tower = spot(40, 50)
	for _, x in { -2, 2 } do
		for _, z in { -2, 2 } do
			P(Vector3.new(0.6, 8, 0.6), tower * CFrame.new(x, 4, z), WHITE)
		end
	end
	P(Vector3.new(6, 0.6, 6), tower * CFrame.new(0, 8, 0), rgb(230, 60, 60))
	Wedge(Vector3.new(6.5, 2.5, 3.5), tower * CFrame.new(0, 11, -1.6), rgb(230, 60, 60))
	Wedge(Vector3.new(6.5, 2.5, 3.5), tower * CFrame.new(0, 11, 1.6) * CFrame.Angles(0, math.pi, 0), rgb(230, 60, 60))
	for _, x in { -2.8, 2.8 } do
		P(Vector3.new(0.4, 3, 0.4), tower * CFrame.new(x, 9.5, 0), WHITE)
	end
end

function Scenes.Malecon()
	water(30, 62)
	P(Vector3.new(L, 1, 26), spot(13, L / 2, 0.5), rgb(185, 135, 85), { Material = Enum.Material.WoodPlanks, TopSurface = Enum.SurfaceType.Studs })
	P(Vector3.new(L, 3.5, 0.6), spot(26, L / 2, 2.5), WHITE)
	for k = 0, 3 do
		lamp((spot(24, 12 + k * 25)).Position + Vector3.new(0, 1, 0))
		tree((spot(5, 25 + k * 25)).Position + Vector3.new(0, 1, 0), "Palmera")
		bench(spot(18, 18 + k * 25, 1) * CFrame.Angles(0, math.pi, 0))
	end
	if side == 1 then
		-- faro
		local base = spot(70, 50)
		P(Vector3.new(14, 4, 14), base * CFrame.new(0, 2, 0), rgb(150, 150, 150), { Material = Enum.Material.Slate })
		for k = 0, 5 do
			column(base * CFrame.new(0, 4 + k * 6, 0), 6, 8 - k * 0.5, if k % 2 == 0 then WHITE else rgb(220, 50, 50))
		end
		ball((base * CFrame.new(0, 42, 0)).Position, 5, rgb(255, 240, 150), { Material = NEON })
	else
		for k = 0, 2 do
			local boat = spot(rng:NextNumber(45, 80), 20 + k * 30, 0.3)
			P(Vector3.new(4, 2, 10), boat * CFrame.new(0, 1, 0), pick({ rgb(230, 70, 70), rgb(70, 130, 230), WHITE }))
		end
	end
end

local function boat(cf: CFrame, color: Color3, sail: boolean)
	P(Vector3.new(6, 3, 14), cf * CFrame.new(0, 1.5, 0), WHITE)
	Wedge(Vector3.new(6, 3, 5), cf * CFrame.new(0, 1.5, -9.5) * CFrame.Angles(0, math.pi, 0), WHITE)
	P(Vector3.new(6.1, 0.8, 14), cf * CFrame.new(0, 1, 0), color)
	P(Vector3.new(4, 2.4, 6), cf * CFrame.new(0, 4.2, 2), rgb(220, 235, 245))
	if sail then
		P(Vector3.new(0.5, 18, 0.5), cf * CFrame.new(0, 11, -1), rgb(200, 200, 200))
		Wedge(Vector3.new(0.2, 15, 8), cf * CFrame.new(0, 11, 3) * CFrame.Angles(0, math.pi, 0), WHITE)
	end
end

function Scenes.Puerto()
	water(14, 78)
	for k = 0, 2 do
		local z = 15 + k * 35
		P(Vector3.new(5, 1, 60), spot(44, z, 0.5), rgb(170, 120, 75), { Material = Enum.Material.WoodPlanks })
		boat(spot(rng:NextNumber(30, 70), z + 10, -0.2) * CFrame.Angles(0, math.rad(90), 0), pick({ rgb(40, 90, 200), rgb(220, 60, 60), rgb(30, 160, 140) }), k % 2 == 0)
	end
	for k = 0, 3 do
		lamp((spot(8, 12 + k * 25)).Position)
	end
end

function Scenes.Hoteles()
	for k = 0, 2 do
		local cf = spot(48, 17 + k * 33)
		local floors = rng:NextInteger(8, 13)
		building(cf, 22, 16, floors, rgb(245, 245, 240), rgb(90, 170, 230))
		for f = 1, floors - 1 do
			P(Vector3.new(22, 0.4, 2), cf * CFrame.new(0, f * 5, -9), WHITE)
		end
		local sign = P(Vector3.new(16, 3, 0.4), cf * CFrame.new(0, floors * 5 + 2.5, -7), rgb(30, 30, 40))
		text(sign, Enum.NormalId.Front, pick({ "HOTEL SOL", "GRAN HOTEL", "HOTEL MAR", "PARAÍSO" }), rgb(255, 220, 90))
		-- alberca
		P(Vector3.new(14, 0.3, 9), spot(18, 17 + k * 33, 0.15), rgb(80, 210, 255), { Material = NEON, Transparency = 0.2 })
		P(Vector3.new(16, 0.25, 11), spot(18, 17 + k * 33, 0.1), WHITE)
		tree((spot(30, 5 + k * 33)).Position, "Palmera")
	end
end

function Scenes.Resort()
	for k = 0, 2 do
		local z = 17 + k * 33
		house(spot(58, z), 18, 14, 7, WHITE, rgb(240, 240, 235), { flat = true, window = rgb(120, 200, 240) })
		P(Vector3.new(16, 0.3, 10), spot(30, z, 0.15), rgb(70, 220, 255), { Material = NEON, Transparency = 0.15 })
		P(Vector3.new(18, 0.25, 12), spot(30, z, 0.1), rgb(240, 230, 210))
		for _, dz in { -4, 0, 4 } do
			P(Vector3.new(2.4, 0.6, 5.5), spot(18, z + dz, 0.5), WHITE)
		end
		tree((spot(42, z - 12)).Position, "Palmera")
		tree((spot(80, z + 10)).Position, "Palmera")
	end
	-- bar de playa con techo de paja
	local bar = spot(12, 90)
	P(Vector3.new(8, 3.5, 3), bar * CFrame.new(0, 1.75, 0), WOOD, { Material = Enum.Material.Wood })
	for _, x in { -3.5, 3.5 } do
		P(Vector3.new(0.6, 8, 0.6), bar * CFrame.new(x, 4, 2), WOOD)
	end
	Wedge(Vector3.new(10, 3, 4), bar * CFrame.new(0, 9, -1), rgb(210, 180, 100), { Material = Enum.Material.Grass })
	Wedge(Vector3.new(10, 3, 4), bar * CFrame.new(0, 9, 3) * CFrame.Angles(0, math.pi, 0), rgb(210, 180, 100), { Material = Enum.Material.Grass })
end

function Scenes.Escuela()
	local center = spot(30, L / 2)
	P(Vector3.new(70, 0.2, 40), center * CFrame.new(0, 0.1, 0), rgb(70, 190, 70), { TopSurface = Enum.SurfaceType.Studs })
	goal(center * CFrame.new(-33, 0, 0) * CFrame.Angles(0, math.rad(-90), 0), 8, 4)
	goal(center * CFrame.new(33, 0, 0) * CFrame.Angles(0, math.rad(90), 0), 8, 4)
	-- conos
	for k = 0, 6 do
		local cone = center * CFrame.new(-24 + k * 8, 0, -12 + (k % 2) * 3)
		P(Vector3.new(1.6, 0.3, 1.6), cone * CFrame.new(0, 0.15, 0), rgb(255, 130, 30))
		P(Vector3.new(0.8, 1.6, 0.8), cone * CFrame.new(0, 1, 0), rgb(255, 130, 30))
	end
	-- escalera de agilidad
	for k = 0, 7 do
		P(Vector3.new(0.4, 0.2, 4), center * CFrame.new(-14 + k * 2.5, 0.25, 12), rgb(255, 230, 50))
	end
	-- muñecos de entrenamiento
	for k = 0, 2 do
		column(center * CFrame.new(10 + k * 5, 0, 5), 6, 1.8, rgb(40, 100, 220))
	end
	local club = spot(76, 50)
	house(club, 26, 16, 9, WHITE, rgb(40, 100, 220), { flat = true })
	local sign = P(Vector3.new(18, 3, 0.4), club * CFrame.new(0, 11.5, -6), rgb(40, 100, 220))
	text(sign, Enum.NormalId.Front, "⚽ ESCUELA DE FÚTBOL", WHITE)
end

function Scenes.Gradas(level: number)
	local rows = ({ 3, 6, 10, 14 })[level]
	local seatSets = {
		{ rgb(170, 170, 175) },
		{ rgb(220, 60, 60), rgb(240, 240, 240) },
		{ rgb(40, 90, 210), rgb(250, 210, 50), rgb(240, 240, 240) },
		{ rgb(220, 40, 60), rgb(250, 200, 40), rgb(40, 160, 90), rgb(40, 90, 210) },
	}
	local seats = seatSets[level]
	local start = 6
	for r = 1, rows do
		local h = r * 1.6
		local x = start + (r - 0.5) * 3
		P(Vector3.new(L, h, 3), spot(x, L / 2, h / 2), rgb(150, 150, 158))
		P(Vector3.new(L - 0.5, 0.5, 2.6), spot(x - 0.2, L / 2, h + 0.25), seats[(r - 1) % #seats + 1])
		-- aficionados
		if level >= 2 and r % 2 == 0 then
			for _ = 1, level * 2 do
				P(Vector3.new(1.2, 2, 1.2), spot(x, rng:NextNumber(3, L - 3), h + 1.5), pick({ rgb(230, 60, 60), rgb(250, 220, 60), rgb(60, 130, 240), WHITE, rgb(60, 200, 90) }))
			end
		end
	end
	local top = rows * 1.6
	local back = start + rows * 3
	-- malla al frente
	P(Vector3.new(L, 4, 0.3), spot(start - 1, L / 2, 2), rgb(150, 160, 170), { Transparency = 0.5 })
	if level >= 2 then
		-- torres de luz
		for _, z in (if level >= 3 then { 8, 50, 92 } else { 10, 90 }) do
			local base = spot(back + 3, z)
			P(Vector3.new(1.2, top + 22, 1.2), base * CFrame.new(0, (top + 22) / 2, 0), rgb(200, 200, 210))
			P(Vector3.new(6, 4, 1), base * CFrame.new(0, top + 23, -0.5), WHITE, { Material = NEON })
		end
	end
	if level <= 2 then
		-- estacionamiento y taquilla detrás de las gradas
		P(Vector3.new(L - 10, 0.15, 30), spot(back + 22, L / 2, 0.08), rgb(60, 60, 66))
		for k = 0, 7 do
			P(Vector3.new(0.4, 0.2, 10), spot(back + 14, 8 + k * 12, 0.2), WHITE)
			if rng:NextNumber() < 0.7 then
				car(spot(back + 14, 14 + k * 12), pick({ rgb(220, 50, 50), rgb(50, 120, 220), rgb(240, 240, 240), rgb(250, 200, 40), rgb(60, 160, 90) }))
			end
		end
		local booth = spot(back + 30, 50)
		house(booth, 12, 8, 7, rgb(240, 240, 240), rgb(220, 60, 60), { flat = true })
		local sign = P(Vector3.new(10, 2.4, 0.4), booth * CFrame.new(0, 8.6, -3.8), rgb(220, 60, 60))
		text(sign, Enum.NormalId.Front, "🎟️ TAQUILLA", WHITE)
		-- marcador
		local board = spot(back + 4, 50, 14)
		P(Vector3.new(1, 14, 1), spot(back + 4, 44, 7), DARK)
		P(Vector3.new(1, 14, 1), spot(back + 4, 56, 7), DARK)
		local screen = P(Vector3.new(16, 7, 1), board, rgb(20, 20, 25))
		text(screen, Enum.NormalId.Front, "LOCAL 2 - 1 VISITA", rgb(255, 210, 60))
	end
	if level >= 3 then
		-- techo
		P(Vector3.new(L, 1, rows * 3 + 4), spot(start + rows * 1.5, L / 2, top + 9), rgb(230, 230, 235))
		for _, z in { 5, 50, 95 } do
			P(Vector3.new(1, top + 9, 1), spot(back, z, (top + 9) / 2), rgb(200, 200, 210))
		end
	end
	if level >= 4 then
		-- pantalla gigante
		local screenPos = spot(back - 8, L / 2, top + 22)
		local screen = P(Vector3.new(36, 14, 1.5), screenPos, rgb(20, 20, 25))
		P(Vector3.new(38, 16, 1), screenPos * CFrame.new(0, 0, 0.6), rgb(250, 200, 40), { Material = NEON })
		text(screen, Enum.NormalId.Front, "¡GOOOL! ⚽", rgb(255, 255, 255), 10)
		for k = 0, 3 do
			flag((spot(back + 1, 12 + k * 25)).Position + Vector3.new(0, top, 0), { rgb(230, 50, 60), WHITE, rgb(40, 90, 210) })
		end
	end
end

function Scenes.Mansiones()
	for k = 0, 1 do
		local cf = spot(50, 25 + k * 50)
		house(cf, 34, 22, 15, rgb(250, 248, 240), rgb(50, 60, 90), { floors = 2, roofHeight = 7 })
		for _, x in { -12, -4, 4, 12 } do
			column(cf * CFrame.new(x, 0, -13), 15, 1.6, WHITE)
		end
		P(Vector3.new(34, 1, 4), cf * CFrame.new(0, 15.5, -13), WHITE)
		fountain((cf * CFrame.new(0, 0, -24)).Position, 0.8)
